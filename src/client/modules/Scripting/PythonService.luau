--!strict
-- Arkher Studio - Fase 1.5 - PythonService - Suporte Python 3.14 no Roblox
-- Transpila Python -> Luau + executa via backend

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PythonTranspiler = require(ReplicatedStorage.Arkher.Scripting.PythonTranspiler)
local LanguageSupport = require(ReplicatedStorage.Arkher.Scripting.LanguageSupport)

local PythonService = {}
PythonService.__index = PythonService

function PythonService.new(backendUrl: string?)
	return setmetatable({
		backendUrl = backendUrl or "http://localhost:3000",
		transpiler = PythonTranspiler.new(),
		executionCache = {},
	}, PythonService)
end

function PythonService:SetBackendUrl(url: string)
	self.backendUrl = url
end

function PythonService:TranspileLocal(pythonCode: string): (string?, string?)
	return self.transpiler:Transpile(pythonCode)
end

function PythonService:TranspileViaBackend(pythonCode: string, styleProfile: string?): (string?, string?)
	print("[Arkher PythonService] Transpiling via backend -", #pythonCode, "bytes")

	-- Fase 1.5 mock, Fase 2 real com HttpService

	--[[
	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = self.backendUrl .. "/api/python/transpile",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				pythonCode = pythonCode,
				styleProfile = styleProfile,
			})
		})
	end)

	if success and response.Success then
		local data = HttpService:JSONDecode(response.Body)
		return data.luauCode, nil
	else
		return nil, "Backend transpile failed"
	end
	]]

	-- Mock: usa transpiler local
	return self:TranspileLocal(pythonCode)
end

function PythonService:Execute(pythonCode: string): (string?, string?)
	-- Valida
	local valid, err = self.transpiler:ValidatePython(pythonCode)
	if not valid then
		return nil, err
	end

	-- Tenta transpilar e executar como Luau
	local luauCode, transpileErr = self:TranspileLocal(pythonCode)
	if not luauCode then
		return nil, "Transpile failed: " .. (transpileErr or "unknown")
	end

	-- Executa Luau transpilado em sandbox
	local func, loadErr = loadstring(luauCode)
	if not func then
		return nil, "Luau load failed: " .. tostring(loadErr)
	end

	-- Sandbox simples
	local sandbox = {
		print = function(...)
			print("[Python->Luau]", ...)
		end,
		math = math,
		string = string,
		table = table,
		Vector3 = Vector3,
		Color3 = Color3,
		CFrame = CFrame,
	}

	setfenv(func, setmetatable(sandbox, { __index = _G }))

	local success, result = pcall(func)
	if not success then
		return nil, "Execution failed: " .. tostring(result)
	end

	print("[Arkher PythonService] Executed Python via Luau transpile")

	return "Executed successfully via Luau transpile", nil
end

function PythonService:ExecuteViaBackend(pythonCode: string): (string?, string?)
	print("[Arkher PythonService] Executing via backend Python 3.14 -", #pythonCode, "bytes")

	-- Fase 2: Roda Python real no backend

	--[[
	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = self.backendUrl .. "/api/python/execute",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				pythonCode = pythonCode,
				timeout = 5000,
			})
		})
	end)

	if success and response.Success then
		local data = HttpService:JSONDecode(response.Body)
		return data.output, data.errors ~= "" and data.errors or nil
	else
		return nil, "Backend execution failed"
	end
	]]

	-- Mock
	return self:Execute(pythonCode)
end

function PythonService:GenerateFromPrompt(prompt: string, styleProfile: string?): string?
	print("[Arkher PythonService] AI Generate Python - Prompt:", prompt)

	-- Em produção chama backend /api/python/generate com IA

	local template = string.format([[
# Generated by Arkher AI - Python 3.14
# Prompt: %s
# Style: %s

from arkher import Entity, Component, World
from arkher import Vector3, Color3

def main():
    """%s"""
    print(f"Executando: %s")
    
    world = World.current()
    
    # AI will generate code based on prompt here
    # Example for coin system:
    coin = Entity.new("GoldCoin")
    coin.add_component(Component.Transform(
        position=Vector3(0, 5, 0)
    ))
    coin.add_component(Component.Render(
        material="Neon",
        color=Color3.from_rgb(255, 215, 0)
    ))
    world.add_entity(coin)
    print(f"Criado {coin.name}!")

if __name__ == "__main__":
    main()
]], prompt, styleProfile or "realistic", prompt, prompt)

	return template
end

function PythonService:GetExample(): string
	local lang = LanguageSupport.GetLanguage("python")
	return lang and lang.example or "# Python example"
end

return PythonService
