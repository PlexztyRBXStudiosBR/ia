      <string name="Name">MobileUI</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 1 - MobileUI - Adaptações para A01 até Flagship
-- Bottom sheet, radial menu, touch gestures

local UserInputService = game:GetService("UserInputService")

local Shell = require(script.Parent.Shell)

local MobileUI = {}
MobileUI.__index = MobileUI

function MobileUI.new(mainController: any)
	local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

	return setmetatable({
		mainController = mainController,
		isMobile = isMobile,
		bottomSheet = nil :: Frame?,
		radialMenu = nil :: Frame?,
		toolbar = nil :: Frame?,
	}, MobileUI)
end

function MobileUI:Init(parent: ScreenGui)
	if not self.isMobile then
		print("[Arkher MobileUI] Not mobile - skipping mobile UI")
		return
	end

	print("[Arkher MobileUI] Initializing for mobile - A01 optimized")

	self:CreateMobileToolbar(parent)
	self:CreateBottomSheet(parent)
	self:CreateRadialMenu(parent)
	self:AdaptExistingUI()

	print("[Arkher MobileUI] Mobile UI ready - Touch gestures enabled")
end

function MobileUI:CreateMobileToolbar(parent: ScreenGui)
	-- Toolbar inferior para mobile com botões grandes (fácil no A01)
	local toolbar = Instance.new("Frame")
	toolbar.Name = "MobileToolbar"
	toolbar.Size = UDim2.new(1, 0, 0, 70)
	toolbar.Position = UDim2.new(0, 0, 1, -70)
	toolbar.BackgroundColor3 = Shell.Colors.panel
	toolbar.BorderSizePixel = 0
	toolbar.ZIndex = 20
	toolbar.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = toolbar

	local stroke = Instance.new("UIStroke")
	stroke.Color = Shell.Colors.border
	stroke.Thickness = 1
	stroke.Parent = toolbar

	-- Botões principais: Select, Move, Place, Delete, Play
	local buttons = {
		{ icon = "", name = "Select", mode = "Select" },
		{ icon = "Move", name = "Move", mode = "Move" },
		{ icon = "", name = "Place", mode = "Place" },
		{ icon = "Delete", name = "Delete", mode = "Delete" },
		{ icon = "Play️", name = "Play", mode = "Play" },
	}

	for i, btnData in buttons do
		local btn = Instance.new("TextButton")
		btn.Name = btnData.name .. "Btn"
		btn.Size = UDim2.new(0, 60, 0, 50)
		btn.Position = UDim2.new(0, 10 + (i-1)*65, 0, 10)
		btn.BackgroundColor3 = btnData.mode == "Place" and Shell.Colors.accent or Shell.Colors.panelLight
		btn.Text = btnData.icon .. "\n" .. btnData.name
		btn.TextColor3 = Shell.Colors.text
		btn.TextSize = 10
		btn.Font = Enum.Font.GothamBold
		btn.Parent = toolbar

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 8)
		btnCorner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			self:HandleToolbarClick(btnData.mode, btn)

			-- Atualiza seleção visual
			for _, otherBtn in toolbar:GetChildren() do
				if otherBtn:IsA("TextButton") then
					otherBtn.BackgroundColor3 = Shell.Colors.panelLight
				end
			end
			btn.BackgroundColor3 = Shell.Colors.accent
		end)
	end

	self.toolbar = toolbar
end

function MobileUI:HandleToolbarClick(mode: string, btn: TextButton)
	print("[Arkher MobileUI] Toolbar click:", mode)

	if mode == "Play" then
		self.mainController:TogglePlay()
	elseif mode == "Select" or mode == "Move" or mode == "Place" then
		if self.mainController.buildingService then
			self.mainController.buildingService:SetMode(mode)
		end
	elseif mode == "Delete" then
		if self.mainController.buildingService and self.mainController.buildingService.selectedEntityId then
			self.mainController.buildingService:DeleteEntity(self.mainController.buildingService.selectedEntityId)
		end
	end
end

function MobileUI:CreateBottomSheet(parent: ScreenGui)
	-- Bottom sheet que sobe quando seleciona entidade (igual Google Maps)
	local sheet = Instance.new("Frame")
	sheet.Name = "MobileBottomSheet"
	sheet.Size = UDim2.new(1, 0, 0, 250)
	sheet.Position = UDim2.new(0, 0, 1, 0) -- escondido inicialmente
	sheet.BackgroundColor3 = Shell.Colors.panel
	sheet.BorderSizePixel = 0
	sheet.ZIndex = 15
	sheet.Visible = false
	sheet.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = sheet

	-- Handle para arrastar
	local handle = Instance.new("Frame")
	handle.Name = "Handle"
	handle.Size = UDim2.new(0, 40, 0, 4)
	handle.Position = UDim2.new(0.5, -20, 0, 8)
	handle.BackgroundColor3 = Shell.Colors.textDim
	handle.BorderSizePixel = 0
	handle.Parent = sheet

	local handleCorner = Instance.new("UICorner")
	handleCorner.CornerRadius = UDim.new(0, 2)
	handleCorner.Parent = handle

	-- Título
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.Size = UDim2.new(1, -20, 0, 30)
	title.Position = UDim2.new(0, 10, 0, 20)
	title.BackgroundTransparency = 1
	title.Text = "Propriedades"
	title.TextColor3 = Shell.Colors.text
	title.TextSize = 14
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = sheet

	-- Conteúdo scrollável
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Content"
	scroll.Size = UDim2.new(1, -20, 1, -60)
	scroll.Position = UDim2.new(0, 10, 0, 50)
	scroll.BackgroundTransparency = 1
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = sheet

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 10)
	layout.Parent = scroll

	self.bottomSheet = sheet

	-- Escuta seleção para mostrar/esconder
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local selectionChanged = ReplicatedStorage:FindFirstChild("ArkherSelectionChanged")
	if selectionChanged then
		selectionChanged.Event:Connect(function(entityId)
			if entityId then
				self:ShowBottomSheet(entityId)
			else
				self:HideBottomSheet()
			end
		end)
	end
end

function MobileUI:ShowBottomSheet(entityId: string)
	if not self.bottomSheet or not self.isMobile then return end

	self.bottomSheet.Visible = true
	-- Animação sobe
	self.bottomSheet:TweenPosition(UDim2.new(0, 0, 1, -250), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.3, true)

	print("[Arkher MobileUI] Show bottom sheet for", entityId)
end

function MobileUI:HideBottomSheet()
	if not self.bottomSheet then return end

	self.bottomSheet:TweenPosition(UDim2.new(0, 0, 1, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true, function()
		self.bottomSheet.Visible = false
	end)

	print("[Arkher MobileUI] Hide bottom sheet")
end

function MobileUI:CreateRadialMenu(parent: ScreenGui)
	-- Radial menu que aparece com long press (igual Fortnite building)
	local radial = Instance.new("Frame")
	radial.Name = "RadialMenu"
	radial.Size = UDim2.new(0, 200, 0, 200)
	radial.Position = UDim2.new(0.5, -100, 0.5, -100)
	radial.BackgroundTransparency = 1
	radial.ZIndex = 25
	radial.Visible = false
	radial.Parent = parent

	-- Centro
	local center = Instance.new("TextButton")
	center.Name = "Center"
	center.Size = UDim2.new(0, 60, 0, 60)
	center.Position = UDim2.new(0.5, -30, 0.5, -30)
	center.BackgroundColor3 = Shell.Colors.panel
	center.Text = "Error"
	center.TextSize = 20
	center.Parent = radial

	local centerCorner = Instance.new("UICorner")
	centerCorner.CornerRadius = UDim.new(0, 30)
	centerCorner.Parent = center

	-- Opções ao redor (8 direções)
	local options = {
		{ icon = "", name = "Place", angle = 0 },
		{ icon = "Style", name = "Paint", angle = 45 },
		{ icon = "Details", name = "Duplicate", angle = 90 },
		{ icon = "Delete", name = "Delete", angle = 135 },
		{ icon = "Extrude", name = "Move Up", angle = 180 },
		{ icon = "Rotate", name = "Rotate", angle = 225 },
		{ icon = "", name = "Material", angle = 270 },
		{ icon = "Save", name = "Save", angle = 315 },
	}

	for _, opt in options do
		local rad = math.rad(opt.angle)
		local x = math.cos(rad) * 70
		local y = math.sin(rad) * 70

		local btn = Instance.new("TextButton")
		btn.Name = opt.name
		btn.Size = UDim2.new(0, 50, 0, 50)
		btn.Position = UDim2.new(0.5, x - 25, 0.5, y - 25)
		btn.BackgroundColor3 = Shell.Colors.panelLight
		btn.Text = opt.icon
		btn.TextSize = 18
		btn.Parent = radial

		local btnCorner = Instance.new("UICorner")
		btnCorner.CornerRadius = UDim.new(0, 25)
		btnCorner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			self:HandleRadialClick(opt.name)
			self:HideRadialMenu()
		end)
	end

	self.radialMenu = radial

	center.MouseButton1Click:Connect(function()
		self:HideRadialMenu()
	end)
end

function MobileUI:HandleRadialClick(action: string)
	print("[Arkher MobileUI] Radial action:", action)

	if action == "Duplicate" and self.mainController.buildingService.selectedEntityId then
		self.mainController.buildingService:DuplicateEntity(self.mainController.buildingService.selectedEntityId)
	elseif action == "Delete" and self.mainController.buildingService.selectedEntityId then
		self.mainController.buildingService:DeleteEntity(self.mainController.buildingService.selectedEntityId)
	elseif action == "Save" then
		self.mainController:SaveProject()
	end
end

function MobileUI:ShowRadialMenu(atPosition: Vector2?)
	if not self.radialMenu or not self.isMobile then return end

	if atPosition then
		self.radialMenu.Position = UDim2.new(0, atPosition.X - 100, 0, atPosition.Y - 100)
	end

	self.radialMenu.Visible = true
	print("[Arkher MobileUI] Show radial menu")
end

function MobileUI:HideRadialMenu()
	if not self.radialMenu then return end
	self.radialMenu.Visible = false
	print("[Arkher MobileUI] Hide radial menu")
end

function MobileUI:AdaptExistingUI()
	-- Esconde ou adapta UI de PC para mobile
	if not self.isMobile then return end

	-- No mobile, Outliner e Details viram bottom sheet, não painel lateral
	-- Vamos esconder os painéis laterais originais se existirem

	print("[Arkher MobileUI] Adapted PC UI for mobile - Panels hidden, using bottom sheet")
end

return MobileUI
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXfeb218817e7d985d">
    <Properties>
      <string name="Name">NotificationSystem</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - NotificationSystem - Polimento Total 100% - Notificacoes nivel Figma + Notion + VS Code
-- Inspirado no melhor: Figma notifications, Notion, VS Code, Unreal, Blender - mas nosso amigavel Beginner to Pro

local NotificationSystem = {}
NotificationSystem.__index = NotificationSystem

export type NotificationType = "Info" | "Success" | "Warning" | "Error" | "AI"

function NotificationSystem.new(themeSystem: any)
	return setmetatable({
		themeSystem = themeSystem,
		notifications = {} :: { { id: string, type: NotificationType, title: string, message: string, duration: number, timestamp: number, frame: Frame? } },
		frame = nil :: Frame?,
		container = nil :: ScrollingFrame?,
		nextId = 1,
	}, NotificationSystem)
end

function NotificationSystem:Init(parent: ScreenGui)
	local colors = self.themeSystem:GetColors()

	local container = Instance.new("Frame")
	container.Name = "NotificationContainer"
	container.Size = UDim2.new(0, 360, 1, -100)
	container.Position = UDim2.new(1, -370, 0, 50)
	container.BackgroundTransparency = 1
	container.ZIndex = 100
	container.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = container

	self.frame = container
	self.container = container :: any

	print("[Arkher Notification] Initialized - Figma + Notion + VS Code level - Beginner friendly")

	return container
end

function NotificationSystem:Notify(type: NotificationType, title: string, message: string, duration: number?)
	duration = duration or (type == "Error" and 8 or type == "Success" and 4 or 5)

	local id = "notif_" .. self.nextId
	self.nextId += 1

	local colors = self.themeSystem:GetColors()

	local bgColor = type == "Success" and colors.success or type == "Warning" and colors.warning or type == "Error" and colors.error or type == "AI" and Color3.fromRGB(120, 80, 255) or colors.panelLight
	local icon = type == "Success" and "Success" or type == "Warning" and "Warning" or type == "Error" and "Error" or type == "AI" and "AI" or "Tip"

	local notifFrame = Instance.new("Frame")
	notifFrame.Name = id
	notifFrame.Size = UDim2.new(1, -10, 0, 80)
	notifFrame.BackgroundColor3 = colors.panel
	notifFrame.BorderSizePixel = 0
	notifFrame.LayoutOrder = -self.nextId
	notifFrame.ZIndex = 101
	notifFrame.Parent = self.frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = notifFrame

	local stroke = Instance.new("UIStroke")
	stroke.Color = bgColor
	stroke.Thickness = 2
	stroke.Parent = notifFrame

	-- Color bar left
	local colorBar = Instance.new("Frame")
	colorBar.Size = UDim2.new(0, 4, 1, 0)
	colorBar.BackgroundColor3 = bgColor
	colorBar.BorderSizePixel = 0
	colorBar.Parent = notifFrame

	-- Icon
	local iconLabel = Instance.new("TextLabel")
	iconLabel.Size = UDim2.new(0, 40, 0, 30)
	iconLabel.Position = UDim2.new(0, 10, 0, 5)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Text = icon
	iconLabel.TextSize = 20
	iconLabel.Parent = notifFrame

	-- Title
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -60, 0, 20)
	titleLabel.Position = UDim2.new(0, 50, 0, 5)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = colors.text
	titleLabel.TextSize = 12
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.TextTruncate = Enum.TextTruncate.AtRight
	titleLabel.Parent = notifFrame

	-- Message
	local msgLabel = Instance.new("TextLabel")
	msgLabel.Size = UDim2.new(1, -60, 0, 40)
	msgLabel.Position = UDim2.new(0, 50, 0, 25)
	msgLabel.BackgroundTransparency = 1
	msgLabel.Text = message
	msgLabel.TextColor3 = colors.textDim
	msgLabel.TextSize = 11
	msgLabel.Font = Enum.Font.Gotham
	msgLabel.TextXAlignment = Enum.TextXAlignment.Left
	msgLabel.TextWrapped = true
	msgLabel.Parent = notifFrame

	-- Close button
	local closeBtn = Instance.new("TextButton")
	closeBtn.Size = UDim2.new(0, 20, 0, 20)
	closeBtn.Position = UDim2.new(1, -25, 0, 5)
	closeBtn.BackgroundTransparency = 1
	closeBtn.Text = "✕"
	closeBtn.TextColor3 = colors.textDim
	closeBtn.TextSize = 12
	closeBtn.Parent = notifFrame

	closeBtn.MouseButton1Click:Connect(function()
		self:Dismiss(id)
	end)

	-- Progress bar
	local progressBg = Instance.new("Frame")
	progressBg.Name = "ProgressBg"
	progressBg.Size = UDim2.new(1, -10, 0, 3)
	progressBg.Position = UDim2.new(0, 5, 1, -6)
	progressBg.BackgroundColor3 = colors.background
	progressBg.BorderSizePixel = 0
	progressBg.Parent = notifFrame

	local progressCorner = Instance.new("UICorner")
	progressCorner.CornerRadius = UDim.new(0, 2)
	progressCorner.Parent = progressBg

	local progress = Instance.new("Frame")
	progress.Name = "Progress"
	progress.Size = UDim2.new(1, 0, 1, 0)
	progress.BackgroundColor3 = bgColor
	progress.BorderSizePixel = 0
	progress.Parent = progressBg

	local progressCorner2 = Instance.new("UICorner")
	progressCorner2.CornerRadius = UDim.new(0, 2)
	progressCorner2.Parent = progress

	-- Animate progress
	task.spawn(function()
		for i = 0, 100 do
			task.wait(duration / 100)
			if progress.Parent then
				progress.Size = UDim2.new(1 - i/100, 0, 1, 0)
			else
				break
			end
		end
		self:Dismiss(id)
	end)

	local notif = {
		id = id,
		type = type,
		title = title,
		message = message,
		duration = duration,
		timestamp = os.time(),
		frame = notifFrame,
	}

	table.insert(self.notifications, notif)

	print(string.format("[Arkher Notification] %s - %s: %s (%ds)", type, title, message, duration))

	return id
end

function NotificationSystem:NotifySuccess(title: string, message: string) return self:Notify("Success", title, message, 4) end
function NotificationSystem:NotifyError(title: string, message: string) return self:Notify("Error", title, message, 8) end
function NotificationSystem:NotifyWarning(title: string, message: string) return self:Notify("Warning", title, message, 6) end
function NotificationSystem:NotifyInfo(title: string, message: string) return self:Notify("Info", title, message, 5) end
function NotificationSystem:NotifyAI(title: string, message: string) return self:Notify("AI", title, message, 6) end

function NotificationSystem:Dismiss(id: string)
	for i, notif in self.notifications do
		if notif.id == id then
			if notif.frame and notif.frame.Parent then
				-- Fade out
				task.spawn(function()
					for t = 0, 1, 0.1 do
						task.wait(0.03)
						if notif.frame then
							notif.frame.BackgroundTransparency = t
						end
					end
					if notif.frame then notif.frame:Destroy() end
				end)
			end
			table.remove(self.notifications, i)
			break
		end
	end
end

function NotificationSystem:ClearAll()
	for _, notif in self.notifications do
		if notif.frame then notif.frame:Destroy() end
	end
	self.notifications = {}
	print("[Arkher Notification] Cleared all")
end

function NotificationSystem:GetStats()
	return {
		count = #self.notifications,
		nextId = self.nextId,
		message = "NotificationSystem - Figma + Notion + VS Code level - Info/Success/Warning/Error/AI - Auto dismiss + progress bar + Beginner friendly - Polimento 100%",
	}
end

return NotificationSystem
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXd8e28ab6d34b92f0">
    <Properties>
      <string name="Name">Onboarding</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Onboarding - Polimento Total - UI amigavel iniciantes
-- Inspirado no melhor: Figma onboarding, Notion, Blender splash, Unreal learning
-- Mas nosso: amigavel pra iniciantes, intermediarios, avancados, com ARKHER AI v1

local ThemeSystem = require(script.Parent.ThemeSystem)

local Onboarding = {}
Onboarding.__index = Onboarding

Onboarding.Steps = {
	Beginner = {
		{ id = "welcome", title = "Bem-vindo ao Arkher Studio! ", description = "O engine que mata Roblox Studio - Crie jogos AAA no seu perfil, até no A01!", icon = "Publish", action = "next" },
		{ id = "move", title = "Mova-se no mundo World", description = "Arraste para olhar ao redor. Use WASD para mover. No mobile, use um dedo para olhar, dois para mover.", icon = "Move", action = "try" },
		{ id = "select", title = "Selecione objetos ", description = "Clique em objetos no mundo para selecionar. No mobile, toque. Veja propriedades no painel Details.", icon = "", action = "try" },
		{ id = "add", title = "Adicione objetos Toolbox", description = "Vá em 'Add Objects' e clique em um objeto para adicionar ao mundo. Temos 120 assets AAA!", icon = "Add", action = "try" },
		{ id = "make3d", title = "Crie 3D com IA AI", description = "Vá em 'Make 3D' e clique 'AI Generate' - digite 'katana cyberpunk' e ARKHER AI v1 cria pra você! Nossa IA própria 3.98M params.", icon = "Style", action = "try" },
		{ id = "play", title = "Teste seu jogo Play️", description = "Clique PLAY para testar seu jogo! Veja como ficou.", icon = "Game", action = "play" },
		{ id = "publish", title = "Publique! Publish", description = "Clique Publish para publicar seu jogo real no seu perfil Roblox! Vira jogo de verdade.", icon = "Publish", action = "publish" },
		{ id = "ai", title = "Peça ajuda pra IA AI", description = "Clique no botão AI e converse com ARKHER AI v1 - nossa IA própria sem depender de empresas! Ela ajuda em tudo: modelo, animação, terreno, script.", icon = "Chat", action = "ai" },
	},
	Intermediate = {
		{ id = "welcome", title = "Arkher Studio - Intermediate", description = "Você já sabe o básico! Vamos pro nível pro: Modeler Blender++, Animator GTA 6, Terrain Mecha, Monaco Pro + ARKHER AI v1", icon = "Publish", action = "next" },
		{ id = "modeler", title = "Arkher Engineer - Blender++ Style", description = "60+ tools vs Blender 30 - 20+ brushes ZBrush - Geometry Nodes Houdini - UV - PBR - AI Generate com ARKHER AI v1 própria", icon = "Style", action = "open_modeler" },
		{ id = "animator", title = "Arkher Motion - GTA 6 Motion", description = "Cutscene editor GTA 6 + Unreal 6 Sequencer + Cascadeur - Pode animar TUDO: rigs, tools, effects, sky, decals, lights, camera - Physics atomic/quantum backend IA - Curve humanized", icon = "Motion", action = "open_animator" },
		{ id = "terrain", title = "Terrain World Creator + Mecha Terrain", description = "World Creator + Mecha Engine custom - chunked 32x32x32 infinite - Greedy Meshing 10x + Dual Contouring - Erosion - Biomes 7 - 15GB - ARKHER AI v1 terrain gen", icon = "Terrain", action = "open_terrain" },
		{ id = "script", title = "Monaco Pro + ARKHER AI v1 Script", description = "VS Code level + 25 plugins - ESLint, Prettier, IntelliSense, GitLens, Vim, Emmet, Copilot ARKHER AI v1 própria 3.98M params", icon = "Script", action = "open_script" },
		{ id = "command", title = "Command Palette Ctrl+K ⌘", description = "Pressione Ctrl+K para abrir Command Palette - 50+ comandos - Fuzzy search - Beginner to Pro", icon = "⌘", action = "command" },
	},
	Advanced = {
		{ id = "welcome", title = "Arkher Studio - Advanced/Pro", description = "Nível pro: Geometry Nodes, Curve Editor humanized Unreal 6 + Cascadeur, Cutscene GTA 6 4K 60 FPS, Physics atomic/quantum, Auto Rig, 15GB, ANG DLSS 4+5, Mecha Engine Custom", icon = "Publish", action = "next" },
		{ id = "physics", title = "Physics atomic/quantum ⚛️", description = "Newtonian, RigidBody Rapier, SoftBody FEM, Cloth PBD, Fluid Navier-Stokes, Hair Cosserat, Muscle Hill, Atomic Schrödinger, Quantum superposition, Relativistic E=mc² - Backend IA knowledge", icon = "⚛️", action = "physics" },
		{ id = "nodes", title = "Geometry Nodes GeoNodes", description = "Houdini level - Procedural modeling - Nodes - Melhor que Blender", icon = "GeoNodes", action = "nodes" },
		{ id = "curve", title = "Curve Editor humanized Curve", description = "Unreal 6 + Cascadeur - Humanized = real human motion from mocap + physics + ARKHER AI v1 trained - GTA 6 level", icon = "Curve", action = "curve" },
		{ id = "cutscene", title = "Cutscene GTA 6 Motion", description = "Rockstar level - Camera cuts, Character acting, Facial, Lip sync, Lighting cinematic, VFX, Dialogue, Subtitles, 4K 60 FPS", icon = "Motion", action = "cutscene" },
		{ id = "arkherai", title = "ARKHER AI v1 própria AI", description = "3.98M params - v0.1.0-gamedev - BPE próprio - Transformer 4 layers - Sem depender de empresas - Game dev focus - 3D generation próprio - Fase 6 Mecha - https://github.com/PlexztyRBXStudiosBR/ARKHERAI_resynced", icon = "AI", action = "ai" },
	},
}

function Onboarding.new(themeSystem: any, level: string?)
	return setmetatable({
		themeSystem = themeSystem,
		level = level or "Beginner",
		currentStep = 1,
		isActive = false,
		frame = nil :: Frame?,
		completed = {} :: { [string]: boolean },
	}, Onboarding)
end

function Onboarding:Init(parent: ScreenGui)
	local colors = self.themeSystem:GetColors()

	local overlay = Instance.new("Frame")
	overlay.Name = "OnboardingOverlay"
	overlay.Size = UDim2.new(1, 0, 1, 0)
	overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	overlay.BackgroundTransparency = 0.6
	overlay.Visible = false
	overlay.ZIndex = 200
	overlay.Parent = parent

	local card = Instance.new("Frame")
	card.Name = "OnboardingCard"
	card.Size = UDim2.new(0, 400, 0, 300)
	card.Position = UDim2.new(0.5, -200, 0.5, -150)
	card.BackgroundColor3 = colors.panel
	card.BorderSizePixel = 0
	card.ZIndex = 201
	card.Parent = overlay

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = card

	local stroke = Instance.new("UIStroke")
	stroke.Color = colors.accent
	stroke.Thickness = 2
	stroke.Parent = card

	local iconLabel = Instance.new("TextLabel")
	iconLabel.Name = "Icon"
	iconLabel.Size = UDim2.new(1, 0, 0, 60)
	iconLabel.BackgroundTransparency = 1
	iconLabel.Text = "Publish"
	iconLabel.TextSize = 40
	iconLabel.Parent = card

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, -20, 0, 30)
	titleLabel.Position = UDim2.new(0, 10, 0, 60)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "Bem-vindo ao Arkher Studio!"
	titleLabel.TextColor3 = colors.text
	titleLabel.TextSize = 16
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextWrapped = true
	titleLabel.Parent = card

	local descLabel = Instance.new("TextLabel")
	descLabel.Name = "Description"
	descLabel.Size = UDim2.new(1, -20, 0, 80)
	descLabel.Position = UDim2.new(0, 10, 0, 90)
	descLabel.BackgroundTransparency = 1
	descLabel.Text = "O engine que mata Roblox Studio"
	descLabel.TextColor3 = colors.textDim
	descLabel.TextSize = 12
	descLabel.Font = Enum.Font.Gotham
	descLabel.TextWrapped = true
	descLabel.Parent = card

	local nextBtn = Instance.new("TextButton")
	nextBtn.Name = "NextBtn"
	nextBtn.Size = UDim2.new(0.5, -15, 0, 36)
	nextBtn.Position = UDim2.new(0.5, 5, 1, -50)
	nextBtn.BackgroundColor3 = colors.accent
	nextBtn.Text = "Next →"
	nextBtn.TextColor3 = Color3.new(1,1,1)
	nextBtn.TextSize = 13
	nextBtn.Font = Enum.Font.GothamBold
	nextBtn.Parent = card

	local nextCorner = Instance.new("UICorner")
	nextCorner.CornerRadius = UDim.new(0, 8)
	nextCorner.Parent = nextBtn

	local skipBtn = Instance.new("TextButton")
	skipBtn.Name = "SkipBtn"
	skipBtn.Size = UDim2.new(0.5, -15, 0, 36)
	skipBtn.Position = UDim2.new(0, 10, 1, -50)
	skipBtn.BackgroundColor3 = colors.panelLight
	skipBtn.Text = "Skip"
	skipBtn.TextColor3 = colors.text
	skipBtn.TextSize = 12
	skipBtn.Font = Enum.Font.Gotham
	skipBtn.Parent = card

	local skipCorner = Instance.new("UICorner")
	skipCorner.CornerRadius = UDim.new(0, 8)
	skipCorner.Parent = skipBtn

	self.frame = overlay

	nextBtn.MouseButton1Click:Connect(function() self:Next() end)
	skipBtn.MouseButton1Click:Connect(function() self:Close() end)

	print("[Arkher Onboarding] Initialized - Level:", self.level, "- Steps:", #Onboarding.Steps[self.level])
end

function Onboarding:Start(level: string?)
	self.level = level or self.level
	self.currentStep = 1
	self.isActive = true
	if self.frame then self.frame.Visible = true end
	self:ShowStep(self.currentStep)
	print("[Arkher Onboarding] Started - Level:", self.level)
end

function Onboarding:ShowStep(stepIndex: number)
	local steps = Onboarding.Steps[self.level]
	if not steps or not steps[stepIndex] then
		self:Close()
		return
	end

	local step = steps[stepIndex]
	if not self.frame then return end

	local card = self.frame:FindFirstChild("OnboardingCard")
	if not card then return end

	local icon = card:FindFirstChild("Icon") :: TextLabel
	local title = card:FindFirstChild("Title") :: TextLabel
	local desc = card:FindFirstChild("Description") :: TextLabel
	local nextBtn = card:FindFirstChild("NextBtn") :: TextButton

	if icon then icon.Text = step.icon end
	if title then title.Text = step.title end
	if desc then desc.Text = step.description end
	if nextBtn then nextBtn.Text = stepIndex == #steps and "Finish " or "Next →"

	end

	print("[Arkher Onboarding] Step", stepIndex, "/", #steps, "-", step.title)
end

function Onboarding:Next()
	local steps = Onboarding.Steps[self.level]
	if self.currentStep &gt;= #steps then
		self:Close()
		return
	end

	self.currentStep += 1
	self:ShowStep(self.currentStep)
end

function Onboarding:Close()
	if self.frame then self.frame.Visible = false end
	self.isActive = false
	print("[Arkher Onboarding] Closed - Completed onboarding for", self.level)
end

function Onboarding:GetStats()
	return {
		level = self.level,
		currentStep = self.currentStep,
		isActive = self.isActive,
		totalSteps = Onboarding.Steps[self.level] and #Onboarding.Steps[self.level] or 0,
		message = "Onboarding - Beginner/Intermediate/Advanced - Figma + Notion + Blender + Unreal - Friendly - ARKHER AI v1",
	}
end

return Onboarding
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX4a2a4e0c2a4ffae1">
    <Properties>
      <string name="Name">Outliner</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 1 - Outliner Funcional
-- Lista entidades, busca, seleção, delete, duplicate - Estilo Unreal World Outliner

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage.Arkher.ECS.World)
local Shell = require(script.Parent.Shell)

local Outliner = {}
Outliner.__index = Outliner

function Outliner.new(world: World.World, buildingService: any)
	return setmetatable({
		world = world,
		buildingService = buildingService,
		frame = nil :: Frame?,
		entityList = nil :: ScrollingFrame?,
		searchBox = nil :: TextBox?,
		entityButtons = {} :: { [string]: TextButton },
		selectedId = nil :: string?,
		filter = "",
	}, Outliner)
end

function Outliner:Init(parent: Frame)
	-- Pega frame já criado pelo Shell ou cria novo
	self.frame = parent

	-- Encontra componentes
	self.entityList = parent:FindFirstChild("EntityList") :: ScrollingFrame
	self.searchBox = parent:FindFirstChild("Search") :: TextBox

	if self.searchBox then
		self.searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			self.filter = string.lower(self.searchBox.Text)
			self:Refresh()
		end)
	end

	-- Eventos de mudança
	local buildingChanged = ReplicatedStorage:FindFirstChild("ArkherBuildingChanged")
	if buildingChanged then
		buildingChanged.Event:Connect(function()
			self:Refresh()
		end)
	end

	local selectionChanged = ReplicatedStorage:FindFirstChild("ArkherSelectionChanged")
	if selectionChanged then
		selectionChanged.Event:Connect(function(entityId)
			self.selectedId = entityId
			self:UpdateSelection()
		end)
	end

	print("[Arkher Outliner] Initialized")
	self:Refresh()
end

function Outliner:Refresh()
	if not self.entityList then return end

	-- Limpa botões antigos
	for _, btn in self.entityButtons do
		if btn.Parent then
			btn:Destroy()
		end
	end
	self.entityButtons = {}

	local entities = self.world:GetRootEntities()

	-- Aplica filtro
	local filtered = {}
	for _, entity in entities do
		if self.filter == "" or string.find(string.lower(entity.name), self.filter) then
			table.insert(filtered, entity)
		end
	end

	-- Ordena por nome
	table.sort(filtered, function(a, b)
		return a.name &lt; b.name
	end)

	-- Cria botão para cada entidade
	for i, entity in filtered do
		local btn = self:CreateEntityButton(entity, i)
		btn.Parent = self.entityList
		self.entityButtons[entity.id] = btn
	end

	print("[Arkher Outliner] Refreshed -", #filtered, "entities (filter:", self.filter, ")")
end

function Outliner:CreateEntityButton(entity: any, order: number): TextButton
	local btn = Instance.new("TextButton")
	btn.Name = "Entity_" .. entity.id
	btn.Size = UDim2.new(1, -10, 0, 28)
	btn.BackgroundColor3 = self.selectedId == entity.id and Shell.Colors.accent or Shell.Colors.background
	btn.BorderSizePixel = 0
	btn.LayoutOrder = order
	btn.Text = ""
	btn.AutoButtonColor = false

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 4)
	corner.Parent = btn

	-- Ícone baseado no tipo
	local icon = Instance.new("TextLabel")
	icon.Name = "Icon"
	icon.Size = UDim2.new(0, 24, 1, 0)
	icon.Position = UDim2.new(0, 4, 0, 0)
	icon.BackgroundTransparency = 1
	icon.Text = self:GetEntityIcon(entity)
	icon.TextColor3 = Shell.Colors.textDim
	icon.TextSize = 14
	icon.Font = Enum.Font.Gotham
	icon.Parent = btn

	-- Nome
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.Size = UDim2.new(1, -60, 1, 0)
	nameLabel.Position = UDim2.new(0, 28, 0, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = entity.name
	nameLabel.TextColor3 = entity.isHidden and Shell.Colors.textDim or Shell.Colors.text
	nameLabel.TextSize = 12
	nameLabel.Font = Enum.Font.Gotham
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.TextTruncate = Enum.TextTruncate.AtRight
	nameLabel.Parent = btn

	-- Ações (visível no hover - Fase 2)
	local actions = Instance.new("Frame")
	actions.Name = "Actions"
	actions.Size = UDim2.new(0, 40, 1, 0)
	actions.Position = UDim2.new(1, -40, 0, 0)
	actions.BackgroundTransparency = 1
	actions.Parent = btn

	-- Click para selecionar
	btn.MouseButton1Click:Connect(function()
		self.buildingService:SelectEntity(entity.id)
	end)

	-- Duplo clique para focar (Fase 2)
	-- btn.MouseButton2Click para menu contexto (delete, duplicate, etc)

	return btn
end

function Outliner:GetEntityIcon(entity: any): string
	if entity.components.Render then
		local style = entity.components.Render.styleProfile
		if style == "lowpoly" then return "LowPoly"
		elseif style == "anime" then return ""
		elseif style == "photorealistic" then return "Photoreal"
		elseif style == "ultrarealistic" then return "Vault"
		else return "Cube" end
	elseif entity.components.ScriptComponent then
		return "Script"
	elseif entity.components.LightComponent then
		return "Tip"
	else
		return ""
	end
end

function Outliner:UpdateSelection()
	for id, btn in self.entityButtons do
		if id == self.selectedId then
			btn.BackgroundColor3 = Shell.Colors.accent
		else
			btn.BackgroundColor3 = Shell.Colors.background
		end
	end
end

function Outliner:SelectEntity(entityId: string?)
	self.selectedId = entityId
	self:UpdateSelection()
end

return Outliner
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX618696e37fca6697">
    <Properties>
      <string name="Name">Shell</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - UI Shell - Inspirado na Unreal 5, não no Roblox Studio
-- Dark theme, dockable, moderno. Nunca copiar, inspirar.

local Shell = {}

-- Cores Unreal 5 inspired
Shell.Colors = {
	background = Color3.fromRGB(20, 20, 20),
	panel = Color3.fromRGB(35, 35, 35),
	panelLight = Color3.fromRGB(45, 45, 45),
	border = Color3.fromRGB(55, 55, 55),
	accent = Color3.fromRGB(0, 120, 215), -- Unreal blue
	accentHover = Color3.fromRGB(0, 140, 255),
	text = Color3.fromRGB(230, 230, 230),
	textDim = Color3.fromRGB(150, 150, 150),
	success = Color3.fromRGB(0, 200, 100),
	warning = Color3.fromRGB(255, 180, 0),
	error = Color3.fromRGB(255, 60, 60),
}

Shell.Fonts = {
	regular = Font.fromEnum(Enum.Font.Gotham),
	bold = Font.fromEnum(Enum.Font.GothamBold),
	mono = Font.fromEnum(Enum.Font.Code),
}

function Shell.CreateMainScreenGui(): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "ArkherStudioShell"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10

	-- Detecta plataforma para adaptar
	local isMobile = false
	pcall(function()
		local UIS = game:GetService("UserInputService")
		isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
	end)

	if isMobile then
		gui.Name = "ArkherStudioShell_Mobile"
	end

	return gui
end

function Shell.CreatePanel(name: string, size: UDim2, position: UDim2): Frame
	local panel = Instance.new("Frame")
	panel.Name = name
	panel.Size = size
	panel.Position = position
	panel.BackgroundColor3 = Shell.Colors.panel
	panel.BorderSizePixel = 0

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = panel

	local stroke = Instance.new("UIStroke")
	stroke.Color = Shell.Colors.border
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = panel

	return panel
end

function Shell.CreateTopBar(): Frame
	-- TopBar estilo Unreal 5: File Edit Window Tools Build etc + Play buttons
	local topBar = Shell.CreatePanel("TopBar", UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, 0))
	topBar.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	topBar.ZIndex = 10

	-- Logo Arkher
	local logo = Instance.new("TextLabel")
	logo.Name = "Logo"
	logo.Size = UDim2.new(0, 150, 1, 0)
	logo.Position = UDim2.new(0, 10, 0, 0)
	logo.BackgroundTransparency = 1
	logo.Text = "ARKHER STUDIO"
	logo.TextColor3 = Shell.Colors.text
	logo.TextSize = 16
	logo.Font = Enum.Font.GothamBold
	logo.TextXAlignment = Enum.TextXAlignment.Left
	logo.Parent = topBar

	-- Version badge
	local badge = Instance.new("TextLabel")
	badge.Name = "VersionBadge"
	badge.Size = UDim2.new(0, 80, 0, 20)
	badge.Position = UDim2.new(0, 160, 0.5, -10)
	badge.BackgroundColor3 = Shell.Colors.accent
	badge.Text = "ALPHA 0.1"
	badge.TextColor3 = Color3.new(1,1,1)
	badge.TextSize = 10
	badge.Font = Enum.Font.GothamBold
	badge.Parent = topBar

	local badgeCorner = Instance.new("UICorner")
	badgeCorner.CornerRadius = UDim.new(0, 4)
	badgeCorner.Parent = badge

	-- Play controls (centro)
	local playContainer = Instance.new("Frame")
	playContainer.Name = "PlayControls"
	playContainer.Size = UDim2.new(0, 280, 1, 0)
	playContainer.Position = UDim2.new(0.5, -140, 0, 0)
	playContainer.BackgroundTransparency = 1
	playContainer.Parent = topBar

	local saveBtn = Instance.new("TextButton")
	saveBtn.Name = "SaveBtn"
	saveBtn.Size = UDim2.new(0, 60, 0, 28)
	saveBtn.Position = UDim2.new(0, 0, 0.5, -14)
	saveBtn.BackgroundColor3 = Shell.Colors.panelLight
	saveBtn.Text = "Save Save"
	saveBtn.TextColor3 = Shell.Colors.text
	saveBtn.TextSize = 11
	saveBtn.Font = Enum.Font.Gotham
	saveBtn.Parent = playContainer

	local saveCorner = Instance.new("UICorner")
	saveCorner.CornerRadius = UDim.new(0, 6)
	saveCorner.Parent = saveBtn

	local playBtn = Instance.new("TextButton")
	playBtn.Name = "PlayBtn"
	playBtn.Size = UDim2.new(0, 80, 0, 28)
	playBtn.Position = UDim2.new(0, 70, 0.5, -14)
	playBtn.BackgroundColor3 = Shell.Colors.success
	playBtn.Text = "Play PLAY"
	playBtn.TextColor3 = Color3.new(1,1,1)
	playBtn.TextSize = 12
	playBtn.Font = Enum.Font.GothamBold
	playBtn.Parent = playContainer

	local playCorner = Instance.new("UICorner")
	playCorner.CornerRadius = UDim.new(0, 6)
	playCorner.Parent = playBtn

	local publishBtn = Instance.new("TextButton")
	publishBtn.Name = "PublishBtn"
	publishBtn.Size = UDim2.new(0, 80, 0, 28)
	publishBtn.Position = UDim2.new(0, 160, 0.5, -14)
	publishBtn.BackgroundColor3 = Shell.Colors.accent
	publishBtn.Text = "Publish Publish"
	publishBtn.TextColor3 = Color3.new(1,1,1)
	publishBtn.TextSize = 11
	publishBtn.Font = Enum.Font.GothamBold
	publishBtn.Parent = playContainer

	local publishCorner = Instance.new("UICorner")
	publishCorner.CornerRadius = UDim.new(0, 6)
	publishCorner.Parent = publishBtn

	-- Style selector (direita)
	local styleSelector = Instance.new("TextButton")
	styleSelector.Name = "StyleSelector"
	styleSelector.Size = UDim2.new(0, 150, 0, 28)
	styleSelector.Position = UDim2.new(1, -160, 0.5, -14)
	styleSelector.BackgroundColor3 = Shell.Colors.panelLight
	styleSelector.Text = "Style Realistic ▼"
	styleSelector.TextColor3 = Shell.Colors.text
	styleSelector.TextSize = 12
	styleSelector.Font = Enum.Font.Gotham
	styleSelector.Parent = topBar

	local styleCorner = Instance.new("UICorner")
	styleCorner.CornerRadius = UDim.new(0, 6)
	styleCorner.Parent = styleSelector

	return topBar
end

function Shell.CreateOutliner(): Frame
	-- Outliner = Explorer, mas estilo Unreal (World Outliner)
	local outliner = Shell.CreatePanel("Outliner", UDim2.new(0, 280, 1, -120), UDim2.new(0, 0, 0, 50))
	
	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 30)
	header.BackgroundColor3 = Shell.Colors.panelLight
	header.Text = "  World WORLD OUTLINER"
	header.TextColor3 = Shell.Colors.text
	header.TextSize = 12
	header.Font = Enum.Font.GothamBold
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Parent = outliner

	local headerCorner = Instance.new("UICorner")
	headerCorner.CornerRadius = UDim.new(0, 6)
	headerCorner.Parent = header

	-- Search bar
	local search = Instance.new("TextBox")
	search.Name = "Search"
	search.Size = UDim2.new(1, -20, 0, 28)
	search.Position = UDim2.new(0, 10, 0, 40)
	search.BackgroundColor3 = Shell.Colors.background
	search.PlaceholderText = "Search Search entities..."
	search.Text = ""
	search.TextColor3 = Shell.Colors.text
	search.TextSize = 12
	search.Font = Enum.Font.Gotham
	search.ClearTextOnFocus = false
	search.Parent = outliner

	local searchCorner = Instance.new("UICorner")
	searchCorner.CornerRadius = UDim.new(0, 4)
	searchCorner.Parent = search

	-- Scrolling list para entidades
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "EntityList"
	scroll.Size = UDim2.new(1, -20, 1, -80)
	scroll.Position = UDim2.new(0, 10, 0, 75)
	scroll.BackgroundTransparency = 1
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = outliner

	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = scroll

	return outliner
end

function Shell.CreateDetailsPanel(): Frame
	-- Details Panel = Properties, estilo Unreal
	local details = Shell.CreatePanel("Details", UDim2.new(0, 320, 1, -120), UDim2.new(1, -320, 0, 50))

	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 30)
	header.BackgroundColor3 = Shell.Colors.panelLight
	header.Text = "  Details DETAILS"
	header.TextColor3 = Shell.Colors.text
	header.TextSize = 12
	header.Font = Enum.Font.GothamBold
	header.TextXAlignment = Enum.TextXAlignment.Left
	header.Parent = details

	-- Transform section
	local transformSection = Instance.new("Frame")
	transformSection.Name = "TransformSection"
	transformSection.Size = UDim2.new(1, -20, 0, 100)
	transformSection.Position = UDim2.new(0, 10, 0, 40)
	transformSection.BackgroundColor3 = Shell.Colors.background
	transformSection.Parent = details

	local tCorner = Instance.new("UICorner")
	tCorner.CornerRadius = UDim.new(0, 4)
	tCorner.Parent = transformSection

	local tLabel = Instance.new("TextLabel")
	tLabel.Size = UDim2.new(1, 0, 0, 20)
	tLabel.BackgroundTransparency = 1
	tLabel.Text = "  Transform"
	tLabel.TextColor3 = Shell.Colors.text
	tLabel.TextSize = 11
	tLabel.Font = Enum.Font.GothamBold
	tLabel.TextXAlignment = Enum.TextXAlignment.Left
	tLabel.Parent = transformSection

	return details
end

function Shell.CreateContentDrawer(): Frame
	-- Content Drawer = Toolbox + Vault + Modeling + Script Pro + AI, estilo Unreal - Fase 3
	local drawer = Shell.CreatePanel("ContentDrawer", UDim2.new(1, -600, 0, 240), UDim2.new(0, 290, 1, -250))

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 30)
	header.BackgroundColor3 = Shell.Colors.panelLight
	header.Parent = drawer

	-- Tabs Fase 4: Vault + Toolbox + Modeler + Animator + Terrain + Script Pro + AI + Project
	local tabs = {
		{ name = "Vault Vault", color = Shell.Colors.accent },
		{ name = "Toolbox Toolbox", color = Shell.Colors.panelLight },
		{ name = "Style Modeler", color = Color3.fromRGB(200, 100, 255) },
		{ name = "Motion Animator", color = Color3.fromRGB(255, 100, 100) },
		{ name = "Terrain Terrain", color = Color3.fromRGB(100, 200, 100) },
		{ name = "Script Script Pro", color = Color3.fromRGB(55, 118, 171) },
		{ name = "AI AI Gen", color = Color3.fromRGB(255, 180, 0) },
		{ name = "Project Project", color = Shell.Colors.panelLight },
	}

	local headerScroll = Instance.new("ScrollingFrame")
	headerScroll.Name = "HeaderScroll"
	headerScroll.Size = UDim2.new(1, 0, 1, 0)
	headerScroll.BackgroundTransparency = 1
	headerScroll.ScrollBarThickness = 0
	headerScroll.CanvasSize = UDim2.new(0, #tabs*110, 0, 0)
	headerScroll.Parent = header

	local headerLayout = Instance.new("UIListLayout")
	headerLayout.FillDirection = Enum.FillDirection.Horizontal
	headerLayout.SortOrder = Enum.SortOrder.LayoutOrder
	headerLayout.Padding = UDim.new(0, 5)
	headerLayout.Parent = headerScroll

	for i, tab in tabs do
		local tabBtn = Instance.new("TextButton")
		tabBtn.Name = "Tab_" .. tab.name
		tabBtn.Size = UDim2.new(0, 100, 1, 0)
		tabBtn.BackgroundColor3 = i == 1 and tab.color or Shell.Colors.panelLight
		tabBtn.Text = tab.name
		tabBtn.TextColor3 = Shell.Colors.text
		tabBtn.TextSize = 10
		tabBtn.Font = Enum.Font.Gotham
		tabBtn.LayoutOrder = i
		tabBtn.Parent = headerScroll

		local tabCorner = Instance.new("UICorner")
		tabCorner.CornerRadius = UDim.new(0, 4)
		tabCorner.Parent = tabBtn
	end

	-- Grid de assets (default)
	local grid = Instance.new("ScrollingFrame")
	grid.Name = "AssetGrid"
	grid.Size = UDim2.new(1, -20, 1, -40)
	grid.Position = UDim2.new(0, 10, 0, 35)
	grid.BackgroundTransparency = 1
	grid.ScrollBarThickness = 4
	grid.CanvasSize = UDim2.new(0, 0, 0, 0)
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.Parent = drawer

	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0, 80, 0, 80)
	gridLayout.CellPadding = UDim2.new(0, 10, 0, 10)
	gridLayout.Parent = grid

	return drawer
end

function Shell.CreateViewport(): Frame
	-- Viewport central, onde o jogo é editado
	local viewport = Instance.new("Frame")
	viewport.Name = "Viewport"
	viewport.Size = UDim2.new(1, -620, 1, -260)
	viewport.Position = UDim2.new(0, 290, 0, 50)
	viewport.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	viewport.BorderSizePixel = 0
	viewport.ClipsDescendants = true

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = viewport

	-- Viewport label
	local label = Instance.new("TextLabel")
	label.Name = "ViewportLabel"
	label.Size = UDim2.new(0, 200, 0, 20)
	label.Position = UDim2.new(0, 10, 0, 10)
	label.BackgroundColor3 = Color3.fromRGB(0,0,0)
	label.BackgroundTransparency = 0.5
	label.Text = "  Perspective - Realistic [ANG ON]"
	label.TextColor3 = Shell.Colors.textDim
	label.TextSize = 10
	label.Font = Enum.Font.Code
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = viewport

	-- Gizmo toolbar (top left do viewport)
	local gizmoBar = Instance.new("Frame")
	gizmoBar.Name = "GizmoBar"
	gizmoBar.Size = UDim2.new(0, 120, 0, 30)
	gizmoBar.Position = UDim2.new(0, 10, 0, 40)
	gizmoBar.BackgroundColor3 = Shell.Colors.panel
	gizmoBar.Parent = viewport

	local gizmoCorner = Instance.new("UICorner")
	gizmoCorner.CornerRadius = UDim.new(0, 6)
	gizmoCorner.Parent = gizmoBar

	for i, gizmo in {"W", "E", "R", "T"} do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 28, 0, 28)
		btn.Position = UDim2.new(0, (i-1)*30 + 1, 0, 1)
		btn.BackgroundColor3 = Shell.Colors.panelLight
		btn.Text = gizmo
		btn.TextColor3 = Shell.Colors.text
		btn.TextSize = 12
		btn.Font = Enum.Font.GothamBold
		btn.Parent = gizmoBar
	end

	return viewport
end

function Shell.BuildFullUI(parent: Instance): { [string]: Frame }
	local topBar = Shell.CreateTopBar()
	topBar.Parent = parent

	local outliner = Shell.CreateOutliner()
	outliner.Parent = parent

	local details = Shell.CreateDetailsPanel()
	details.Parent = parent

	local contentDrawer = Shell.CreateContentDrawer()
	contentDrawer.Parent = parent

	local viewport = Shell.CreateViewport()
	viewport.Parent = parent

	print("[Arkher Shell] Built Unreal-inspired UI - Mobile &amp; PC compatible")

	return {
		topBar = topBar,
		outliner = outliner,
		details = details,
		contentDrawer = contentDrawer,
		viewport = viewport,
	}
end

return Shell
</ProtectedString>
    </Properties>
