function MechaAdapter:GetStats(): MechaStats &amp; { message: string }
	return {
		totalChunks = 0,
		totalBodies = self.physicsWorld and 0 or 0,
		totalMeshes = 0,
		totalAudioSources = 0,
		totalNetPlayers = 0,
