  <Item class="ModuleScript" referent="RBX7b41fa1bd9776ce1">
    <Properties>
      <string name="Name">PythonAdvanced</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 2 - PythonAdvanced - Suporte a classes, async/await, decorators, etc
-- Python 3.14 completo via transpilação + backend

local PythonAdvanced = {}

-- Exemplo de como transpilar classe Python -&gt; Luau
PythonAdvanced.ClassExample = [[
# Python 3.14 - Classe
class CoinSystem:
    def __init__(self, amount: int = 10):
        self.amount = amount
        self.collected = 0
    
    def collect(self, player):
        self.collected += self.amount
        print(f"{player.Name} coletou {self.amount} moedas! Total: {self.collected}")
        return self.collected
    
    @property
    def total(self):
        return self.collected

# Uso
system = CoinSystem(100)
system.collect(player)
]]

PythonAdvanced.LuauTranspiledClassExample = [[
-- Transpilado de Python classe -&gt; Luau
local CoinSystem = {}
CoinSystem.__index = CoinSystem

function CoinSystem.new(amount)
    return setmetatable({
        amount = amount or 10,
        collected = 0,
    }, CoinSystem)
end

function CoinSystem:collect(player)
    self.collected += self.amount
    print(string.format("%s coletou %d moedas! Total: %d", player.Name, self.amount, self.collected))
    return self.collected
end

function CoinSystem:getTotal()
    return self.collected
end

-- Uso
local system = CoinSystem.new(100)
system:collect(player)
]]

-- Decorators Python -&gt; Luau
PythonAdvanced.DecoratorExample = [[
# Python 3.14 - Decorator
def debug(func):
    def wrapper(*args, **kwargs):
        print(f"Chamando {func.__name__} com {args}")
        result = func(*args, **kwargs)
        print(f"{func.__name__} retornou {result}")
        return result
    return wrapper

@debug
def give_coins(player, amount):
    return amount

# Transpila para Luau com wrapper
]]

-- Async/Await Python -&gt; Luau task
PythonAdvanced.AsyncExample = [[
# Python 3.14 - Async/Await
import asyncio

async def spawn_coins(world, count: int):
    for i in range(count):
        coin = Entity.new(f"Coin_{i}")
        world.add_entity(coin)
        print(f"Spawned {coin.name}")
        await asyncio.sleep(0.5)  # espera 0.5s

# Transpila para Luau:
# local function spawn_coins(world, count)
#     for i=0,count-1 do
#         local coin = Entity.new("Coin_"..i)
#         world:AddEntity(coin)
#         task.wait(0.5)
#     end
# end
]]

function PythonAdvanced.TranspileClass(pythonClassCode: string): string
	-- Fase 2: Transpila classe Python para Luau table + metatable
	-- Usa parsing simples, Fase 3 usa AST completo

	local luau = "-- Transpiled Python class -&gt; Luau\n"

	-- Extrai nome da classe
	local className = string.match(pythonClassCode, "class%s+([%w_]+)")
	if not className then
		return "-- Failed to parse class"
	end

	luau ..= string.format("local %s = {}\n%s.__index = %s\n\n", className, className, className)

	-- __init__ -&gt; new
	local initParams = string.match(pythonClassCode, "def%s+__init__%s*%([^,]+,%s*([^%)]*)%)")
	if initParams then
		luau ..= string.format("function %s.new(%s)\n", className, initParams)
		luau ..= string.format("    return setmetatable({\n        -- TODO: parse __init__ body\n    }, %s)\nend\n\n", className)
	else
		luau ..= string.format("function %s.new()\n    return setmetatable({}, %s)\nend\n\n", className, className)
	end

	-- Métodos def -&gt; function Class:method
	for methodName, params in string.gmatch(pythonClassCode, "def%s+([%w_]+)%s*%(([^%)]*)%)") do
		if methodName ~= "__init__" then
			-- Remove self do params
			local cleanParams = string.gsub(params, "self%s*,?%s*", "")
			luau ..= string.format("function %s:%s(%s)\n    -- TODO: body\nend\n\n", className, methodName, cleanParams)
		end
	end

	return luau
end

function PythonAdvanced.TranspileAsync(pythonAsyncCode: string): string
	-- Transpila async/await para task.wait + task.spawn

	local luau = string.gsub(pythonAsyncCode, "async%s+def%s+([%w_]+)%s*%(([^%)]*)%)%s*:", "local function %1(%2)")

	luau = string.gsub(luau, "await%s+asyncio%.sleep%(([^%)]+)%)", "task.wait(%1)")

	luau = string.gsub(luau, "await%s+([%w_%.%(%)]+)", "task.wait() -- await %1")

	return luau
end

function PythonAdvanced.GetSupportedAdvancedFeatures(): { string }
	return {
		"classes (basic) - class -&gt; table + metatable",
		"__init__ -&gt; new()",
		"methods -&gt; function Class:method()",
		"@property -&gt; getX()",
		"@decorator (mock, Fase 3 full)",
		"async/await -&gt; task.spawn + task.wait",
		"asyncio.sleep -&gt; task.wait",
		"type hints (ignored at runtime, for docs + AI)",
		"match/case (transpiled to if/elseif)",
		"f-strings -&gt; Luau interpolation `...`",
		"walrus := (Fase 3)",
		"exception groups (Fase 3)",
	}
end

return PythonAdvanced
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX66b818f2d8993c26">
    <Properties>
      <string name="Name">PythonTranspiler</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 1.5 - Python 3.14 Transpiler -&gt; Luau
-- Permite programar em Python 3.14 dentro do Roblox
-- Transpila Python para Luau para execução nativa

local PythonTranspiler = {}
PythonTranspiler.__index = PythonTranspiler

function PythonTranspiler.new()
	return setmetatable({
		version = "3.14.0",
		target = "luau",
	}, PythonTranspiler)
end

-- Mapeamento de tipos Python -&gt; Luau
local TYPE_MAP = {
	["int"] = "number",
	["float"] = "number",
	["str"] = "string",
	["bool"] = "boolean",
	["list"] = "{any}",
	["dict"] = "{[any]: any}",
	["None"] = "nil",
}

-- Mapeamento de funções Python -&gt; Luau/Roblox
local FUNC_MAP = {
	["print"] = "print",
	["len"] = "#",
	["range"] = "Range", -- custom
	["str"] = "tostring",
	["int"] = "tonumber",
	["float"] = "tonumber",
}

function PythonTranspiler:Transpile(pythonCode: string): (string?, string?)
	-- Fase 1.5: Transpiler simples com regex + parsing básico
	-- Fase 2: Parser completo com AST

	print("[Arkher Python] Transpiling Python 3.14 -&gt; Luau -", #pythonCode, "bytes")

	local luauCode = pythonCode

	-- Passo 1: Comentários # -&gt; --
	luauCode = string.gsub(luauCode, "#([^\n]*)", "--%1")

	-- Passo 2: Def -&gt; function
	luauCode = string.gsub(luauCode, "def%s+([%w_]+)%s*%(([^%)]*)%)%s*:", "local function %1(%2)")

	-- Passo 3: : no final de def/if/for/while -&gt; remove e adiciona then/do
	luauCode = string.gsub(luauCode, "if%s+(.-)%s*:%s*\n", "if %1 then\n")
	luauCode = string.gsub(luauCode, "elif%s+(.-)%s*:%s*\n", "elseif %1 then\n")
	luauCode = string.gsub(luauCode, "else%s*:%s*\n", "else\n")
	luauCode = string.gsub(luauCode, "for%s+(.-)%s+in%s+(.-)%s*:%s*\n", "for %1 in %2 do\n")
	luauCode = string.gsub(luauCode, "while%s+(.-)%s*:%s*\n", "while %1 do\n")

	-- Passo 4: Python match -&gt; Luau if/elseif (simplificado)
	luauCode = string.gsub(luauCode, "match%s+(.-)%s*:%s*\n", "-- match %1 (transpiled to if)\nif true then\n")
	luauCode = string.gsub(luauCode, "case%s+\"(.-)\"%s*:%s*\n", "if _match == \"%1\" then\n")
	luauCode = string.gsub(luauCode, "case%s+_%s*:%s*\n", "else\n")

	-- Passo 5: True/False/None -&gt; true/false/nil
	luauCode = string.gsub(luauCode, "%f[%w]True%f[^%w]", "true")
	luauCode = string.gsub(luauCode, "%f[%w]False%f[^%w]", "false")
	luauCode = string.gsub(luauCode, "%f[%w]None%f[^%w]", "nil")

	-- Passo 6: and/or/not já são iguais em Luau

	-- Passo 7: F-strings f"..." -&gt; string.format ou interpolação Luau `...`
	luauCode = string.gsub(luauCode, "f\"([^\"]-)\"", function(content)
		-- Converte f"Hello {name}" -&gt; `Hello {name}` (Luau interpolation)
		local transformed = string.gsub(content, "{(.-)}", "{%1}")
		return "`" .. transformed .. "`"
	end)

	luauCode = string.gsub(luauCode, "f'([^']-)'", function(content)
		local transformed = string.gsub(content, "{(.-)}", "{%1}")
		return "`" .. transformed .. "`"
	end)

	-- Passo 8: Imports - from arkher import X -&gt; local X = require(...)
	luauCode = string.gsub(luauCode, "from%s+arkher%s+import%s+([%w_,%s]+)", function(imports)
		local result = ""
		for imp in string.gmatch(imports, "([%w_]+)") do
			result ..= string.format("local %s = require(game.ReplicatedStorage.Arkher.Python.%s)\n", imp, imp)
		end
		return result
	end)

	luauCode = string.gsub(luauCode, "import%s+([%w_]+)", "-- import %1 (handled)")

	-- Passo 9: Adiciona header
	local header = string.format([[
-- Transpiled from Python 3.14 to Luau by Arkher Python Transpiler v%s
-- Original Python code had %d lines
-- Target: Luau (Roblox)

-- Python compatibility layer
local Range = function(n) 
    local t = {}
    for i=0,n-1 do table.insert(t, i) end
    return t
end

local len = function(t)
    if type(t) == "string" then return #t end
    if type(t) == "table" then return #t end
    return 0
end

]], self.version, #string.split(pythonCode, "\n"))

	luauCode = header .. "\n" .. luauCode

	-- Passo 10: Validação básica
	if #luauCode &gt; 200_000 then
		return nil, "Transpiled code too large (&gt;200KB)"
	end

	print("[Arkher Python] Transpiled successfully -", #luauCode, "bytes Luau")

	return luauCode, nil
end

function PythonTranspiler:TranspileWithAI(pythonCode: string, styleProfile: string?): (string?, string?)
	-- Fase 2: Usa IA para transpilação mais inteligente (GPT-4)
	-- Por enquanto chama transpiler simples + marca para backend

	print("[Arkher Python] AI Transpilation requested - Style:", styleProfile or "realistic")

	-- Em produção, chama backend /api/ai/transpile-python
	-- Backend usa GPT-4 fine-tuned para Python-&gt;Luau

	return self:Transpile(pythonCode)
end

function PythonTranspiler:ValidatePython(pythonCode: string): (boolean, string?)
	-- Validação básica de sintaxe Python 3.14

	if #pythonCode == 0 then
		return false, "Empty code"
	end

	if #pythonCode &gt; 500_000 then
		return false, "Code too large (&gt;500KB)"
	end

	-- Checa caracteres inválidos, etc
	-- Fase 2: Parser real

	return true, nil
end

function PythonTranspiler:GetSupportedFeatures(): { string }
	return {
		"variables",
		"functions (def)",
		"if/elif/else",
		"for loops",
		"while loops",
		"match/case (Python 3.10+)",
		"f-strings",
		"True/False/None",
		"and/or/not",
		"imports (from arkher)",
		"classes (basic, Fase 2)",
		"async/await (Fase 2 via backend)",
		"type hints (ignored, for docs)",
		"walrus operator := (Fase 2)",
	}
end

-- Exemplo de uso:
-- local transpiler = PythonTranspiler.new()
-- local luauCode, err = transpiler:Transpile(pythonCode)
-- if luauCode then loadstring(luauCode)() end

return PythonTranspiler
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXacba70757ccebc2e">
    <Properties>
      <string name="Name">SandboxVM</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 2 - SandboxVM - VM segura para rodar scripts do usuário
-- Não pode dar game:Shutdown() ou acessar coisas perigosas

local SandboxVM = {}
SandboxVM.__index = SandboxVM

-- Whitelist de funções/globals permitidos
SandboxVM.Whitelist = {
	-- Math
	math = true,
	string = true,
	table = true,
	Vector3 = true,
	Vector2 = true,
	Color3 = true,
	CFrame = true,
	UDim2 = true,
	Enum = true,

	-- Roblox safe
	Instance = true,
	workspace = true,
	game = true, -- mas com metatable protegida

	-- Arkher
	Entity = true,
	Component = true,
	World = true,

	-- Safe globals
	print = true,
	warn = true,
	wait = true,
	task = true,
	tick = true,
	time = true,
	os = true, -- mas só time, date, etc (não execute)

	-- Python compat
	Range = true,
	len = true,
}

-- Blacklist - nunca permitir
SandboxVM.Blacklist = {
	"getfenv",
	"setfenv",
	"loadstring",
	"require", -- só permitir require de módulos Arkher
	"game:Shutdown",
	"game:GetService", -- vamos controlar
	"HttpService",
	"DataStoreService",
	"MarketplaceService",
	"TeleportService",
}

function SandboxVM.new()
	return setmetatable({
		sandboxEnv = {},
		executionCount = 0,
		maxExecutionTime = 5, -- 5 segundos max por script
		maxMemory = 50 * 1024 * 1024, -- 50MB
	}, SandboxVM)
end

function SandboxVM:CreateSandbox(player: Player?): { [string]: any }
	-- Cria ambiente sandbox seguro

	local env: { [string]: any } = {}

	-- Copia whitelist
	env.math = math
	env.string = string
	env.table = table
	env.Vector3 = Vector3
	env.Vector2 = Vector2
	env.Color3 = Color3
	env.CFrame = CFrame
	env.UDim2 = UDim2
	env.Enum = Enum
	env.print = function(...)
		print("[Sandbox]", ...)
	end
	env.warn = function(...)
		warn("[Sandbox]", ...)
	end
	env.wait = task.wait
	env.task = task
	env.tick = tick
	env.time = time
	env.os = {
		time = os.time,
		date = os.date,
		clock = os.clock,
		difftime = os.difftime,
	}

	-- Game protegido
	env.game = setmetatable({}, {
		__index = function(_, key)
			if key == "Players" then
				return game:GetService("Players")
			elseif key == "Workspace" then
				return workspace
			elseif key == "ReplicatedStorage" then
				return game:GetService("ReplicatedStorage")
			elseif key == "RunService" then
				return game:GetService("RunService")
			else
				warn("[Sandbox] Blocked access to game." .. tostring(key))
				return nil
			end
		end,
		__newindex = function()
			warn("[Sandbox] Cannot modify game")
		end,
	})

	env.workspace = workspace
	env.Instance = Instance

	-- Arkher API
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	pcall(function()
		env.Entity = require(ReplicatedStorage.Arkher.ECS.Entity)
		env.Component = require(ReplicatedStorage.Arkher.ECS.Component)
		env.World = require(ReplicatedStorage.Arkher.ECS.World)
	end)

	-- Python compat
	env.Range = function(n)
		local t = {}
		for i=0,n-1 do table.insert(t, i) end
		return t
	end

	env.len = function(t)
		if type(t) == "string" then return #t end
		if type(t) == "table" then return #t end
		return 0
	end

	-- Player se tiver
	if player then
		env.player = player
		env.LocalPlayer = player
	end

	-- Metatable que bloqueia acesso a globals não whitelistados
	setmetatable(env, {
		__index = function(_, key)
			if SandboxVM.Whitelist[key] then
				return _G[key]
			else
				warn("[Sandbox] Blocked access to global:", key)
				return nil
			end
		end,
	})

	self.sandboxEnv = env
	return env
end

function SandboxVM:CheckBlacklist(code: string): (boolean, string?)
	-- Verifica se código contém blacklist

	for _, blocked in SandboxVM.Blacklist do
		if string.find(code, blocked, 1, true) then
			-- Exceção: permite game:GetService se for Players, Workspace, etc (já filtrado no metatable)
			if blocked == "game:GetService" then
				-- Deixa passar, metatable vai filtrar
			else
				return false, "Blocked keyword found: " .. blocked
			end
		end
	end

	-- Verifica loadstring, require suspeito
	if string.find(code, "require%(%d+%)") then
		return false, "Blocked: require with asset ID (possible virus)"
	end

	if string.find(code, "getfenv") or string.find(code, "setfenv") then
		return false, "Blocked: getfenv/setfenv not allowed"
	end

	return true, nil
end

function SandboxVM:Execute(code: string, player: Player?, timeout: number?): (boolean, any)
	-- Executa código em sandbox com timeout

	timeout = timeout or self.maxExecutionTime

	-- Checa blacklist
	local allowed, reason = self:CheckBlacklist(code)
	if not allowed then
		warn("[Sandbox] Blocked execution:", reason)
		return false, reason
	end

	-- Cria sandbox
	local env = self:CreateSandbox(player)

	-- Compila
	local func, loadErr = loadstring(code)
	if not func then
		warn("[Sandbox] Load error:", loadErr)
		return false, "Load error: " .. tostring(loadErr)
	end

	setfenv(func, env)

	-- Executa com timeout
	self.executionCount += 1

	local completed = false
	local success, result

	task.spawn(function()
		success, result = pcall(func)
		completed = true
	end)

	-- Espera com timeout
	local start = os.clock()
	while not completed and os.clock() - start &lt; timeout do
		task.wait(0.1)
	end

	if not completed then
		warn("[Sandbox] Execution timeout after", timeout, "seconds")
		return false, "Execution timeout"
	end

	if not success then
		warn("[Sandbox] Runtime error:", result)
		return false, "Runtime error: " .. tostring(result)
	end

	print("[Sandbox] Executed successfully -", #code, "bytes - Player:", player and player.Name or "server")

	return true, result
end

function SandboxVM:ExecuteWithResult(code: string, player: Player?): { success: boolean, result: any?, error: string?, logs: { string } }
	local logs: { string } = {}

	-- Captura prints
	local oldPrint = print
	local capturedEnv = self:CreateSandbox(player)
	capturedEnv.print = function(...)
		local msg = table.concat({...}, " ")
		table.insert(logs, msg)
		oldPrint("[Sandbox]", msg)
	end

	local func, loadErr = loadstring(code)
	if not func then
		return { success = false, error = "Load error: " .. tostring(loadErr), logs = logs }
	end

	setfenv(func, capturedEnv)

	local success, result = pcall(func)

	if not success then
		return { success = false, error = tostring(result), logs = logs }
	end

	return { success = true, result = result, logs = logs }
end

function SandboxVM:GetStats(): { [string]: any }
	return {
		executionCount = self.executionCount,
		maxExecutionTime = self.maxExecutionTime,
		maxMemoryMB = self.maxMemory / 1024 / 1024,
		whitelistCount = 0, -- conta
		blacklistCount = #SandboxVM.Blacklist,
	}
end

return SandboxVM
</ProtectedString>
    </Properties>
