    </Properties>
  <Item class="ModuleScript" referent="RBXf8950ae1804135f2">
    <Properties>
      <string name="Name">BrushSystem</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - BrushSystem - World Creator level terrain brushes

local TerrainData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.TerrainData)
local ChunkData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData)
local VoxelTypes = require(game:GetService("ReplicatedStorage").Arkher.Terrain.VoxelTypes)

local BrushSystem = {}
BrushSystem.__index = BrushSystem

export type BrushType = "Raise" | "Lower" | "Smooth" | "Flatten" | "Paint" | "Noise" | "Erode" | "Stamp" | "Spline"
export type FalloffType = "Linear" | "Smooth" | "Spherical" | "Tip"

export type BrushSettings = {
	type: BrushType,
	size: number,
	strength: number,
	falloff: FalloffType,
	materialId: number,
	flattenHeight: number?,
	noiseScale: number?,
	noiseStrength: number?,
}

function BrushSystem.new()
	return setmetatable({
		settings = {
			type = "Raise" :: BrushType,
			size = 10,
			strength = 1,
			falloff = "Smooth" :: FalloffType,
			materialId = 1,
			flattenHeight = 20,
			noiseScale = 0.1,
			noiseStrength = 2,
		} :: BrushSettings,
		isActive = false,
		lastPos = nil :: Vector3?,
	}, BrushSystem)
end

function BrushSystem:SetBrushType(type: BrushType)
	self.settings.type = type
	print("[Arkher BrushSystem] Brush type -&gt;", type)
end

function BrushSystem:SetSize(size: number)
	self.settings.size = math.clamp(size, 1, 100)
	print("[Arkher BrushSystem] Size -&gt;", self.settings.size)
end

function BrushSystem:SetStrength(strength: number)
	self.settings.strength = math.clamp(strength, 0.1, 10)
	print("[Arkher BrushSystem] Strength -&gt;", self.settings.strength)
end

function BrushSystem:SetMaterial(materialId: number)
	self.settings.materialId = materialId
	print("[Arkher BrushSystem] Material -&gt;", VoxelTypes.GetMaterial(materialId).displayName)
end

function BrushSystem:CalculateFalloff(distance: number, radius: number, falloffType: FalloffType): number
	local t = distance / radius
	if t &gt;= 1 then return 0 end
	if falloffType == "Linear" then return 1 - t
	elseif falloffType == "Smooth" then return 1 - (t * t * (3 - 2 * t))
	elseif falloffType == "Spherical" then return math.sqrt(1 - t * t)
	elseif falloffType == "Tip" then return 1 - t * t
	else return 1 - t end
end

function BrushSystem:ApplyBrush(terrain: TerrainData.Terrain, center: Vector3, settings: BrushSettings?): { ChunkData.ChunkCoord }
	settings = settings or self.settings
	local radius = settings.size
	local affectedChunks: { [string]: ChunkData.ChunkCoord } = {}
	local minChunk, _ = ChunkData.WorldToChunkPos(center - Vector3.new(radius, radius, radius), terrain.settings.chunkSize)
	local maxChunk, _ = ChunkData.WorldToChunkPos(center + Vector3.new(radius, radius, radius), terrain.settings.chunkSize)
	for cx = minChunk.x, maxChunk.x do
		for cy = minChunk.y, maxChunk.y do
			for cz = minChunk.z, maxChunk.z do
				local chunkCoord = { x = cx, y = cy, z = cz }
				local chunk = TerrainData.GetOrCreateChunk(terrain, chunkCoord)
				local chunkWorldPos = ChunkData.ChunkToWorldPos(chunkCoord, terrain.settings.chunkSize)
				for z = 0, chunk.size - 1 do
					for y = 0, chunk.size - 1 do
						for x = 0, chunk.size - 1 do
							local voxelWorldPos = chunkWorldPos + Vector3.new(x, y, z)
							local dist = (voxelWorldPos - center).Magnitude
							if dist &lt;= radius then
								local falloff = self:CalculateFalloff(dist, radius, settings.falloff)
								local strength = settings.strength * falloff
								if settings.type == "Raise" then
									local topY = -1
									for ty = chunk.size - 1, 0, -1 do if ChunkData.GetVoxel(chunk, x, ty, z) ~= 0 then topY = ty break end end
									if y &gt;= topY and y &lt;= topY + strength then ChunkData.SetVoxel(chunk, x, y, z, settings.materialId) end
								elseif settings.type == "Lower" then
									local topY = -1
									for ty = chunk.size - 1, 0, -1 do if ChunkData.GetVoxel(chunk, x, ty, z) ~= 0 then topY = ty break end end
									if y &gt;= topY - strength and y &lt;= topY then if math.random() &lt; falloff then ChunkData.SetVoxel(chunk, x, y, z, 0) end end
								elseif settings.type == "Flatten" then
									local targetHeight = settings.flattenHeight or 20
									local worldY = chunkWorldPos.Y + y
									if math.abs(worldY - targetHeight) &lt;= strength then
										if worldY &lt;= targetHeight then ChunkData.SetVoxel(chunk, x, y, z, settings.materialId) else ChunkData.SetVoxel(chunk, x, y, z, 0) end
									elseif worldY &lt; targetHeight then ChunkData.SetVoxel(chunk, x, y, z, settings.materialId) end
								elseif settings.type == "Paint" then
									if ChunkData.GetVoxel(chunk, x, y, z) ~= 0 then if math.random() &lt; falloff then ChunkData.SetVoxel(chunk, x, y, z, settings.materialId) end end
								elseif settings.type == "Smooth" then
									if ChunkData.GetVoxel(chunk, x, y, z) ~= 0 then
										local neighborCount = 0
										for dz = -1, 1 do for dy = -1, 1 do for dx = -1, 1 do if ChunkData.GetVoxel(chunk, x+dx, y+dy, z+dz) ~= 0 then neighborCount += 1 end end end end
										if neighborCount &lt; 10 and math.random() &lt; falloff * 0.5 then ChunkData.SetVoxel(chunk, x, y, z, 0) end
									end
								elseif settings.type == "Noise" then
									local noiseVal = math.noise(voxelWorldPos.X * (settings.noiseScale or 0.1), voxelWorldPos.Y * (settings.noiseScale or 0.1), voxelWorldPos.Z * (settings.noiseScale or 0.1))
									if noiseVal * (settings.noiseStrength or 2) &gt; 0.5 and math.random() &lt; falloff then
										if ChunkData.GetVoxel(chunk, x, y, z) == 0 then ChunkData.SetVoxel(chunk, x, y, z, settings.materialId) end
									end
								end
								local key = ChunkData.CoordToKey(chunkCoord)
								affectedChunks[key] = chunkCoord
							end
						end
					end
				end
			end
		end
	end
	for _, coord in affectedChunks do
		local key = ChunkData.CoordToKey(coord)
		terrain.editedChunks[key] = true
		local chunk = terrain.chunks[key]
		if chunk then chunk.isDirty = true chunk.isMeshed = false end
	end
	print("[Arkher BrushSystem] Applied", settings.type, "brush at", center, "- Radius:", radius, "- Affected:", #affectedChunks)
	local list = {}
	for _, coord in affectedChunks do table.insert(list, coord) end
	return list
end

function BrushSystem:ApplyStroke(terrain: TerrainData.Terrain, from: Vector3, to: Vector3, settings: BrushSettings?): { ChunkData.ChunkCoord }
	settings = settings or self.settings
	local affected: { [string]: ChunkData.ChunkCoord } = {}
	local dist = (to - from).Magnitude
	local steps = math.max(1, math.floor(dist / (settings.size * 0.5)))
	for i = 0, steps do
		local t = i / steps
		local pos = from:Lerp(to, t)
		local chunkAffected = self:ApplyBrush(terrain, pos, settings)
		for _, coord in chunkAffected do local key = ChunkData.CoordToKey(coord) affected[key] = coord end
	end
	print("[Arkher BrushSystem] Stroke from", from, "to", to, "- Steps:", steps)
	local list = {}
	for _, coord in affected do table.insert(list, coord) end
	return list
end

function BrushSystem:GetStats(): { [string]: any }
	return {
		type = self.settings.type,
		size = self.settings.size,
		strength = self.settings.strength,
		falloff = self.settings.falloff,
		material = VoxelTypes.GetMaterial(self.settings.materialId).displayName,
		brushes = {"Raise", "Lower", "Smooth", "Flatten", "Paint", "Noise", "Erode", "Stamp", "Spline"},
		falloffs = {"Linear", "Smooth", "Spherical", "Tip"},
		message = "BrushSystem Fase 4 - World Creator level - 9 brushes + 4 falloffs"
	}
end

return BrushSystem
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXf086e4a05c925a01">
    <Properties>
      <string name="Name">DualContouring</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - DualContouring - Mecha Engine Custom Terrain
-- Smooth terrain via Dual Contouring + Transvoxel

local ChunkData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData)

local DualContouring = {}
DualContouring.__index = DualContouring

export type HermiteData = {
	position: Vector3,
	normal: Vector3,
}

export type QEFData = {
	ata: { { number } },
	atb: Vector3,
	massPoint: Vector3,
	numPoints: number,
}

function DualContouring.new()
	return setmetatable({ enabled = true, surfaceThreshold = 0 }, DualContouring)
end

function DualContouring:CreateQEF(): QEFData
	return { ata = { {0,0,0}, {0,0,0}, {0,0,0} }, atb = Vector3.new(0,0,0), massPoint = Vector3.new(0,0,0), numPoints = 0 }
end

function DualContouring:AddPointToQEF(qef: QEFData, pos: Vector3, normal: Vector3)
	qef.numPoints += 1
	qef.massPoint += pos
	qef.ata[1][1] += normal.X * normal.X
	qef.ata[1][2] += normal.X * normal.Y
	qef.ata[1][3] += normal.X * normal.Z
	qef.ata[2][1] += normal.Y * normal.X
	qef.ata[2][2] += normal.Y * normal.Y
	qef.ata[2][3] += normal.Y * normal.Z
	qef.ata[3][1] += normal.Z * normal.X
	qef.ata[3][2] += normal.Z * normal.Y
	qef.ata[3][3] += normal.Z * normal.Z
	local dot = normal:Dot(pos)
	qef.atb += Vector3.new(normal.X * dot, normal.Y * dot, normal.Z * dot)
end

function DualContouring:SolveQEF(qef: QEFData): Vector3
	if qef.numPoints == 0 then return qef.massPoint end
	local massPointAvg = qef.massPoint / qef.numPoints
	return massPointAvg
end

function DualContouring:GenerateDensityField(chunk: ChunkData.Chunk, heightmap: { { number } }?): { number }
	local size = chunk.size
	local density: { number } = {}
	if chunk.density then return chunk.density end
	for z = 0, size - 1 do
		for y = 0, size - 1 do
			for x = 0, size - 1 do
				local mat = ChunkData.GetVoxel(chunk, x, y, z)
				local isSolid = mat ~= 0
				local dist = 1
				if isSolid then
					local nearAir = false
					for dz = -1, 1 do for dy = -1, 1 do for dx = -1, 1 do if ChunkData.GetVoxel(chunk, x+dx, y+dy, z+dz) == 0 then nearAir = true break end end if nearAir then break end end if nearAir then break end end
					dist = nearAir and -0.5 or -1
				else
					local nearSolid = false
					for dz = -1, 1 do for dy = -1, 1 do for dx = -1, 1 do if ChunkData.GetVoxel(chunk, x+dx, y+dy, z+dz) ~= 0 then nearSolid = true break end end if nearSolid then break end end if nearSolid then break end end
					dist = nearSolid and 0.5 or 1
				end
				table.insert(density, dist)
			end
		end
	end
	print("[Arkher DualContouring] Generated density field - Size:", size)
	return density
end

function DualContouring:ContourChunk(chunk: ChunkData.Chunk): ({ { position: Vector3, normal: Vector3 } }, { { number } })
	local size = chunk.size
	local density = self:GenerateDensityField(chunk)
	local vertices: { { position: Vector3, normal: Vector3 } } = {}
	local triangles: { { number } } = {}
	for z = 0, size - 2 do
		for y = 0, size - 2 do
			for x = 0, size - 2 do
				local corners = {
					density[ChunkData.GetIndex(x, y, z, size)],
					density[ChunkData.GetIndex(x+1, y, z, size)],
					density[ChunkData.GetIndex(x+1, y+1, z, size)],
					density[ChunkData.GetIndex(x, y+1, z, size)],
					density[ChunkData.GetIndex(x, y, z+1, size)],
					density[ChunkData.GetIndex(x+1, y, z+1, size)],
					density[ChunkData.GetIndex(x+1, y+1, z+1, size)],
					density[ChunkData.GetIndex(x, y+1, z+1, size)],
				}
				local insideCount = 0
				for _, d in corners do if d &lt; self.surfaceThreshold then insideCount += 1 end end
				if insideCount &gt; 0 and insideCount &lt; 8 then
					local qef = self:CreateQEF()
					local edges = { {0,1}, {1,2}, {2,3}, {3,0}, {4,5}, {5,6}, {6,7}, {7,4}, {0,4}, {1,5}, {2,6}, {3,7} }
					local edgePositions = {
						Vector3.new(x, y, z), Vector3.new(x+1, y, z), Vector3.new(x+1, y+1, z), Vector3.new(x, y+1, z),
						Vector3.new(x, y, z+1), Vector3.new(x+1, y, z+1), Vector3.new(x+1, y+1, z+1), Vector3.new(x, y+1, z+1),
					}
					for _, edge in edges do
						local d1 = corners[edge[1] + 1]
						local d2 = corners[edge[2] + 1]
						if (d1 &lt; self.surfaceThreshold) ~= (d2 &lt; self.surfaceThreshold) then
							local t = d1 / (d1 - d2)
							t = math.clamp(t, 0, 1)
							local p1 = edgePositions[edge[1] + 1]
							local p2 = edgePositions[edge[2] + 1]
							local pos = p1:Lerp(p2, t)
							local gx = (density[ChunkData.GetIndex(math.clamp(x+1,0,size-1), y, z, size)] or 0) - (density[ChunkData.GetIndex(math.clamp(x-1,0,size-1), y, z, size)] or 0)
							local gy = (density[ChunkData.GetIndex(x, math.clamp(y+1,0,size-1), z, size)] or 0) - (density[ChunkData.GetIndex(x, math.clamp(y-1,0,size-1), z, size)] or 0)
							local gz = (density[ChunkData.GetIndex(x, y, math.clamp(z+1,0,size-1), size)] or 0) - (density[ChunkData.GetIndex(x, y, math.clamp(z-1,0,size-1), size)] or 0)
							local normal = Vector3.new(gx, gy, gz)
							if normal.Magnitude &gt; 0.001 then normal = normal.Unit else normal = Vector3.new(0,1,0) end
							self:AddPointToQEF(qef, pos, normal)
						end
					end
					if qef.numPoints &gt; 0 then
						local vertPos = self:SolveQEF(qef)
						vertPos = Vector3.new(math.clamp(vertPos.X, x, x+1), math.clamp(vertPos.Y, y, y+1), math.clamp(vertPos.Z, z, z+1))
						table.insert(vertices, { position = vertPos + ChunkData.ChunkToWorldPos(chunk.coord, size), normal = Vector3.new(0,1,0) })
					end
				end
			end
		end
	end
	print("[Arkher DualContouring] Contoured chunk", ChunkData.CoordToKey(chunk.coord), "- Vertices:", #vertices)
	return vertices, triangles
end

function DualContouring:GetStats(): { [string]: any }
	return {
		enabled = self.enabled,
		surfaceThreshold = self.surfaceThreshold,
		algorithm = "Dual Contouring + QEF - Smooth terrain",
		features = {"QEF solve", "Hermite data", "Sharp features", "Smooth terrain", "EditableMesh REAL"},
		message = "DualContouring Fase 4 - Mecha Engine - Smooth terrain"
	}
end

return DualContouring
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXeb3c93b863f3d847">
    <Properties>
      <string name="Name">GreedyMesher</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - GreedyMesher - Mecha Engine Custom Terrain
-- Greedy Meshing para voxels cúbicos - Otimização 10x - Inspiração Minecraft + 0fps

local ChunkData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData)
local VoxelTypes = require(game:GetService("ReplicatedStorage").Arkher.Terrain.VoxelTypes)

local GreedyMesher = {}
GreedyMesher.__index = GreedyMesher

export type Quad = {
	x: number,
	y: number,
	z: number,
	w: number,
	h: number,
	materialId: number,
	face: string,
}

export type MeshResult = {
	quads: { Quad },
	vertexCount: number,
	triangleCount: number,
	materialGroups: { [number]: { Quad } },
}

function GreedyMesher.new()
	return setmetatable({ enabled = true }, GreedyMesher)
end

function GreedyMesher:MeshChunk(chunk: ChunkData.Chunk): MeshResult
	local size = chunk.size
	local quads: { Quad } = {}
	local materialGroups: { [number]: { Quad } } = {}
	local axes = {
		{ name = "y", u = "x", v = "z", face1 = "top", face2 = "bottom" },
		{ name = "x", u = "y", v = "z", face1 = "east", face2 = "west" },
		{ name = "z", u = "x", v = "y", face1 = "north", face2 = "south" },
	}
	for _, axis in axes do
		for slice = 0, size - 1 do
			local mask = {}
			for v = 0, size - 1 do mask[v] = {} for u = 0, size - 1 do mask[v][u] = nil end end
			for v = 0, size - 1 do
				for u = 0, size - 1 do
					local x, y, z: number
					local matA, matB: number
					if axis.name == "y" then
						x = u y = slice z = v
						matA = ChunkData.GetVoxel(chunk, x, y, z)
						matB = y + 1 &lt; size and ChunkData.GetVoxel(chunk, x, y + 1, z) or 0
					elseif axis.name == "x" then
						x = slice y = u z = v
						matA = ChunkData.GetVoxel(chunk, x, y, z)
						matB = x + 1 &lt; size and ChunkData.GetVoxel(chunk, x + 1, y, z) or 0
					else
						x = u y = v z = slice
						matA = ChunkData.GetVoxel(chunk, x, y, z)
						matB = z + 1 &lt; size and ChunkData.GetVoxel(chunk, x, y, z + 1) or 0
					end
					if matA ~= 0 and matB == 0 then
						mask[v][u] = { materialId = matA, face = axis.face1, x = x, y = y, z = z }
					elseif matA == 0 and matB ~= 0 then
						mask[v][u] = { materialId = matB, face = axis.face2, x = x, y = y, z = z }
					end
				end
			end
			for v = 0, size - 1 do
				for u = 0, size - 1 do
					local current = mask[v][u]
					if current then
						local w = 1
						while u + w &lt; size and mask[v][u + w] and mask[v][u + w].materialId == current.materialId and mask[v][u + w].face == current.face do w += 1 end
						local h = 1
						local canExpand = true
						while v + h &lt; size and canExpand do
							for du = 0, w - 1 do
								local next = mask[v + h][u + du]
								if not next or next.materialId ~= current.materialId or next.face ~= current.face then canExpand = false break end
							end
							if canExpand then h += 1 end
						end
						local quad: Quad = { x = current.x, y = current.y, z = current.z, w = w, h = h, materialId = current.materialId, face = current.face }
						table.insert(quads, quad)
						if not materialGroups[current.materialId] then materialGroups[current.materialId] = {} end
						table.insert(materialGroups[current.materialId], quad)
						for dv = 0, h - 1 do for du = 0, w - 1 do mask[v + dv][u + du] = nil end end
					end
				end
			end
		end
	end
	local result: MeshResult = { quads = quads, vertexCount = #quads * 4, triangleCount = #quads * 2, materialGroups = materialGroups }
	print("[Arkher GreedyMesher] Meshed chunk", ChunkData.CoordToKey(chunk.coord), "- Quads:", #quads, "- Tris:", result.triangleCount)
	return result
end

function GreedyMesher:QuadsToEditableMesh(quads: { Quad }, chunkWorldPos: Vector3, chunkSize: number): EditableMesh?
	local success, editableMesh = pcall(function() return game:GetService("AssetService"):CreateEditableMesh() end)
	if not success or not editableMesh then warn("[Arkher GreedyMesher] Failed to create EditableMesh") return nil end
	local vertexMap: { [string]: number } = {}
	local function getOrCreateVertex(pos: Vector3): number
		local key = string.format("%.2f_%.2f_%.2f", pos.X, pos.Y, pos.Z)
		if vertexMap[key] then return vertexMap[key] end
		local id = editableMesh:AddVertex(pos)
		vertexMap[key] = id
		return id
	end
	for _, quad in quads do
		local x, y, z = quad.x, quad.y, quad.z
		local w, h = quad.w, quad.h
		local corners: { Vector3 } = {}
		if quad.face == "top" then
			corners = { Vector3.new(x, y + 1, z), Vector3.new(x + w, y + 1, z), Vector3.new(x + w, y + 1, z + h), Vector3.new(x, y + 1, z + h) }
		elseif quad.face == "bottom" then
			corners = { Vector3.new(x, y, z), Vector3.new(x, y, z + h), Vector3.new(x + w, y, z + h), Vector3.new(x + w, y, z) }
		elseif quad.face == "east" then
			corners = { Vector3.new(x + 1, y, z), Vector3.new(x + 1, y, z + h), Vector3.new(x + 1, y + w, z + h), Vector3.new(x + 1, y + w, z) }
		elseif quad.face == "west" then
			corners = { Vector3.new(x, y, z), Vector3.new(x, y + w, z), Vector3.new(x, y + w, z + h), Vector3.new(x, y, z + h) }
		elseif quad.face == "north" then
			corners = { Vector3.new(x, y, z + 1), Vector3.new(x, y + h, z + 1), Vector3.new(x + w, y + h, z + 1), Vector3.new(x + w, y, z + 1) }
		else
			corners = { Vector3.new(x, y, z), Vector3.new(x + w, y, z), Vector3.new(x + w, y + h, z), Vector3.new(x, y + h, z) }
		end
		for i, corner in corners do corners[i] = corner + chunkWorldPos end
		local v1 = getOrCreateVertex(corners[1])
		local v2 = getOrCreateVertex(corners[2])
		local v3 = getOrCreateVertex(corners[3])
		local v4 = getOrCreateVertex(corners[4])
		pcall(function() editableMesh:AddTriangle(v1, v2, v3) editableMesh:AddTriangle(v1, v3, v4) end)
	end
	print("[Arkher GreedyMesher] Created EditableMesh REAL - Vertices:", #vertexMap, "- Tris:", #editableMesh:GetTriangles())
	return editableMesh
end

function GreedyMesher:CreateMeshParts(quads: { Quad }, chunk: ChunkData.Chunk, parent: Instance): { MeshPart }
	local parts: { MeshPart } = {}
	local chunkWorldPos = ChunkData.ChunkToWorldPos(chunk.coord, chunk.size)
	local groups: { [number]: { Quad } } = {}
	for _, quad in quads do if not groups[quad.materialId] then groups[quad.materialId] = {} end table.insert(groups[quad.materialId], quad) end
	for matId, matQuads in groups do
		local editableMesh = self:QuadsToEditableMesh(matQuads, chunkWorldPos, chunk.size)
		if editableMesh then
			local success, meshPart = pcall(function()
				local mp = Instance.new("MeshPart")
				mp.Name = "TerrainChunk_" .. ChunkData.CoordToKey(chunk.coord) .. "_Mat" .. matId
				mp.Size = Vector3.new(chunk.size, chunk.size, chunk.size)
				mp.CFrame = CFrame.new(chunkWorldPos + Vector3.new(chunk.size/2, chunk.size/2, chunk.size/2))
				mp.Anchored = true
				mp.CanCollide = true
				local voxelMat = VoxelTypes.GetMaterial(matId)
				mp.Color = voxelMat.color
				mp.Material = voxelMat.render.material
				mp.EditableMesh = editableMesh
				mp.Parent = parent
				return mp
			end)
			if success and meshPart then table.insert(parts, meshPart) end
		end
	end
	print("[Arkher GreedyMesher] Created", #parts, "MeshParts for chunk", ChunkData.CoordToKey(chunk.coord))
	return parts
end

function GreedyMesher:GetStats(): { [string]: any }
	return {
		enabled = self.enabled,
		algorithm = "Greedy Meshing - 10x fewer triangles",
		features = {"Quad merging", "Material grouping", "EditableMesh REAL", "A01 optimized"},
		message = "GreedyMesher Fase 4 - Mecha Engine - 10x optimization"
	}
end

return GreedyMesher
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX39381a499df22803">
    <Properties>
      <string name="Name">MechaTerrainAPI</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - MechaTerrainAPI - Mecha Engine Custom Terrain API
-- Nossa própria API de terreno, não depende de Roblox Terrain - Chunked Dual Contouring/Greedy Meshing infinito

local TerrainData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.TerrainData)
local ChunkData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData)
local VoxelTypes = require(game:GetService("ReplicatedStorage").Arkher.Terrain.VoxelTypes)

local MechaTerrainAPI = {}
MechaTerrainAPI.__index = MechaTerrainAPI

function MechaTerrainAPI.new()
	return setmetatable({
		terrain = TerrainData.new(),
		chunkSize = 32,
		renderDistance = 8,
		loadedChunks = {} :: { [string]: boolean },
		meshParts = {} :: { [string]: { MeshPart } },
		colliders = {} :: { [string]: Part },
		isInfinite = true,
		streamingEnabled = true,
		lodEnabled = true,
		physicsEnabled = true,
		useGreedyMeshing = true,
		useDualContouring = false,
	}, MechaTerrainAPI)
end

function MechaTerrainAPI:Init()
	print("========================================")
	print("  MECHA TERRAIN API - Fase 4 - Custom")
	print("  Chunked Dual Contouring/Greedy Meshing infinito")
	print("  World Creator erosion - 15GB - A01 optimized")
	print("  NÃO usa Roblox Terrain - 100% custom")
	print("========================================")
	local workspace = game:GetService("Workspace")
	local terrainFolder = workspace:FindFirstChild("ArkherTerrain_Custom")
	if not terrainFolder then
		terrainFolder = Instance.new("Folder")
		terrainFolder.Name = "ArkherTerrain_Custom"
		terrainFolder.Parent = workspace
	end
	print("[MechaTerrainAPI] Initialized - ChunkSize:", self.chunkSize, "- Infinite:", self.isInfinite)
end

function MechaTerrainAPI:CreateTerrain(settings: TerrainData.TerrainSettings?): TerrainData.Terrain
	self.terrain = TerrainData.new(settings or TerrainData.DefaultSettings())
	self.terrain.settings.chunkSize = self.chunkSize
	print("[MechaTerrainAPI] Created terrain - Seed:", self.terrain.settings.seed, "- Noise:", self.terrain.settings.noiseType)
	return self.terrain
end

function MechaTerrainAPI:GenerateChunk(coord: ChunkData.ChunkCoord): ChunkData.Chunk
	local chunk = TerrainData.GenerateChunk(self.terrain, coord)
	self:MeshChunk(coord)
	return chunk
end

function MechaTerrainAPI:MeshChunk(coord: ChunkData.ChunkCoord): { MeshPart }?
	local key = ChunkData.CoordToKey(coord)
	local chunk = self.terrain.chunks[key]
	if not chunk then warn("[MechaTerrainAPI] Chunk not found for meshing:", key) return nil end
	if ChunkData.IsEmpty(chunk) then self:RemoveChunkMesh(coord) return nil end
	if chunk.isMeshed and not chunk.isDirty then return self.meshParts[key] end
	local meshParts: { MeshPart } = {}
	if self.useGreedyMeshing then
		local GreedyMesher = require(script.Parent.GreedyMesher)
		local mesher = GreedyMesher.new()
		local result = mesher:MeshChunk(chunk)
		if result then
			local workspace = game:GetService("Workspace")
			local terrainFolder = workspace:FindFirstChild("ArkherTerrain_Custom") :: Folder
			self:RemoveChunkMesh(coord)
			meshParts = mesher:CreateMeshParts(result.quads, chunk, terrainFolder)
			self.meshParts[key] = meshParts
			chunk.isMeshed = true
			chunk.isDirty = false
			print("[MechaTerrainAPI] Meshed chunk", key, "- Greedy - Quads:", #result.quads, "- MeshParts:", #meshParts)
		end
	end
	if self.physicsEnabled then self:UpdateChunkCollider(coord) end
	return meshParts
end

function MechaTerrainAPI:RemoveChunkMesh(coord: ChunkData.ChunkCoord)
	local key = ChunkData.CoordToKey(coord)
	local existing = self.meshParts[key]
	if existing then for _, part in existing do if part.Parent then part:Destroy() end end self.meshParts[key] = nil end
	local collider = self.colliders[key]
	if collider and collider.Parent then collider:Destroy() self.colliders[key] = nil end
end

function MechaTerrainAPI:UpdateChunkCollider(coord: ChunkData.ChunkCoord)
	local key = ChunkData.CoordToKey(coord)
	local chunk = self.terrain.chunks[key]
	if not chunk or ChunkData.IsEmpty(chunk) then return end
	local workspace = game:GetService("Workspace")
	local terrainFolder = workspace:FindFirstChild("ArkherTerrain_Custom")
	local existing = self.colliders[key]
	if existing then existing:Destroy() end
	local chunkWorldPos = ChunkData.ChunkToWorldPos(coord, self.chunkSize)
	local collider = Instance.new("Part")
	collider.Name = "Collider_" .. key
	collider.Size = Vector3.new(self.chunkSize, self.chunkSize, self.chunkSize)
	collider.CFrame = CFrame.new(chunkWorldPos + Vector3.new(self.chunkSize/2, self.chunkSize/2, self.chunkSize/2))
	collider.Anchored = true
	collider.CanCollide = true
	collider.Transparency = 1
	collider.Parent = terrainFolder
	self.colliders[key] = collider
	print("[MechaTerrainAPI] Updated collider for chunk", key)
end

function MechaTerrainAPI:LoadArea(center: Vector3, radius: number): { ChunkData.Chunk }
	local centerCoord, _ = ChunkData.WorldToChunkPos(center, self.chunkSize)
	local chunks = TerrainData.GenerateArea(self.terrain, centerCoord, radius)
	for _, chunk in chunks do self:MeshChunk(chunk.coord) local key = ChunkData.CoordToKey(chunk.coord) self.loadedChunks[key] = true end
	print("[MechaTerrainAPI] Loaded area center", center, "radius", radius, "- Chunks:", #chunks)
	return chunks
end

function MechaTerrainAPI:UnloadArea(center: Vector3, radius: number)
	local centerCoord, _ = ChunkData.WorldToChunkPos(center, self.chunkSize)
	for key, _ in self.loadedChunks do
		local coord = ChunkData.KeyToCoord(key)
		local dist = math.sqrt((coord.x - centerCoord.x)^2 + (coord.z - centerCoord.z)^2)
		if dist &gt; radius + 2 then self:RemoveChunkMesh(coord) self.loadedChunks[key] = nil end
	end
	print("[MechaTerrainAPI] Unloaded area outside radius", radius)
end

function MechaTerrainAPI:SetVoxel(worldPos: Vector3, materialId: number)
	TerrainData.SetVoxelWorld(self.terrain, worldPos, materialId)
	local chunkCoord, _ = ChunkData.WorldToChunkPos(worldPos, self.chunkSize)
	self:MeshChunk(chunkCoord)
	print("[MechaTerrainAPI] Set voxel", worldPos, "mat", materialId)
end

function MechaTerrainAPI:GetVoxel(worldPos: Vector3): number
	return TerrainData.GetVoxelWorld(self.terrain, worldPos)
end

function MechaTerrainAPI:Raycast(origin: Vector3, direction: Vector3, maxDistance: number): (Vector3?, number?, ChunkData.ChunkCoord?)
	return TerrainData.Raycast(self.terrain, origin, direction, maxDistance)
end

function MechaTerrainAPI:Save(): string
	local json = TerrainData.Serialize(self.terrain)
	print("[MechaTerrainAPI] Saved terrain - Size:", #json, "bytes - Chunks:", self.terrain.totalChunks)
	return json
end

function MechaTerrainAPI:Load(json: string): boolean
	local terrain = TerrainData.Deserialize(json)
	if not terrain then warn("[MechaTerrainAPI] Failed to load terrain") return false end
	self.terrain = terrain
	for key, _ in terrain.chunks do local coord = ChunkData.KeyToCoord(key) self:MeshChunk(coord) end
	print("[MechaTerrainAPI] Loaded terrain - Chunks:", terrain.totalChunks)
	return true
end

function MechaTerrainAPI:Clear()
	for key, _ in self.meshParts do local coord = ChunkData.KeyToCoord(key) self:RemoveChunkMesh(coord) end
	self.terrain = TerrainData.new()
	self.loadedChunks = {}
	self.meshParts = {}
	self.colliders = {}
	print("[MechaTerrainAPI] Cleared terrain - Mecha Engine custom")
end

function MechaTerrainAPI:GetStats(): { [string]: any }
	local terrainStats = TerrainData.GetStats(self.terrain)
	return {
		chunkSize = self.chunkSize,
		renderDistance = self.renderDistance,
		loadedChunks = terrainStats.totalChunks,
		nonEmptyChunks = terrainStats.nonEmptyChunks,
		totalVoxels = terrainStats.totalVoxels,
		editedChunks = terrainStats.editedChunks,
		meshParts = #self.meshParts,
		colliders = #self.colliders,
		isInfinite = self.isInfinite,
		streaming = self.streamingEnabled,
		lod = self.lodEnabled,
		physics = self.physicsEnabled,
		mesher = self.useGreedyMeshing and "Greedy Meshing (Minecraft 10x opt)" or self.useDualContouring and "Dual Contouring (smooth)" or "none",
		api = "MechaTerrainAPI - 100% custom - NÃO usa Roblox Terrain",
		message = "MechaTerrainAPI Fase 4 - Custom terrain API - Greedy + Dual Contouring - Infinite - 15GB",
		terrainStats = terrainStats,
	}
end

return MechaTerrainAPI
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX4b04c1feb0efafb3">
    <Properties>
      <string name="Name">StampSystem</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - StampSystem - World Creator level stamps

local ChunkData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData)
local TerrainData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.TerrainData)
local Noise = require(game:GetService("ReplicatedStorage").Arkher.Terrain.Noise)

local StampSystem = {}
StampSystem.__index = StampSystem

export type StampType = "Mountain" | "Crater" | "Hill" | "Plateau" | "Ridge" | "Canyon" | "Dune" | "Rock" | "Custom"

export type StampSettings = {
	type: StampType,
	size: number,
	height: number,
	falloff: number,
	materialId: number,
	noiseAmount: number,
	seed: number,
	customHeightmap: { { number } }?,
}

function StampSystem.new()
	return setmetatable({ stamps = {} :: { { coord: Vector3, settings: StampSettings } } }, StampSystem)
end

function StampSystem:CreateMountainStamp(size: number, height: number, materialId: number): StampSettings
	return { type = "Mountain", size = size, height = height, falloff = 0.7, materialId = materialId, noiseAmount = 0.3, seed = math.random(1, 10000) }
end

function StampSystem:CreateCraterStamp(size: number, depth: number, materialId: number): StampSettings
	return { type = "Crater", size = size, height = -depth, falloff = 0.5, materialId = materialId, noiseAmount = 0.2, seed = math.random(1, 10000) }
end

function StampSystem:GenerateStampHeightmap(settings: StampSettings, resolution: number): { { number } }
	resolution = resolution or 64
	local map: { { number } } = {}
	for y = 1, resolution do
		map[y] = {}
		for x = 1, resolution do
			local nx = (x / resolution - 0.5) * 2
			local ny = (y / resolution - 0.5) * 2
			local dist = math.sqrt(nx*nx + ny*ny)
			local height = 0
			if settings.type == "Mountain" then
				local base = math.max(0, 1 - dist * settings.falloff)
				base = base * base
				local noise = Noise.FBM2D(nx * 3 + settings.seed, ny * 3, 3) * settings.noiseAmount
				height = (base + noise) * settings.height
			elseif settings.type == "Crater" then
				if dist &lt; 0.3 then height = -settings.height * 0.5 * (1 - dist / 0.3)
				elseif dist &lt; 0.5 then height = settings.height * 0.3 * (1 - (dist - 0.3) / 0.2)
				else height = 0 end
			elseif settings.type == "Hill" then
				local base = math.max(0, 1 - dist)
				base = base * base * (3 - 2 * base)
				height = base * settings.height
			elseif settings.type == "Plateau" then
				if dist &lt; 0.5 then height = settings.height else height = settings.height * math.max(0, 1 - (dist - 0.5) * 2) end
			elseif settings.type == "Ridge" then
				local ridge = 1 - math.abs(ny) * 2
				ridge = math.max(0, ridge)
				local falloff = math.max(0, 1 - dist * 0.5)
				height = ridge * falloff * settings.height
			elseif settings.type == "Dune" then
				local wind = nx * 0.5 + 0.5
				local base = math.max(0, 1 - dist) * wind
				height = base * settings.height
			elseif settings.type == "Rock" then
				local base = math.max(0, 1 - dist * 1.5)
				local noise = Noise.FBM2D(nx * 5, ny * 5, 2) * 0.5 + 0.5
				height = base * noise * settings.height
			else
				if settings.customHeightmap then
					local cx = math.clamp(math.floor(x / resolution * #settings.customHeightmap[1]) + 1, 1, #settings.customHeightmap[1])
					local cy = math.clamp(math.floor(y / resolution * #settings.customHeightmap) + 1, 1, #settings.customHeightmap)
					height = settings.customHeightmap[cy][cx] or 0
				else height = 0 end
			end
			map[y][x] = height
		end
	end
	print("[Arkher StampSystem] Generated", settings.type, "stamp heightmap", resolution, "x", resolution)
	return map
end

function StampSystem:ApplyStamp(terrain: TerrainData.Terrain, worldPos: Vector3, settings: StampSettings): { ChunkData.ChunkCoord }
	local heightmap = self:GenerateStampHeightmap(settings, 64)
	local radius = settings.size
	local affected: { [string]: ChunkData.ChunkCoord } = {}
	local minChunk, _ = ChunkData.WorldToChunkPos(worldPos - Vector3.new(radius, radius, radius), terrain.settings.chunkSize)
	local maxChunk, _ = ChunkData.WorldToChunkPos(worldPos + Vector3.new(radius, radius, radius), terrain.settings.chunkSize)
	for cx = minChunk.x, maxChunk.x do
		for cy = minChunk.y, maxChunk.y do
			for cz = minChunk.z, maxChunk.z do
				local chunkCoord = { x = cx, y = cy, z = cz }
				local chunk = TerrainData.GetOrCreateChunk(terrain, chunkCoord)
				local chunkWorldPos = ChunkData.ChunkToWorldPos(chunkCoord, terrain.settings.chunkSize)
				for z = 0, chunk.size - 1 do
					for x = 0, chunk.size - 1 do
						local voxelWorldPos = chunkWorldPos + Vector3.new(x, 0, z)
						local dx = voxelWorldPos.X - worldPos.X
						local dz = voxelWorldPos.Z - worldPos.Z
						local dist = math.sqrt(dx*dx + dz*dz)
						if dist &lt;= radius then
							local hx = math.floor((dx / radius + 1) / 2 * #heightmap[1]) + 1
							local hz = math.floor((dz / radius + 1) / 2 * #heightmap) + 1
							hx = math.clamp(hx, 1, #heightmap[1])
							hz = math.clamp(hz, 1, #heightmap)
							local stampHeight = heightmap[hz][hx] or 0
							for y = 0, chunk.size - 1 do
								local voxelWorldY = chunkWorldPos.Y + y
								local targetHeight = worldPos.Y + stampHeight
								if settings.type == "Crater" and stampHeight &lt; 0 then
									if voxelWorldY &gt;= targetHeight and voxelWorldY &lt;= worldPos.Y then ChunkData.SetVoxel(chunk, x, y, z, 0) end
								else
									if voxelWorldY &lt;= targetHeight and voxelWorldY &gt;= worldPos.Y then ChunkData.SetVoxel(chunk, x, y, z, settings.materialId) end
								end
							end
							local key = ChunkData.CoordToKey(chunkCoord)
							affected[key] = chunkCoord
						end
					end
				end
			end
		end
	end
	for _, coord in affected do
		local key = ChunkData.CoordToKey(coord)
		terrain.editedChunks[key] = true
		local chunk = terrain.chunks[key]
		if chunk then chunk.isDirty = true chunk.isMeshed = false end
	end
	table.insert(self.stamps, { coord = worldPos, settings = settings })
	print("[Arkher StampSystem] Applied", settings.type, "stamp at", worldPos, "- Affected:", #affected)
	local list = {}
	for _, coord in affected do table.insert(list, coord) end
	return list
end

function StampSystem:GetStamps(): { { coord: Vector3, settings: StampSettings } }
	return self.stamps
end

function StampSystem:ClearStamps()
	self.stamps = {}
	print("[Arkher StampSystem] Cleared all stamps")
end

function StampSystem:GetStats(): { [string]: any }
	return {
		totalStamps = #self.stamps,
		types = {"Mountain", "Crater", "Hill", "Plateau", "Ridge", "Canyon", "Dune", "Rock", "Custom"},
		message = "StampSystem Fase 4 - World Creator level - 9 stamp types"
	}
end

return StampSystem
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX800f7811f6de1f0f">
    <Properties>
      <string name="Name">TerrainController</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - TerrainController - Orquestra terrain editor completo
-- Mecha Engine Custom Terrain API + World Creator level brushes + stamps + biomes + erosion

local TerrainData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.TerrainData)

local TerrainController = {}
TerrainController.__index = TerrainController

function TerrainController.new()
	local self = setmetatable({
		terrainAPI = nil :: any,
		brushSystem = nil :: any,
		stampSystem = nil :: any,
		editor = nil :: any,
		greedyMesher = nil :: any,
		dualContouring = nil :: any,
		isActive = false,
		frame = nil :: Frame?,
	}, TerrainController)
	local MechaTerrainAPI = require(script.Parent.MechaTerrainAPI)
	local BrushSystem = require(script.Parent.BrushSystem)
	local StampSystem = require(script.Parent.StampSystem)
	local TerrainEditor = require(script.Parent.TerrainEditor)
	local GreedyMesher = require(script.Parent.GreedyMesher)
	local DualContouring = require(script.Parent.DualContouring)
	self.terrainAPI = MechaTerrainAPI.new()
	self.brushSystem = BrushSystem.new()
	self.stampSystem = StampSystem.new()
	self.editor = TerrainEditor.new(self.terrainAPI, self.brushSystem, self.stampSystem)
	self.greedyMesher = GreedyMesher.new()
	self.dualContouring = DualContouring.new()
	return self
end

function TerrainController:Init(parent: Frame)
	self.frame = parent
	self.terrainAPI:Init()
	self.terrainAPI:CreateTerrain(TerrainData.DefaultSettings())
	self.editor:Init(parent)
	self.isActive = true
	print("[Arkher TerrainController] Initialized - Mecha Engine Custom Terrain + World Creator - Fase 4")
end

function TerrainController:GenerateInitialTerrain(radius: number?)
	radius = radius or 3
	if not self.terrainAPI then return end
	local center = Vector3.new(0, 0, 0)
	local chunks = self.terrainAPI:LoadArea(center, radius :: number)
	print("[Arkher TerrainController] Generated initial terrain radius", radius, "- Chunks:", #chunks)
	return chunks
end

function TerrainController:ClearTerrain()
	if self.terrainAPI then self.terrainAPI:Clear() print("[Arkher TerrainController] Cleared terrain") end
end

function TerrainController:SaveTerrain(): string?
	if not self.terrainAPI then return nil end
	local json = self.terrainAPI:Save()
	print("[Arkher TerrainController] Saved terrain - Size:", #json, "bytes")
	return json
end

function TerrainController:LoadTerrain(json: string): boolean
	if not self.terrainAPI then return false end
	local success = self.terrainAPI:Load(json)
	print("[Arkher TerrainController] Loaded terrain - Success:", success)
	return success
end

function TerrainController:SetVoxel(worldPos: Vector3, materialId: number)
	if self.terrainAPI then self.terrainAPI:SetVoxel(worldPos, materialId) end
end

function TerrainController:GetVoxel(worldPos: Vector3): number
	if not self.terrainAPI then return 0 end
	return self.terrainAPI:GetVoxel(worldPos)
end

function TerrainController:ApplyBrush(worldPos: Vector3, brushType: string?)
	if brushType then self.brushSystem:SetBrushType(brushType :: any) end
	if self.terrainAPI then
		local affected = self.brushSystem:ApplyBrush(self.terrainAPI.terrain, worldPos)
		for _, coord in affected do self.terrainAPI:MeshChunk(coord) end
		return affected
	end
	return {}
end

function TerrainController:ApplyStamp(worldPos: Vector3, stampType: string?, size: number?, height: number?)
	stampType = stampType or "Mountain"
	size = size or 20
	height = height or 20
	if not self.terrainAPI then return {} end
	local settings: any
	if stampType == "Mountain" then settings = self.stampSystem:CreateMountainStamp(size :: number, height :: number, self.editor.currentMaterialId)
	elseif stampType == "Crater" then settings = self.stampSystem:CreateCraterStamp(size :: number, height :: number, self.editor.currentMaterialId)
	else settings = { type = stampType, size = size, height = height, falloff = 0.7, materialId = self.editor.currentMaterialId, noiseAmount = 0.3, seed = math.random(1, 10000) } end
	local affected = self.stampSystem:ApplyStamp(self.terrainAPI.terrain, worldPos, settings)
	for _, coord in affected do self.terrainAPI:MeshChunk(coord) end
	return affected
end

function TerrainController:ApplyErosion(type: string?)
	type = type or "combined"
	if not self.terrainAPI then return end
	print("[Arkher TerrainController] Applying erosion", type, "- World Creator level")
	local Noise = require(game:GetService("ReplicatedStorage").Arkher.Terrain.Noise)
	local Erosion = require(game:GetService("ReplicatedStorage").Arkher.Terrain.Erosion)
	local settings = self.terrainAPI.terrain.settings
	local heightmapSettings = {
		seed = settings.seed,
		scale = 50,
		octaves = settings.octaves,
		lacunarity = settings.lacunarity,
		gain = settings.gain,
		height = settings.heightScale,
		baseHeight = settings.baseHeight,
		noiseType = settings.noiseType,
		domainWarp = true,
		warpAmount = 5,
	}
	local heightmap = Noise.GenerateHeightmap(128, 128, heightmapSettings)
	local eroded = Erosion.Apply(heightmap)
	print("[Arkher TerrainController] Erosion applied - Regenerating chunks")
	self:ClearTerrain()
	self:GenerateInitialTerrain(3)
end

function TerrainController:GetStats(): { [string]: any }
	return {
		isActive = self.isActive,
		terrainAPI = self.terrainAPI and self.terrainAPI:GetStats() or {},
		brushSystem = self.brushSystem and self.brushSystem:GetStats() or {},
		stampSystem = self.stampSystem and self.stampSystem:GetStats() or {},
		editor = self.editor and self.editor:GetStats() or {},
		greedyMesher = self.greedyMesher and self.greedyMesher:GetStats() or {},
		dualContouring = self.dualContouring and self.dualContouring:GetStats() or {},
		features = {"MechaTerrainAPI custom", "Greedy Meshing 10x opt", "Dual Contouring smooth", "Brushes 9 types", "Stamps 9 types", "Biomes 7", "Erosion Thermal/Hydraulic/Wind", "Infinite chunked", "15GB"},
		message = "TerrainController Fase 4 - Mecha Engine Custom Terrain - World Creator level - Infinite chunked",
	}
end

return TerrainController
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXbbd58af6e7e41eb7">
    <Properties>
      <string name="Name">TerrainEditor</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 4 - TerrainEditor - World Creator level UI

local TerrainData = require(game:GetService("ReplicatedStorage").Arkher.Terrain.TerrainData)
local VoxelTypes = require(game:GetService("ReplicatedStorage").Arkher.Terrain.VoxelTypes)
local Biomes = require(game:GetService("ReplicatedStorage").Arkher.Terrain.Biomes)

local TerrainEditor = {}
TerrainEditor.__index = TerrainEditor

function TerrainEditor.new(terrainAPI: any, brushSystem: any, stampSystem: any)
	return setmetatable({
		terrainAPI = terrainAPI,
		brushSystem = brushSystem,
		stampSystem = stampSystem,
		currentBiomeId = "plains",
		currentMaterialId = 1,
		currentBrushType = "Raise",
		currentStampType = "Mountain",
		ui = nil :: Frame?,
		viewport = nil :: Frame?,
		brushPreview = nil :: Part?,
		isEditing = false,
	}, TerrainEditor)
end

function TerrainEditor:Init(parent: Frame)
	self.ui = parent
	local header = Instance.new("Frame")
	header.Name = "TerrainHeader"
	header.Size = UDim2.new(1, 0, 0, 32)
	header.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	header.Parent = parent
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0, 300, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "Terrain Terrain - World Creator + Mecha Engine"
	title.TextColor3 = Color3.fromRGB(230, 230, 230)
	title.TextSize = 12
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = header
	local toolbar = Instance.new("Frame")
	toolbar.Name = "BrushToolbar"
	toolbar.Size = UDim2.new(1, 0, 0, 36)
	toolbar.Position = UDim2.new(0, 0, 0, 32)
	toolbar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	toolbar.Parent = parent
	local toolbarLayout = Instance.new("UIListLayout")
	toolbarLayout.FillDirection = Enum.FillDirection.Horizontal
	toolbarLayout.Padding = UDim.new(0, 4)
	toolbarLayout.Parent = toolbar
	local brushes = {"Raise", "Lower", "Smooth", "Flatten", "Paint", "Noise", "Erode", "Stamp", "Spline"}
	for _, brushName in brushes do
		local btn = Instance.new("TextButton")
		btn.Name = brushName .. "Brush"
		btn.Size = UDim2.new(0, 70, 0, 28)
		btn.BackgroundColor3 = brushName == self.currentBrushType and Color3.fromRGB(100, 200, 100) or Color3.fromRGB(60, 60, 60)
		btn.Text = brushName
		btn.TextColor3 = Color3.fromRGB(230, 230, 230)
		btn.TextSize = 9
		btn.Font = Enum.Font.Gotham
		btn.Parent = toolbar
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn
		btn.MouseButton1Click:Connect(function()
			self.currentBrushType = brushName
			self.brushSystem:SetBrushType(brushName :: any)
			for _, other in toolbar:GetChildren() do if other:IsA("TextButton") then other.BackgroundColor3 = Color3.fromRGB(60, 60, 60) end end
			btn.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
			print("[Arkher TerrainEditor] Brush -&gt;", brushName)
		end)
	end
	local matBar = Instance.new("Frame")
	matBar.Name = "MaterialBar"
	matBar.Size = UDim2.new(1, 0, 0, 36)
	matBar.Position = UDim2.new(0, 0, 0, 68)
	matBar.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	matBar.Parent = parent
	local matLayout = Instance.new("UIListLayout")
	matLayout.FillDirection = Enum.FillDirection.Horizontal
	matLayout.Padding = UDim.new(0, 4)
	matLayout.Parent = matBar
	local materials = VoxelTypes.GetSolidMaterials()
	for i, mat in materials do
		if i &gt; 8 then break end
		local btn = Instance.new("TextButton")
		btn.Name = mat.name .. "Mat"
		btn.Size = UDim2.new(0, 60, 0, 28)
		btn.BackgroundColor3 = mat.color
		btn.Text = mat.displayName
		btn.TextColor3 = Color3.new(1,1,1)
		btn.TextSize = 8
		btn.Font = Enum.Font.Gotham
		btn.Parent = matBar
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = btn
		btn.MouseButton1Click:Connect(function()
			self.currentMaterialId = mat.id
			self.brushSystem:SetMaterial(mat.id)
			print("[Arkher TerrainEditor] Material -&gt;", mat.displayName)
		end)
	end
	local biomeBtn = Instance.new("TextButton")
	biomeBtn.Name = "BiomeSelector"
	biomeBtn.Size = UDim2.new(0, 120, 0, 28)
	biomeBtn.BackgroundColor3 = Color3.fromRGB(80, 120, 200)
	biomeBtn.Text = " Biome: Plains"
	biomeBtn.TextColor3 = Color3.new(1,1,1)
	biomeBtn.TextSize = 9
	biomeBtn.Font = Enum.Font.GothamBold
	biomeBtn.Parent = matBar
	local biomeCorner = Instance.new("UICorner")
	biomeCorner.CornerRadius = UDim.new(0, 4)
	biomeCorner.Parent = biomeBtn
	biomeBtn.MouseButton1Click:Connect(function() self:CycleBiome() end)
	local mainSplit = Instance.new("Frame")
	mainSplit.Name = "MainSplit"
	mainSplit.Size = UDim2.new(1, 0, 1, -104)
	mainSplit.Position = UDim2.new(0, 0, 0, 104)
	mainSplit.BackgroundTransparency = 1
	mainSplit.Parent = parent
	self.viewport = Instance.new("Frame")
	self.viewport.Name = "TerrainViewport"
	self.viewport.Size = UDim2.new(0.65, -5, 1, -10)
	self.viewport.Position = UDim2.new(0, 0, 0, 0)
	self.viewport.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
	self.viewport.Parent = mainSplit
	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 8)
	vpCorner.Parent = self.viewport
	local vpLabel = Instance.new("TextLabel")
	vpLabel.Name = "ViewportLabel"
	vpLabel.Size = UDim2.new(1, 0, 0, 20)
	vpLabel.BackgroundTransparency = 1
	vpLabel.Text = "  Viewport - Mecha Terrain - 0 chunks - Infinite - Greedy Meshing - World Creator"
	vpLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
	vpLabel.TextSize = 10
	vpLabel.Font = Enum.Font.Code
	vpLabel.TextXAlignment = Enum.TextXAlignment.Left
	vpLabel.Parent = self.viewport
	local props = Instance.new("ScrollingFrame")
	props.Name = "TerrainProps"
	props.Size = UDim2.new(0.35, -5, 1, -10)
	props.Position = UDim2.new(0.65, 5, 0, 0)
	props.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	props.ScrollBarThickness = 4
	props.CanvasSize = UDim2.new(0, 0, 0, 0)
	props.AutomaticCanvasSize = Enum.AutomaticSize.Y
	props.Parent = mainSplit
	local propsCorner = Instance.new("UICorner")
	propsCorner.CornerRadius = UDim.new(0, 6)
	propsCorner.Parent = props
	local propsLayout = Instance.new("UIListLayout")
	propsLayout.Padding = UDim.new(0, 5)
	propsLayout.Parent = props
	local settingsLabel = Instance.new("TextLabel")
	settingsLabel.Size = UDim2.new(1, -10, 0, 20)
	settingsLabel.BackgroundTransparency = 1
	settingsLabel.Text = "  Brush Settings - World Creator"
	settingsLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	settingsLabel.TextSize = 11
	settingsLabel.Font = Enum.Font.GothamBold
	settingsLabel.TextXAlignment = Enum.TextXAlignment.Left
	settingsLabel.LayoutOrder = 1
	settingsLabel.Parent = props
	local sizeFrame = Instance.new("Frame")
	sizeFrame.Size = UDim2.new(1, -10, 0, 30)
	sizeFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	sizeFrame.LayoutOrder = 2
	sizeFrame.Parent = props
	local sizeLabel = Instance.new("TextLabel")
	sizeLabel.Size = UDim2.new(0.4, 0, 1, 0)
	sizeLabel.BackgroundTransparency = 1
	sizeLabel.Text = "Size: 10"
	sizeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	sizeLabel.TextSize = 10
	sizeLabel.Font = Enum.Font.Gotham
	sizeLabel.Parent = sizeFrame
	local sizePlus = Instance.new("TextButton")
	sizePlus.Size = UDim2.new(0, 30, 0, 20)
	sizePlus.Position = UDim2.new(0.5, 0, 0, 5)
	sizePlus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	sizePlus.Text = "+"
	sizePlus.TextColor3 = Color3.new(1,1,1)
	sizePlus.Parent = sizeFrame
	local sizeMinus = Instance.new("TextButton")
	sizeMinus.Size = UDim2.new(0, 30, 0, 20)
	sizeMinus.Position = UDim2.new(0.7, 0, 0, 5)
	sizeMinus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	sizeMinus.Text = "-"
	sizeMinus.TextColor3 = Color3.new(1,1,1)
	sizeMinus.Parent = sizeFrame
	sizePlus.MouseButton1Click:Connect(function()
		local newSize = math.clamp(self.brushSystem.settings.size + 2, 1, 100)
		self.brushSystem:SetSize(newSize)
		sizeLabel.Text = "Size: " .. newSize
	end)
	sizeMinus.MouseButton1Click:Connect(function()
		local newSize = math.clamp(self.brushSystem.settings.size - 2, 1, 100)
		self.brushSystem:SetSize(newSize)
		sizeLabel.Text = "Size: " .. newSize
	end)
	local strengthFrame = Instance.new("Frame")
	strengthFrame.Size = UDim2.new(1, -10, 0, 30)
	strengthFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	strengthFrame.LayoutOrder = 3
	strengthFrame.Parent = props
	local strLabel = Instance.new("TextLabel")
	strLabel.Size = UDim2.new(0.4, 0, 1, 0)
	strLabel.BackgroundTransparency = 1
	strLabel.Text = "Strength: 1"
	strLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	strLabel.TextSize = 10
	strLabel.Font = Enum.Font.Gotham
	strLabel.Parent = strengthFrame
	local strPlus = Instance.new("TextButton")
	strPlus.Size = UDim2.new(0, 30, 0, 20)
	strPlus.Position = UDim2.new(0.5, 0, 0, 5)
	strPlus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	strPlus.Text = "+"
	strPlus.TextColor3 = Color3.new(1,1,1)
	strPlus.Parent = strengthFrame
	local strMinus = Instance.new("TextButton")
	strMinus.Size = UDim2.new(0, 30, 0, 20)
	strMinus.Position = UDim2.new(0.7, 0, 0, 5)
	strMinus.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	strMinus.Text = "-"
	strMinus.TextColor3 = Color3.new(1,1,1)
	strMinus.Parent = strengthFrame
	strPlus.MouseButton1Click:Connect(function()
		local newStr = math.clamp(self.brushSystem.settings.strength + 0.5, 0.1, 10)
		self.brushSystem:SetStrength(newStr)
		strLabel.Text = "Strength: " .. newStr
	end)
	strMinus.MouseButton1Click:Connect(function()
		local newStr = math.clamp(self.brushSystem.settings.strength - 0.5, 0.1, 10)
		self.brushSystem:SetStrength(newStr)
		strLabel.Text = "Strength: " .. newStr
	end)
	local stampLabel = Instance.new("TextLabel")
	stampLabel.Size = UDim2.new(1, -10, 0, 20)
	stampLabel.BackgroundTransparency = 1
	stampLabel.Text = "  Stamps - World Creator"
	stampLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	stampLabel.TextSize = 11
	stampLabel.Font = Enum.Font.GothamBold
	stampLabel.TextXAlignment = Enum.TextXAlignment.Left
	stampLabel.LayoutOrder = 4
	stampLabel.Parent = props
	local stamps = {"Mountain", "Crater", "Hill", "Plateau", "Dune", "Rock"}
	for i, stampType in stamps do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -10, 0, 28)
		btn.BackgroundColor3 = Color3.fromRGB(50, 100, 50)
		btn.Text = "Terrain " .. stampType
		btn.TextColor3 = Color3.new(1,1,1)
		btn.TextSize = 10
		btn.Font = Enum.Font.Gotham
		btn.LayoutOrder = 4 + i
		btn.Parent = props
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = btn
		btn.MouseButton1Click:Connect(function() self.currentStampType = stampType print("[Arkher TerrainEditor] Stamp -&gt;", stampType) end)
	end
	local genLabel = Instance.new("TextLabel")
	genLabel.Size = UDim2.new(1, -10, 0, 20)
	genLabel.BackgroundTransparency = 1
	genLabel.Text = "  Generate - World Creator"
	genLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	genLabel.TextSize = 11
	genLabel.Font = Enum.Font.GothamBold
	genLabel.TextXAlignment = Enum.TextXAlignment.Left
	genLabel.LayoutOrder = 20
	genLabel.Parent = props
	local genBtns = {"Generate Area", "Clear Terrain", "Apply Erosion", "Export Heightmap", "Import Heightmap"}
	for i, genName in genBtns do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -10, 0, 32)
		btn.BackgroundColor3 = genName == "Clear Terrain" and Color3.fromRGB(200, 50, 50) or genName == "Generate Area" and Color3.fromRGB(100, 150, 255) or Color3.fromRGB(60, 60, 60)
		btn.Text = genName
		btn.TextColor3 = Color3.new(1,1,1)
		btn.TextSize = 10
		btn.Font = Enum.Font.GothamBold
		btn.LayoutOrder = 20 + i
		btn.Parent = props
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn
		btn.MouseButton1Click:Connect(function() self:OnGenerateClicked(genName) end)
	end
	print("[Arkher TerrainEditor] Initialized - World Creator level - Fase 4")
end

function TerrainEditor:CycleBiome()
	local biomes = Biomes.GetAllBiomes()
	local currentIndex = 1
	for i, biome in biomes do if biome.id == self.currentBiomeId then currentIndex = i break end end
	local nextIndex = (currentIndex % #biomes) + 1
	local nextBiome = biomes[nextIndex]
	self.currentBiomeId = nextBiome.id
	if self.ui then
		local matBar = self.ui:FindFirstChild("MaterialBar")
		if matBar then
			local biomeBtn = matBar:FindFirstChild("BiomeSelector")
			if biomeBtn and biomeBtn:IsA("TextButton") then biomeBtn.Text = " Biome: " .. nextBiome.displayName biomeBtn.BackgroundColor3 = nextBiome.color end
		end
	end
	print("[Arkher TerrainEditor] Biome -&gt;", nextBiome.displayName)
end

function TerrainEditor:OnGenerateClicked(action: string)
	print("[Arkher TerrainEditor] Generate action:", action)
	if action == "Generate Area" then
		if self.terrainAPI then
			local center = Vector3.new(0, 0, 0)
			self.terrainAPI:LoadArea(center, 3)
			print("[Arkher TerrainEditor] Generated area radius 3")
			if self.viewport then
				local label = self.viewport:FindFirstChild("ViewportLabel")
				if label and label:IsA("TextLabel") then
					local stats = self.terrainAPI:GetStats()
					label.Text = string.format("  Viewport - Mecha Terrain - %d chunks - %d voxels - %s - Infinite", stats.loadedChunks, stats.totalVoxels, stats.mesher)
				end
			end
		end
	elseif action == "Clear Terrain" then
		if self.terrainAPI then self.terrainAPI:Clear() print("[Arkher TerrainEditor] Cleared terrain") if self.viewport then local label = self.viewport:FindFirstChild("ViewportLabel") if label and label:IsA("TextLabel") then label.Text = "  Viewport - Mecha Terrain - Cleared - 0 chunks" end end end
	elseif action == "Apply Erosion" then print("[Arkher TerrainEditor] Apply erosion - World Creator")
	elseif action == "Export Heightmap" then print("[Arkher TerrainEditor] Export heightmap")
	elseif action == "Import Heightmap" then print("[Arkher TerrainEditor] Import heightmap")
	end
end

function TerrainEditor:OnViewportClick(worldPos: Vector3)
	if not self.terrainAPI then return end
	if self.currentBrushType == "Stamp" then
		local stampSettings: any
		if self.currentStampType == "Mountain" then stampSettings = self.stampSystem:CreateMountainStamp(self.brushSystem.settings.size, 20, self.currentMaterialId)
		elseif self.currentStampType == "Crater" then stampSettings = self.stampSystem:CreateCraterStamp(self.brushSystem.settings.size, 10, self.currentMaterialId)
		else stampSettings = { type = self.currentStampType, size = self.brushSystem.settings.size, height = 15, falloff = 0.7, materialId = self.currentMaterialId, noiseAmount = 0.3, seed = math.random(1, 10000) } end
		self.stampSystem:ApplyStamp(self.terrainAPI.terrain, worldPos, stampSettings)
		local chunkCoord, _ = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData).WorldToChunkPos(worldPos, self.terrainAPI.chunkSize)
		self.terrainAPI:MeshChunk(chunkCoord)
	else
		self.brushSystem:ApplyBrush(self.terrainAPI.terrain, worldPos)
		local chunkCoord, _ = require(game:GetService("ReplicatedStorage").Arkher.Terrain.ChunkData).WorldToChunkPos(worldPos, self.terrainAPI.chunkSize)
		self.terrainAPI:MeshChunk(chunkCoord)
	end
	print("[Arkher TerrainEditor] Viewport click at", worldPos, "- Brush:", self.currentBrushType)
end

function TerrainEditor:GetStats(): { [string]: any }
	return {
		currentBrush = self.currentBrushType,
		currentMaterial = self.currentMaterialId,
		currentBiome = self.currentBiomeId,
		currentStamp = self.currentStampType,
		brushSettings = self.brushSystem and self.brushSystem:GetStats() or {},
		stampCount = self.stampSystem and #self.stampSystem:GetStamps() or 0,
		terrainStats = self.terrainAPI and self.terrainAPI:GetStats() or {},
		isEditing = self.isEditing,
		message = "TerrainEditor Fase 4 - World Creator level"
	}
end

return TerrainEditor
</ProtectedString>
    </Properties>
  </Item>
  </Item>
  <Item class="Folder" referent="RBXd713822e31747800">
    <Properties>
      <string name="Name">UI</string>
    </Properties>
  <Item class="ModuleScript" referent="RBX54be28c67eda84ea">
    <Properties>
      <string name="Name">AdaptiveLayout</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - AdaptiveLayout - Polimento Total
-- Layout adaptativo inspirado no melhor: Figma (auto-layout), Unreal (docking), VS Code (flex), Blender (areas)
-- Mas nosso: confortavel em TODOS dispositivos, especialmente mobile
-- Mobile: A01 720x1280 até Flagship 1440x3200, Tablet, Desktop 1080p-8K, Console, VR

local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local AdaptiveLayout = {}
AdaptiveLayout.__index = AdaptiveLayout

export type DeviceType = "MobileSmall" | "Mobile" | "MobileLarge" | "Tablet" | "Desktop" | "UltraWide" | "Console" | "VR"
export type Orientation = "Portrait" | "Landscape"
export type Platform = "Mobile" | "Tablet" | "Desktop" | "Console" | "VR"

function AdaptiveLayout.DetectDevice(): DeviceType
	local screenSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
	local isTouch = UserInputService.TouchEnabled
	local isGamepad = UserInputService.GamepadEnabled and not isTouch
	local isKeyboard = UserInputService.KeyboardEnabled

	if UserInputService.VREnabled then
		return "VR"
	elseif isGamepad and not isKeyboard then
		return "Console"
	elseif isTouch then
		local smallest = math.min(screenSize.X, screenSize.Y)
		if smallest &lt; 400 then
			return "MobileSmall" -- A01, J2 Core
		elseif smallest &lt; 500 then
			return "Mobile" -- A01-A33 medio
		elseif smallest &lt; 700 then
			return "MobileLarge" -- S23, iPhone Pro
		else
			return "Tablet"
		end
	else
		if screenSize.X &gt; 2560 then
			return "UltraWide"
		else
			return "Desktop"
		end
	end
end

function AdaptiveLayout.DetectOrientation(): Orientation
	local screenSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
	return screenSize.X &gt; screenSize.Y and "Landscape" or "Portrait"
end

function AdaptiveLayout.new()
	local device = AdaptiveLayout.DetectDevice()
	local orientation = AdaptiveLayout.DetectOrientation()
	return setmetatable({
		device = device,
		orientation = orientation,
		screenSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080),
		safeArea = GuiService:GetGuiInset(),
		isMobile = device == "MobileSmall" or device == "Mobile" or device == "MobileLarge",
		isTablet = device == "Tablet",
		isDesktop = device == "Desktop" or device == "UltraWide",
		isConsole = device == "Console",
		isVR = device == "VR",
		listeners = {} :: { (DeviceType, Orientation) -&gt; () },
	}, AdaptiveLayout)
end

function AdaptiveLayout:GetLayoutConfig()
	-- Config por device - inspirado no melhor UX do mundo (Figma mobile, Unreal mobile, Blender mobile)
	if self.device == "MobileSmall" then -- A01 720x1280 - o mais desafiador, precisa ser PERFEITO
		return {
			topBarHeight = 44,
			bottomBarHeight = 80,
			sidePanelWidth = 0, -- No mobile small, side panels viram bottom sheet
			contentDrawerHeight = 280,
			viewportPadding = 5,
			buttonSize = 48, -- minimo 48dp para dedo (Material Design)
			buttonSpacing = 8,
			fontScale = 0.9,
			showOutliner = false,
			showDetails = false,
			useBottomSheet = true,
			useRadialMenu = true,
			toolbarPosition = "bottom",
			tabsScrollable = true,
			maxVisibleTabs = 3,
			gestures = true,
			haptics = true,
		}
	elseif self.device == "Mobile" then
		return {
			topBarHeight = 48,
			bottomBarHeight = 70,
			sidePanelWidth = 0,
			contentDrawerHeight = 300,
			viewportPadding = 8,
			buttonSize = 44,
			buttonSpacing = 10,
			fontScale = 1.0,
			showOutliner = false,
			showDetails = false,
			useBottomSheet = true,
			useRadialMenu = true,
			toolbarPosition = "bottom",
			tabsScrollable = true,
			maxVisibleTabs = 4,
			gestures = true,
			haptics = true,
		}
	elseif self.device == "MobileLarge" then
		return {
			topBarHeight = 50,
			bottomBarHeight = 70,
			sidePanelWidth = 260,
			contentDrawerHeight = 320,
			viewportPadding = 10,
			buttonSize = 42,
			buttonSpacing = 10,
			fontScale = 1.0,
			showOutliner = true,
			showDetails = false,
			useBottomSheet = true,
			useRadialMenu = false,
			toolbarPosition = "bottom",
			tabsScrollable = true,
			maxVisibleTabs = 5,
			gestures = true,
			haptics = false,
		}
	elseif self.device == "Tablet" then
		return {
			topBarHeight = 50,
			bottomBarHeight = 0,
			sidePanelWidth = 300,
			contentDrawerHeight = 260,
			viewportPadding = 12,
			buttonSize = 40,
			buttonSpacing = 12,
			fontScale = 1.0,
			showOutliner = true,
			showDetails = true,
			useBottomSheet = false,
			useRadialMenu = false,
			toolbarPosition = "top",
			tabsScrollable = true,
			maxVisibleTabs = 6,
			gestures = true,
			haptics = false,
		}
	elseif self.device == "Console" then
		return {
			topBarHeight = 60,
			bottomBarHeight = 0,
			sidePanelWidth = 340,
			contentDrawerHeight = 280,
			viewportPadding = 20,
			buttonSize = 48,
			buttonSpacing = 16,
			fontScale = 1.2,
			showOutliner = true,
			showDetails = true,
			useBottomSheet = false,
			useRadialMenu = false,
			toolbarPosition = "top",
			tabsScrollable = false,
			maxVisibleTabs = 8,
			gestures = false,
			haptics = true,
		}
	elseif self.device == "VR" then
		return {
			topBarHeight = 80,
			bottomBarHeight = 0,
			sidePanelWidth = 400,
			contentDrawerHeight = 300,
			viewportPadding = 30,
			buttonSize = 60,
			buttonSpacing = 20,
			fontScale = 1.4,
			showOutliner = true,
			showDetails = true,
			useBottomSheet = false,
			useRadialMenu = false,
			toolbarPosition = "floating",
			tabsScrollable = false,
			maxVisibleTabs = 8,
			gestures = true,
			haptics = true,
		}
	else -- Desktop / UltraWide
		return {
			topBarHeight = 40,
			bottomBarHeight = 0,
			sidePanelWidth = 280,
			contentDrawerHeight = 240,
			viewportPadding = 0,
			buttonSize = 32,
			buttonSpacing = 8,
			fontScale = 1.0,
			showOutliner = true,
			showDetails = true,
			useBottomSheet = false,
			useRadialMenu = false,
			toolbarPosition = "top",
			tabsScrollable = true,
			maxVisibleTabs = 8,
			gestures = false,
			haptics = false,
		}
	end
end

function AdaptiveLayout:ApplyToUI(ui: { [string]: Frame })
	local config = self:GetLayoutConfig()
	print("[Arkher Adaptive] Device:", self.device, "Orientation:", self.orientation, "Config:", config)

	if self.isMobile then
		-- Mobile: esconde side panels, usa bottom sheet
		if ui.outliner then
			ui.outliner.Visible = config.showOutliner
			if config.showOutliner then
				ui.outliner.Size = UDim2.new(0, config.sidePanelWidth, 1, -config.topBarHeight - config.bottomBarHeight - config.contentDrawerHeight)
			end
		end
		if ui.details then
			ui.details.Visible = config.showDetails
		end
		if ui.contentDrawer then
			ui.contentDrawer.Size = UDim2.new(1, 0, 0, config.contentDrawerHeight)
			ui.contentDrawer.Position = UDim2.new(0, 0, 1, -config.contentDrawerHeight - config.bottomBarHeight)
		end
		if ui.viewport then
			ui.viewport.Size = UDim2.new(1, -config.viewportPadding*2, 1, -config.topBarHeight - config.bottomBarHeight - config.contentDrawerHeight - config.viewportPadding*2)
			ui.viewport.Position = UDim2.new(0, config.viewportPadding, 0, config.topBarHeight + config.viewportPadding)
		end
	else
		-- Desktop/Tablet: layout tradicional
		if ui.topBar then
			ui.topBar.Size = UDim2.new(1, 0, 0, config.topBarHeight)
		end
		if ui.outliner then
			ui.outliner.Visible = true
			ui.outliner.Size = UDim2.new(0, config.sidePanelWidth, 1, -config.topBarHeight - config.contentDrawerHeight - 10)
			ui.outliner.Position = UDim2.new(0, 0, 0, config.topBarHeight + 10)
		end
		if ui.details then
			ui.details.Visible = true
			ui.details.Size = UDim2.new(0, config.sidePanelWidth + 40, 1, -config.topBarHeight - config.contentDrawerHeight - 10)
			ui.details.Position = UDim2.new(1, -config.sidePanelWidth - 40, 0, config.topBarHeight + 10)
		end
		if ui.contentDrawer then
			ui.contentDrawer.Size = UDim2.new(1, -config.sidePanelWidth*2 - 60, 0, config.contentDrawerHeight)
			ui.contentDrawer.Position = UDim2.new(0, config.sidePanelWidth + 10, 1, -config.contentDrawerHeight - 10)
		end
		if ui.viewport then
			ui.viewport.Size = UDim2.new(1, -config.sidePanelWidth*2 - 60, 1, -config.topBarHeight - config.contentDrawerHeight - 20)
			ui.viewport.Position = UDim2.new(0, config.sidePanelWidth + 10, 0, config.topBarHeight + 10)
		end
	end
end

function AdaptiveLayout:CreateBottomSheet(parent: ScreenGui, theme: any): Frame
	-- Bottom sheet estilo Google Maps / Figma mobile - melhor UX mobile do mundo
	local sheet = Instance.new("Frame")
	sheet.Name = "AdaptiveBottomSheet"
	sheet.Size = UDim2.new(1, 0, 0, 400)
	sheet.Position = UDim2.new(0, 0, 1, 0)
	sheet.BackgroundColor3 = theme.panel
	sheet.BorderSizePixel = 0
	sheet.ZIndex = 15
	sheet.Visible = false
	sheet.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = sheet

	-- Handle
	local handle = Instance.new("Frame")
	handle.Name = "Handle"
	handle.Size = UDim2.new(0, 40, 0, 4)
	handle.Position = UDim2.new(0.5, -20, 0, 8)
	handle.BackgroundColor3 = theme.textDim
	handle.BorderSizePixel = 0
	handle.Parent = sheet

	local handleCorner = Instance.new("UICorner")
	handleCorner.CornerRadius = UDim.new(0, 2)
	handleCorner.Parent = handle

	-- Drag area
	local dragArea = Instance.new("Frame")
	dragArea.Name = "DragArea"
	dragArea.Size = UDim2.new(1, 0, 0, 30)
	dragArea.BackgroundTransparency = 1
	dragArea.Parent = sheet

	return sheet
end

function AdaptiveLayout:CreateMobileToolbar(parent: ScreenGui, theme: any): Frame
	local config = self:GetLayoutConfig()
	local toolbar = Instance.new("Frame")
	toolbar.Name = "AdaptiveMobileToolbar"
	toolbar.Size = UDim2.new(1, 0, 0, config.bottomBarHeight)
	toolbar.Position = UDim2.new(0, 0, 1, -config.bottomBarHeight)
	toolbar.BackgroundColor3 = theme.panel
	toolbar.BorderSizePixel = 0
	toolbar.ZIndex = 20
	toolbar.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 16)
	corner.Parent = toolbar

	local stroke = Instance.new("UIStroke")
	stroke.Color = theme.border
	stroke.Thickness = 1
	stroke.Parent = toolbar

	-- Safe area padding para iPhone notch / Android gesture
	local padding = Instance.new("UIPadding")
	padding.PaddingBottom = UDim.new(0, 10)
	padding.Parent = toolbar

	return toolbar
end

function AdaptiveLayout:OnDeviceChanged(cb: (DeviceType, Orientation) -&gt; ())
	table.insert(self.listeners, cb)
end

function AdaptiveLayout:GetStats()
	return {
		device = self.device,
		orientation = self.orientation,
		screenSize = self.screenSize,
		isMobile = self.isMobile,
		isTablet = self.isTablet,
		isDesktop = self.isDesktop,
		isConsole = self.isConsole,
		isVR = self.isVR,
		config = self:GetLayoutConfig(),
		message = "AdaptiveLayout - Polimento Total - A01 720x1280 até 8K + Console + VR - BottomSheet + Radial + Gestures",
	}
end

return AdaptiveLayout
