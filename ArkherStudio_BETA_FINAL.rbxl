function MonacoPro:UpdateLineNumbers()
	if not self.lineNumbers or not self.textBox then return end

	for _, child in self.lineNumbers:GetChildren() do
		if child:IsA("TextLabel") then child:Destroy() end
	end

	local lines = string.split(self.textBox.Text, "\n")
	for i = 1, #lines do
		local label = Instance.new("TextLabel")
		label.Name = "Line_" .. i
		label.Size = UDim2.new(1, 0, 0, 18)
		label.BackgroundTransparency = 1
		label.Text = tostring(i)
		label.TextColor3 = self.theme.lineNumber
		label.TextSize = 12
		label.Font = Enum.Font.Code
		label.TextXAlignment = Enum.TextXAlignment.Right
		label.LayoutOrder = i
		label.Parent = self.lineNumbers

		for _, err in self.errors do
			if err.line == i then
				label.TextColor3 = err.severity == "error" and self.theme.error or self.theme.warning
				label.Text = "● " .. i
			end
		end
	end
end

function MonacoPro:CheckErrorsPro()
	self.errors = {}
	local lines = string.split(self.code, "\n")

	for i, line in lines do
		if self.language == "luau" then
			local openParen = select(2, string.gsub(line, "%(", ""))
			local closeParen = select(2, string.gsub(line, "%)", ""))
			if openParen ~= closeParen then
				table.insert(self.errors, { line = i, message = "Mismatched parentheses", severity = "error", plugin = "eslint" })
			end
			if string.find(line, "%.%.%.") and not string.find(line, "print") then
				table.insert(self.errors, { line = i, message = "Variadic args ... should be used in function", severity = "warning", plugin = "luau" })
			end
		elseif self.language == "python" then
			if (string.find(line, "^%s*def ") or string.find(line, "^%s*if ") or string.find(line, "^%s*for ") or string.find(line, "^%s*while ") or string.find(line, "^%s*class ")) and not string.find(line, ":") and not string.find(line, "#") then
				table.insert(self.errors, { line = i, message = "Missing colon", severity = "error", plugin = "python" })
			end
		end
	end

	-- AI auto-fix suggestions
	if #self.errors &gt; 0 and self.enabledPlugins["arkherFix"] then
		for _, err in self.errors do
			table.insert(self.aiSuggestions, { text = "Tools AI Fix: " .. err.message, line = err.line, aiConfidence = 0.9 })
		end
	end

	self:UpdateLineNumbers()
end

function MonacoPro:LoadAutocompletePro()
	local items = {}

	if self.language == "luau" then
		items = {
			{ label = "print", kind = "Function", detail = "print(...)", insertText = "print($1)", plugin = "luau", ai = false },
			{ label = "Vector3.new", kind = "Function", detail = "Vector3.new(x,y,z)", insertText = "Vector3.new($1, $2, $3)", plugin = "luau", ai = false },
			{ label = "Color3.fromRGB", kind = "Function", detail = "Color3.fromRGB(r,g,b)", insertText = "Color3.fromRGB($1, $2, $3)", plugin = "luau", ai = false },
			{ label = "Instance.new", kind = "Function", detail = "Instance.new(className)", insertText = "Instance.new(\"$1\")", plugin = "luau", ai = false },
			{ label = "Entity.new", kind = "Function", detail = "Arkher Entity - ECS", insertText = "Entity.new(\"$1\")", plugin = "arkherApi", ai = false },
			{ label = "Component.Transform", kind = "Function", detail = "Transform component - Mecha Engine", insertText = "Component.Transform(Vector3.new($1))", plugin = "arkherApi", ai = false },
			{ label = "Component.Render", kind = "Function", detail = "Render component - PBR", insertText = "Component.Render(Enum.Material.${1:Plastic}, Color3.fromRGB($2))", plugin = "arkherApi", ai = false },
			{ label = "MechaTerrainAPI:GenerateChunk", kind = "Function", detail = "Generate chunk Mecha Engine", insertText = "MechaTerrainAPI:GenerateChunk(${1:x}, ${2:y}, ${3:z})", plugin = "arkherTerrain", ai = false },
			{ label = "ArkherAI:GenerateModel", kind = "Function", detail = "Generate 3D model with ARKHER AI v1", insertText = "ArkherAI:GenerateModel(\"${1:prompt}\", \"${2:style}\")", plugin = "arkherCopilot", ai = true },
			{ label = "ArkherAI:GenerateScript", kind = "Function", detail = "Generate script with ARKHER AI v1", insertText = "ArkherAI:GenerateScript(\"${1:prompt}\")", plugin = "arkherCopilot", ai = true },
		}
	elseif self.language == "python" then
		items = {
			{ label = "print", kind = "Function", detail = "print(value)", insertText = "print($1)", plugin = "python", ai = false },
			{ label = "Entity.new", kind = "Function", detail = "Arkher Entity", insertText = "Entity.new(\"$1\")", plugin = "arkherApi", ai = false },
			{ label = "def", kind = "Keyword", detail = "Define function", insertText = "def ${1:name}($2):\n    $3", plugin = "python", ai = false },
			{ label = "for", kind = "Keyword", detail = "For loop", insertText = "for ${1:i} in ${2:range}:\n    $3", plugin = "python", ai = false },
			{ label = "ArkherAI", kind = "Class", detail = "ARKHER AI v1 API", insertText = "ArkherAI", plugin = "arkherCopilot", ai = true },
		}
	end

	self.autocompleteItems = items
	print("[Arkher MonacoPro] Loaded", #items, "autocomplete items + AI for", self.language)
end

function MonacoPro:LoadSnippets()
	self.snippets = {
		{ prefix = "arkher_entity", body = "local ${1:entity} = Entity.new(\"${2:Name}\")\nEntity.AddComponent(${1:entity}, \"Transform\", Component.Transform(Vector3.new($3)))\nEntity.AddComponent(${1:entity}, \"Render\", Component.Render(Enum.Material.${4:Plastic}, Color3.fromRGB($5)))\nself.world:AddEntity(${1:entity})", description = "Create Arkher Entity" },
		{ prefix = "arkher_terrain", body = "local chunk = MechaTerrainAPI:GenerateChunk(${1:x}, ${2:y}, ${3:z}, \"${4:plains}\")\nMechaTerrainAPI:MeshChunk(chunk, \"${5:greedy}\")", description = "Generate Terrain Chunk Mecha" },
		{ prefix = "arkher_ai_model", body = "-- ARKHER AI v1 - Generate 3D Model\nlocal result = ArkherAI:GenerateModel(\"${1:katana cyberpunk ultra realista}\", \"${2:photorealistic}\")\nprint(\"Generated:\", result.mesh.vertices, \"verts\")", description = "AI Generate Model" },
	}
end

function MonacoPro:UpdateAutocompletePro()
	if not self.frame then return end
	local container = self.frame:FindFirstChild("MonacoProContainer")
	if not container then return end
	local autocomplete = container:FindFirstChild("AutocompletePro")
	if not autocomplete then return end

	local text = self.code
	local lastWord = string.match(text, "([%w_%.:]+)$")

	if lastWord and #lastWord &gt;= 2 then
		local filtered = {}
		for _, item in self.autocompleteItems do
			if string.find(string.lower(item.label), string.lower(lastWord), 1, true) then
				if self.enabledPlugins[item.plugin] then
					table.insert(filtered, item)
				end
			end
		end

		-- Add AI suggestions on top if enabled
		if self.enabledPlugins["arkherCopilot"] then
			for _, aiSugg in self.aiSuggestions do
				if string.find(string.lower(aiSugg.text), string.lower(lastWord), 1, true) then
					table.insert(filtered, 1, { label = aiSugg.text, kind = "AI", detail = "ARKHER AI v1 - Confidence: " .. math.floor(aiSugg.aiConfidence*100) .. "%", insertText = aiSugg.text, plugin = "arkherCopilot", ai = true })
				end
			end
		end

		if #filtered &gt; 0 and #filtered &lt;= 15 then
			local autoList = autocomplete:FindFirstChild("AutoList")
			if autoList then
				for _, child in autoList:GetChildren() do if child:IsA("TextButton") then child:Destroy() end end

				for i, item in filtered do
					local btn = Instance.new("TextButton")
					btn.Size = UDim2.new(1, -10, 0, 32)
					btn.BackgroundColor3 = item.ai and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(55, 55, 75)
					btn.Text = ""
					btn.LayoutOrder = i
					btn.Parent = autoList

					local corner = Instance.new("UICorner")
					corner.CornerRadius = UDim.new(0, 4)
					corner.Parent = btn

					local icon = Instance.new("TextLabel")
					icon.Size = UDim2.new(0, 30, 1, 0)
					icon.BackgroundTransparency = 1
					icon.Text = item.ai and "AI" or item.kind == "Function" and "ƒ" or ""
					icon.TextColor3 = item.ai and Color3.new(1,1,1) or Color3.fromRGB(200,200,200)
					icon.TextSize = 14
					icon.Parent = btn

					local label = Instance.new("TextLabel")
					label.Size = UDim2.new(1, -90, 0.6, 0)
					label.Position = UDim2.new(0, 35, 0, 0)
					label.BackgroundTransparency = 1
					label.Text = item.label
					label.TextColor3 = Color3.new(1,1,1)
					label.TextSize = 11
					label.Font = Enum.Font.Code
					label.TextXAlignment = Enum.TextXAlignment.Left
					label.Parent = btn

					local detail = Instance.new("TextLabel")
					detail.Size = UDim2.new(1, -90, 0.4, 0)
					detail.Position = UDim2.new(0, 35, 0.6, 0)
					detail.BackgroundTransparency = 1
					detail.Text = item.detail .. " • " .. item.plugin
					detail.TextColor3 = Color3.fromRGB(150,150,170)
					detail.TextSize = 9
					detail.Font = Enum.Font.Gotham
					detail.TextXAlignment = Enum.TextXAlignment.Left
					detail.Parent = btn

					btn.MouseButton1Click:Connect(function()
						self:InsertAutocomplete(item)
						autocomplete.Visible = false
					end)
				end

				autocomplete.Visible = true
			end
		else
			autocomplete.Visible = false
		end
	else
		autocomplete.Visible = false
	end
end

function MonacoPro:UpdateAISuggestions()
	if not self.enabledPlugins["arkherCopilot"] then return end
	-- Simulate AI suggestions based on context
	local text = self.code
	if string.find(text, "Entity") and not string.find(text, "AddComponent") then
		table.insert(self.aiSuggestions, { text = "Entity.AddComponent(entity, \"Transform\", Component.Transform(...))", line = 1, aiConfidence = 0.95 })
	end
	if string.find(text, "function") and #text &lt; 100 then
		table.insert(self.aiSuggestions, { text = "-- ARKHER AI: Generate function body from comment", line = 1, aiConfidence = 0.85 })
	end
end

function MonacoPro:AskAI(prompt: string)
	print("[Arkher MonacoPro] Asking ARKHER AI v1:", prompt)
	-- In production, calls backend /api/arkherai/chat
	-- Mock response
	if self.frame then
		local container = self.frame:FindFirstChild("MonacoProContainer")
		local editorArea = container and container:FindFirstChild("EditorArea")
		local aiPanel = editorArea and editorArea:FindFirstChild("AIPanel")
		local aiChat = aiPanel and aiPanel:FindFirstChild("AIChat")
		if aiChat then
			local response = Instance.new("TextLabel")
			response.Size = UDim2.new(1, -10, 0, 60)
			response.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
			response.Text = "AI AI: Gerando código para '" .. prompt .. "'...\n(ARKHER AI v1 - 3.98M params - local)"
			response.TextColor3 = Color3.new(1,1,1)
			response.TextSize = 10
			response.Font = Enum.Font.Gotham
			response.TextWrapped = true
			response.TextXAlignment = Enum.TextXAlignment.Left
			response.Parent = aiChat

			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = response

			task.delay(1, function()
				response.Text = "AI AI: Pronto! Sugestão:\nlocal inventory = {}\nfunction inventory:AddItem(item)\n  table.insert(self.items, item)\nend\n-- Gerado por ARKHER AI v1"
				response.Size = UDim2.new(1, -10, 0, 100)
			end)
		end
	end
end

function MonacoPro:UpdateStatusBar()
	if not self.frame then return end
	local container = self.frame:FindFirstChild("MonacoProContainer")
	local statusBar = container and container:FindFirstChild("StatusBar")
	if statusBar then
		local left = statusBar:FindFirstChild("StatusBar") or statusBar:FindFirstChild("Left")
		-- Update errors count
		local right = statusBar:FindFirstChild("RightStatus")
		if right then
			right.Text = string.format("AI ARKHER AI v1: Ready | %s%d errors |  Plugins: %d | %s", #self.errors &gt; 0 and "Error " or "Success ", #self.errors, #self.plugins, self.language)
		end
	end
end

function MonacoPro:InsertAutocomplete(item: any)
	if not self.textBox then return end
	local text = self.textBox.Text
	local lastWord = string.match(text, "([%w_%.:]+)$")
	if lastWord then
		local newText = string.gsub(text, "([%w_%.:]+)$", item.insertText)
		newText = string.gsub(newText, "%$%d", "")
		newText = string.gsub(newText, "%${%d+:?(.-)}", "%1")
		self.textBox.Text = newText
		self.code = newText
		print("[Arkher MonacoPro] Inserted:", item.label, "Plugin:", item.plugin, "AI:", tostring(item.ai))
	end
end

function MonacoPro:SetLanguage(langId: string)
	self.language = langId
	self:LoadAutocompletePro()
	self:CheckErrorsPro()
	print("[Arkher MonacoPro] Language -&gt;", langId)
end

function MonacoPro:SetCode(code: string)
	self.code = code
	if self.textBox then self.textBox.Text = code end
	self:UpdateLineNumbers()
	self:CheckErrorsPro()
end

function MonacoPro:GetCode(): string return self.code end
function MonacoPro:GetErrors(): { any } return self.errors end

function MonacoPro:TogglePlugin(pluginId: string)
	self.enabledPlugins[pluginId] = not self.enabledPlugins[pluginId]
	print("[Arkher MonacoPro] Plugin", pluginId, "-&gt;", self.enabledPlugins[pluginId] and "ON" or "OFF")
end

function MonacoPro:GetStats()
	return {
		language = self.language,
		theme = self.theme.name,
		errors = #self.errors,
		pluginsTotal = #self.plugins,
		pluginsEnabled = (function() local c=0 for _,v in self.enabledPlugins do if v then c+=1 end end return c end)(),
		aiSuggestions = #self.aiSuggestions,
		snippets = #self.snippets,
		message = "MonacoPro - VS Code level + 25 plugins + ARKHER AI v1 Copilot + Themes + Minimap + Vim + Emmet",
	}
end

return MonacoPro
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX8974f16e3bc67e59">
    <Properties>
      <string name="Name">PythonService</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 1.5 - PythonService - Suporte Python 3.14 no Roblox
-- Transpila Python -&gt; Luau + executa via backend

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PythonTranspiler = require(ReplicatedStorage.Arkher.Scripting.PythonTranspiler)
local LanguageSupport = require(ReplicatedStorage.Arkher.Scripting.LanguageSupport)

local PythonService = {}
PythonService.__index = PythonService

function PythonService.new(backendUrl: string?)
	return setmetatable({
		backendUrl = backendUrl or "http://localhost:3000",
		transpiler = PythonTranspiler.new(),
		executionCache = {},
	}, PythonService)
end

function PythonService:SetBackendUrl(url: string)
	self.backendUrl = url
end

function PythonService:TranspileLocal(pythonCode: string): (string?, string?)
	return self.transpiler:Transpile(pythonCode)
end

function PythonService:TranspileViaBackend(pythonCode: string, styleProfile: string?): (string?, string?)
	print("[Arkher PythonService] Transpiling via backend -", #pythonCode, "bytes")

	-- Fase 1.5 mock, Fase 2 real com HttpService

	--[[
	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = self.backendUrl .. "/api/python/transpile",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				pythonCode = pythonCode,
				styleProfile = styleProfile,
			})
		})
	end)

	if success and response.Success then
		local data = HttpService:JSONDecode(response.Body)
		return data.luauCode, nil
	else
		return nil, "Backend transpile failed"
	end
	]]

	-- Mock: usa transpiler local
	return self:TranspileLocal(pythonCode)
end

function PythonService:Execute(pythonCode: string): (string?, string?)
	-- Valida
	local valid, err = self.transpiler:ValidatePython(pythonCode)
	if not valid then
		return nil, err
	end

	-- Tenta transpilar e executar como Luau
	local luauCode, transpileErr = self:TranspileLocal(pythonCode)
	if not luauCode then
		return nil, "Transpile failed: " .. (transpileErr or "unknown")
	end

	-- Executa Luau transpilado em sandbox
	local func, loadErr = loadstring(luauCode)
	if not func then
		return nil, "Luau load failed: " .. tostring(loadErr)
	end

	-- Sandbox simples
	local sandbox = {
		print = function(...)
			print("[Python-&gt;Luau]", ...)
		end,
		math = math,
		string = string,
		table = table,
		Vector3 = Vector3,
		Color3 = Color3,
		CFrame = CFrame,
	}

	setfenv(func, setmetatable(sandbox, { __index = _G }))

	local success, result = pcall(func)
	if not success then
		return nil, "Execution failed: " .. tostring(result)
	end

	print("[Arkher PythonService] Executed Python via Luau transpile")

	return "Executed successfully via Luau transpile", nil
end

function PythonService:ExecuteViaBackend(pythonCode: string): (string?, string?)
	print("[Arkher PythonService] Executing via backend Python 3.14 -", #pythonCode, "bytes")

	-- Fase 2: Roda Python real no backend

	--[[
	local success, response = pcall(function()
		return HttpService:RequestAsync({
			Url = self.backendUrl .. "/api/python/execute",
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({
				pythonCode = pythonCode,
				timeout = 5000,
			})
		})
	end)

	if success and response.Success then
		local data = HttpService:JSONDecode(response.Body)
		return data.output, data.errors ~= "" and data.errors or nil
	else
		return nil, "Backend execution failed"
	end
	]]

	-- Mock
	return self:Execute(pythonCode)
end

function PythonService:GenerateFromPrompt(prompt: string, styleProfile: string?): string?
	print("[Arkher PythonService] AI Generate Python - Prompt:", prompt)

	-- Em produção chama backend /api/python/generate com IA

	local template = string.format([[
# Generated by Arkher AI - Python 3.14
# Prompt: %s
# Style: %s

from arkher import Entity, Component, World
from arkher import Vector3, Color3

def main():
    """%s"""
    print(f"Executando: %s")
    
    world = World.current()
    
    # AI will generate code based on prompt here
    # Example for coin system:
    coin = Entity.new("GoldCoin")
    coin.add_component(Component.Transform(
        position=Vector3(0, 5, 0)
    ))
    coin.add_component(Component.Render(
        material="Neon",
        color=Color3.from_rgb(255, 215, 0)
    ))
    world.add_entity(coin)
    print(f"Criado {coin.name}!")

if __name__ == "__main__":
    main()
]], prompt, styleProfile or "realistic", prompt, prompt)

	return template
end

function PythonService:GetExample(): string
	local lang = LanguageSupport.GetLanguage("python")
	return lang and lang.example or "# Python example"
end

return PythonService
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXf2a9031ba9668c6c">
    <Properties>
      <string name="Name">SandboxVM</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 2 - SandboxVM - VM segura para rodar scripts do usuário
-- Não pode dar game:Shutdown() ou acessar coisas perigosas

local SandboxVM = {}
SandboxVM.__index = SandboxVM

-- Whitelist de funções/globals permitidos
SandboxVM.Whitelist = {
	-- Math
	math = true,
	string = true,
	table = true,
	Vector3 = true,
	Vector2 = true,
	Color3 = true,
	CFrame = true,
	UDim2 = true,
	Enum = true,

	-- Roblox safe
	Instance = true,
	workspace = true,
	game = true, -- mas com metatable protegida

	-- Arkher
	Entity = true,
	Component = true,
	World = true,

	-- Safe globals
	print = true,
	warn = true,
	wait = true,
	task = true,
	tick = true,
	time = true,
	os = true, -- mas só time, date, etc (não execute)

	-- Python compat
	Range = true,
	len = true,
}

-- Blacklist - nunca permitir
SandboxVM.Blacklist = {
	"getfenv",
	"setfenv",
	"loadstring",
	"require", -- só permitir require de módulos Arkher
	"game:Shutdown",
	"game:GetService", -- vamos controlar
	"HttpService",
	"DataStoreService",
	"MarketplaceService",
	"TeleportService",
}

function SandboxVM.new()
	return setmetatable({
		sandboxEnv = {},
		executionCount = 0,
		maxExecutionTime = 5, -- 5 segundos max por script
		maxMemory = 50 * 1024 * 1024, -- 50MB
	}, SandboxVM)
end

function SandboxVM:CreateSandbox(player: Player?): { [string]: any }
	-- Cria ambiente sandbox seguro

	local env: { [string]: any } = {}

	-- Copia whitelist
	env.math = math
	env.string = string
	env.table = table
	env.Vector3 = Vector3
	env.Vector2 = Vector2
	env.Color3 = Color3
	env.CFrame = CFrame
	env.UDim2 = UDim2
	env.Enum = Enum
	env.print = function(...)
		print("[Sandbox]", ...)
	end
	env.warn = function(...)
		warn("[Sandbox]", ...)
	end
	env.wait = task.wait
	env.task = task
	env.tick = tick
	env.time = time
	env.os = {
		time = os.time,
		date = os.date,
		clock = os.clock,
		difftime = os.difftime,
	}

	-- Game protegido
	env.game = setmetatable({}, {
		__index = function(_, key)
			if key == "Players" then
				return game:GetService("Players")
			elseif key == "Workspace" then
				return workspace
			elseif key == "ReplicatedStorage" then
				return game:GetService("ReplicatedStorage")
			elseif key == "RunService" then
				return game:GetService("RunService")
			else
				warn("[Sandbox] Blocked access to game." .. tostring(key))
				return nil
			end
		end,
		__newindex = function()
			warn("[Sandbox] Cannot modify game")
		end,
	})

	env.workspace = workspace
	env.Instance = Instance

	-- Arkher API
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	pcall(function()
		env.Entity = require(ReplicatedStorage.Arkher.ECS.Entity)
		env.Component = require(ReplicatedStorage.Arkher.ECS.Component)
		env.World = require(ReplicatedStorage.Arkher.ECS.World)
	end)

	-- Python compat
	env.Range = function(n)
		local t = {}
		for i=0,n-1 do table.insert(t, i) end
		return t
	end

	env.len = function(t)
		if type(t) == "string" then return #t end
		if type(t) == "table" then return #t end
		return 0
	end

	-- Player se tiver
	if player then
		env.player = player
		env.LocalPlayer = player
	end

	-- Metatable que bloqueia acesso a globals não whitelistados
	setmetatable(env, {
		__index = function(_, key)
			if SandboxVM.Whitelist[key] then
				return _G[key]
			else
				warn("[Sandbox] Blocked access to global:", key)
				return nil
			end
		end,
	})

	self.sandboxEnv = env
	return env
end

function SandboxVM:CheckBlacklist(code: string): (boolean, string?)
	-- Verifica se código contém blacklist

	for _, blocked in SandboxVM.Blacklist do
		if string.find(code, blocked, 1, true) then
			-- Exceção: permite game:GetService se for Players, Workspace, etc (já filtrado no metatable)
			if blocked == "game:GetService" then
				-- Deixa passar, metatable vai filtrar
			else
				return false, "Blocked keyword found: " .. blocked
			end
		end
	end

	-- Verifica loadstring, require suspeito
	if string.find(code, "require%(%d+%)") then
		return false, "Blocked: require with asset ID (possible virus)"
	end

	if string.find(code, "getfenv") or string.find(code, "setfenv") then
		return false, "Blocked: getfenv/setfenv not allowed"
	end

	return true, nil
end

function SandboxVM:Execute(code: string, player: Player?, timeout: number?): (boolean, any)
	-- Executa código em sandbox com timeout

	timeout = timeout or self.maxExecutionTime

	-- Checa blacklist
	local allowed, reason = self:CheckBlacklist(code)
	if not allowed then
		warn("[Sandbox] Blocked execution:", reason)
		return false, reason
	end

	-- Cria sandbox
	local env = self:CreateSandbox(player)

	-- Compila
	local func, loadErr = loadstring(code)
	if not func then
		warn("[Sandbox] Load error:", loadErr)
		return false, "Load error: " .. tostring(loadErr)
	end

	setfenv(func, env)

	-- Executa com timeout
	self.executionCount += 1

	local completed = false
	local success, result

	task.spawn(function()
		success, result = pcall(func)
		completed = true
	end)

	-- Espera com timeout
	local start = os.clock()
	while not completed and os.clock() - start &lt; timeout do
		task.wait(0.1)
	end

	if not completed then
		warn("[Sandbox] Execution timeout after", timeout, "seconds")
		return false, "Execution timeout"
	end

	if not success then
		warn("[Sandbox] Runtime error:", result)
		return false, "Runtime error: " .. tostring(result)
	end

	print("[Sandbox] Executed successfully -", #code, "bytes - Player:", player and player.Name or "server")

	return true, result
end

function SandboxVM:ExecuteWithResult(code: string, player: Player?): { success: boolean, result: any?, error: string?, logs: { string } }
	local logs: { string } = {}

	-- Captura prints
	local oldPrint = print
	local capturedEnv = self:CreateSandbox(player)
	capturedEnv.print = function(...)
		local msg = table.concat({...}, " ")
		table.insert(logs, msg)
		oldPrint("[Sandbox]", msg)
	end

	local func, loadErr = loadstring(code)
	if not func then
		return { success = false, error = "Load error: " .. tostring(loadErr), logs = logs }
	end

	setfenv(func, capturedEnv)

	local success, result = pcall(func)

	if not success then
		return { success = false, error = tostring(result), logs = logs }
	end

	return { success = true, result = result, logs = logs }
end

function SandboxVM:GetStats(): { [string]: any }
	return {
		executionCount = self.executionCount,
		maxExecutionTime = self.maxExecutionTime,
		maxMemoryMB = self.maxMemory / 1024 / 1024,
		whitelistCount = 0, -- conta
		blacklistCount = #SandboxVM.Blacklist,
	}
end

return SandboxVM
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX8fd5766cc69def9d">
    <Properties>
      <string name="Name">ScriptEditor</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 2 - ScriptEditor Pro - Monaco + Visual + Python 3.14 + AI + Debugger + Sandbox

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LanguageSupport = require(ReplicatedStorage.Arkher.Scripting.LanguageSupport)
local MonacoEditor = require(script.Parent.MonacoEditor)
local VisualScripting = require(script.Parent.VisualScripting)
local SandboxVM = require(ReplicatedStorage.Arkher.Scripting.SandboxVM)
local Debugger = require(script.Parent.Debugger)
local Shell = require(script.Parent.Parent.UI.Shell)

local ScriptEditor = {}
ScriptEditor.__index = ScriptEditor

function ScriptEditor.new(pythonService: any)
	return setmetatable({
		pythonService = pythonService,
		sandbox = SandboxVM.new(),
		currentLanguage = "luau" :: string,
		frame = nil :: Frame?,
		monaco = nil :: any,
		visual = nil :: any,
		debugger = nil :: any,
		aiPromptBox = nil :: TextBox?,
		editorContainer = nil :: Frame?,
	}, ScriptEditor)
end

function ScriptEditor:Init(parent: Frame)
	self.frame = parent

	local header = Instance.new("Frame")
	header.Name = "ScriptHeader"
	header.Size = UDim2.new(1, 0, 0, 40)
	header.BackgroundColor3 = Shell.Colors.panelLight
	header.Parent = parent

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0, 120, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "Script Script Pro"
	title.TextColor3 = Shell.Colors.text
	title.TextSize = 11
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = header

	local languages = {
		{ id = "luau", name = " Luau", color = Shell.Colors.accent },
		{ id = "python", name = "Python Python 3.14", color = Color3.fromRGB(55, 118, 171) },
		{ id = "visual", name = " Visual", color = Color3.fromRGB(0, 200, 100) },
		{ id = "ai", name = "AI AI Gen", color = Color3.fromRGB(255, 180, 0) },
	}

	for i, lang in languages do
		local btn = Instance.new("TextButton")
		btn.Name = lang.id .. "Btn"
		btn.Size = UDim2.new(0, 90, 0, 28)
		btn.Position = UDim2.new(0, 130 + (i-1)*95, 0, 6)
		btn.BackgroundColor3 = lang.id == self.currentLanguage and lang.color or Shell.Colors.panel
		btn.Text = lang.name
		btn.TextColor3 = Shell.Colors.text
		btn.TextSize = 9
		btn.Font = Enum.Font.Gotham
		btn.Parent = header

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn

		btn.MouseButton1Click:Connect(function()
			self:SetLanguage(lang.id)
			for _, other in header:GetChildren() do
				if other:IsA("TextButton") and other.Name:find("Btn") and other.Name ~= "RunBtn" then
					other.BackgroundColor3 = Shell.Colors.panel
				end
			end
			btn.BackgroundColor3 = lang.color
		end)
	end

	local runBtn = Instance.new("TextButton")
	runBtn.Name = "RunBtn"
	runBtn.Size = UDim2.new(0, 60, 0, 28)
	runBtn.Position = UDim2.new(1, -70, 0, 6)
	runBtn.BackgroundColor3 = Shell.Colors.success
	runBtn.Text = "Play Run"
	runBtn.TextColor3 = Color3.new(1,1,1)
	runBtn.TextSize = 11
	runBtn.Font = Enum.Font.GothamBold
	runBtn.Parent = header

	local runCorner = Instance.new("UICorner")
	runCorner.CornerRadius = UDim.new(0, 6)
	runCorner.Parent = runBtn

	runBtn.MouseButton1Click:Connect(function()
		self:RunCode()
	end)

	local aiFrame = Instance.new("Frame")
	aiFrame.Name = "AIPromptFrame"
	aiFrame.Size = UDim2.new(1, -20, 0, 50)
	aiFrame.Position = UDim2.new(0, 10, 0, 50)
	aiFrame.BackgroundColor3 = Shell.Colors.background
	aiFrame.Visible = false
	aiFrame.Parent = parent

	local aiCorner = Instance.new("UICorner")
	aiCorner.CornerRadius = UDim.new(0, 6)
	aiCorner.Parent = aiFrame

	local aiLabel = Instance.new("TextLabel")
	aiLabel.Size = UDim2.new(0, 80, 1, 0)
	aiLabel.BackgroundTransparency = 1
	aiLabel.Text = "AI Prompt:"
	aiLabel.TextColor3 = Shell.Colors.text
	aiLabel.TextSize = 11
	aiLabel.Font = Enum.Font.GothamBold
	aiLabel.Parent = aiFrame

	local aiBox = Instance.new("TextBox")
	aiBox.Name = "AIPromptBox"
	aiBox.Size = UDim2.new(1, -160, 0, 30)
	aiBox.Position = UDim2.new(0, 80, 0, 10)
	aiBox.BackgroundColor3 = Shell.Colors.panelLight
	aiBox.PlaceholderText = "Ex: cria moeda que gira e dá 10 coins (IA ajuda em Luau/Python/Visual)"
	aiBox.Text = ""
	aiBox.TextColor3 = Shell.Colors.text
	aiBox.TextSize = 11
	aiBox.Font = Enum.Font.Gotham
	aiBox.ClearTextOnFocus = false
	aiBox.Parent = aiFrame

	local aiBoxCorner = Instance.new("UICorner")
	aiBoxCorner.CornerRadius = UDim.new(0, 4)
	aiBoxCorner.Parent = aiBox

	local aiGenBtn = Instance.new("TextButton")
	aiGenBtn.Size = UDim2.new(0, 60, 0, 30)
	aiGenBtn.Position = UDim2.new(1, -70, 0, 10)
	aiGenBtn.BackgroundColor3 = Shell.Colors.accent
	aiGenBtn.Text = "Format Gerar"
	aiGenBtn.TextColor3 = Color3.new(1,1,1)
	aiGenBtn.TextSize = 11
	aiGenBtn.Font = Enum.Font.GothamBold
	aiGenBtn.Parent = aiFrame

	local aiGenCorner = Instance.new("UICorner")
	aiGenCorner.CornerRadius = UDim.new(0, 4)
	aiGenCorner.Parent = aiGenBtn

	aiGenBtn.MouseButton1Click:Connect(function()
		local prompt = aiBox.Text
		if prompt ~= "" then
			self:GenerateWithAI(prompt)
		end
	end)

	self.aiPromptBox = aiBox

	local editorContainer = Instance.new("Frame")
	editorContainer.Name = "EditorContainer"
	editorContainer.Size = UDim2.new(1, -20, 0.6, -20)
	editorContainer.Position = UDim2.new(0, 10, 0, 50)
	editorContainer.BackgroundTransparency = 1
	editorContainer.Parent = parent

	self.editorContainer = editorContainer

	local monacoFrame = Instance.new("Frame")
	monacoFrame.Name = "MonacoFrame"
	monacoFrame.Size = UDim2.new(1, 0, 1, 0)
	monacoFrame.BackgroundTransparency = 1
	monacoFrame.Parent = editorContainer

	self.monaco = MonacoEditor.new(self.currentLanguage)
	self.monaco:Init(monacoFrame, self:GetDefaultCode(self.currentLanguage))

	local visualFrame = Instance.new("Frame")
	visualFrame.Name = "VisualFrame"
	visualFrame.Size = UDim2.new(1, 0, 1, 0)
	visualFrame.BackgroundTransparency = 1
	visualFrame.Visible = false
	visualFrame.Parent = editorContainer

	self.visual = VisualScripting.new()
	self.visual:Init(visualFrame)

	local debuggerFrame = Instance.new("Frame")
	debuggerFrame.Name = "DebuggerFrame"
	debuggerFrame.Size = UDim2.new(1, -20, 0.4, -10)
	debuggerFrame.Position = UDim2.new(0, 10, 0.6, 50)
	debuggerFrame.BackgroundTransparency = 1
	debuggerFrame.Parent = parent

	self.debugger = Debugger.new()
	self.debugger:Init(debuggerFrame)

	print("[Arkher ScriptEditor Pro] Initialized - Monaco VS Code + Visual Blockly + Python 3.14 + Sandbox + Debugger - Fase 2")
end

function ScriptEditor:GetDefaultCode(langId: string): string
	local lang = LanguageSupport.GetLanguage(langId :: any)
	return lang and lang.example or "-- Código aqui"
end

function ScriptEditor:SetLanguage(langId: string)
	self.currentLanguage = langId
	print("[Arkher ScriptEditor] Language -&gt;", langId)

	if self.editorContainer then
		local monacoFrame = self.editorContainer:FindFirstChild("MonacoFrame")
		local visualFrame = self.editorContainer:FindFirstChild("VisualFrame")

		if langId == "visual" then
			if monacoFrame then monacoFrame.Visible = false end
			if visualFrame then visualFrame.Visible = true end
		else
			if monacoFrame then monacoFrame.Visible = true end
			if visualFrame then visualFrame.Visible = false end

			if self.monaco then
				self.monaco:SetLanguage(langId)
				self.monaco:SetCode(self:GetDefaultCode(langId))
			end
		end
	end

	if self.frame then
		local aiFrame = self.frame:FindFirstChild("AIPromptFrame")
		if aiFrame then
			aiFrame.Visible = langId == "ai"

			if self.editorContainer then
				if langId == "ai" then
					self.editorContainer.Position = UDim2.new(0, 10, 0, 110)
					self.editorContainer.Size = UDim2.new(1, -20, 0.6, -20)
				else
					self.editorContainer.Position = UDim2.new(0, 10, 0, 50)
					self.editorContainer.Size = UDim2.new(1, -20, 0.6, -20)
				end
			end
		end
	end
end

function ScriptEditor:RunCode()
	if not self.monaco or not self.debugger then return end

	local code = ""

	if self.currentLanguage == "visual" then
		if self.visual then
			code = self.visual:GenerateCode()
		end
	else
		code = self.monaco:GetCode()
	end

	print("[Arkher ScriptEditor] Running", self.currentLanguage, "-", #code, "bytes")

	self.debugger:Log("Rodando " .. self.currentLanguage .. " - " .. #code .. " bytes", "info", "Editor")

	task.spawn(function()
		if self.currentLanguage == "luau" then
			local result = self.sandbox:ExecuteWithResult(code, game.Players.LocalPlayer)

			for _, log in result.logs do
				self.debugger:Log(log, "info", "Luau")
			end

			if result.success then
				self.debugger:LogSuccess("Luau executado com sucesso!", "Luau")
			else
				self.debugger:LogError(result.error or "Unknown error", "Luau")
			end

		elseif self.currentLanguage == "python" then
			if self.pythonService then
				local luauCode, err = self.pythonService:TranspileLocal(code)

				if not luauCode then
					self.debugger:LogError("Transpile falhou: " .. tostring(err), "Python 3.14")
					return
				end

				self.debugger:Log("Transpilado Python -&gt; Luau - " .. #luauCode .. " bytes", "info", "Python 3.14")

				local result = self.sandbox:ExecuteWithResult(luauCode, game.Players.LocalPlayer)

				for _, log in result.logs do
					self.debugger:Log(log, "info", "Python 3.14")
				end

				if result.success then
					self.debugger:LogSuccess("Python 3.14 executado via Luau Sandbox!", "Python 3.14")
				else
					self.debugger:LogError(result.error or "Python error", "Python 3.14")
				end
			end

		elseif self.currentLanguage == "visual" then
			local result = self.sandbox:ExecuteWithResult(code, game.Players.LocalPlayer)

			for _, log in result.logs do
				self.debugger:Log(log, "info", "Visual")
			end

			if result.success then
				self.debugger:LogSuccess("Visual script executado!", "Visual Blockly")
			else
				self.debugger:LogError(result.error or "Visual error", "Visual")
			end

		elseif self.currentLanguage == "ai" then
			self.debugger:Log("Modo AI Gen - Use prompt acima e clique Gerar", "warn", "AI")
		end
	end)
end

function ScriptEditor:GenerateWithAI(prompt: string)
	if not self.monaco or not self.debugger then return end

	self.debugger:Log("IA gerando código para: " .. prompt, "info", "AI")

	task.spawn(function()
		local generated = ""
		local lowerPrompt = string.lower(prompt)

		if string.find(lowerPrompt, "moeda") or string.find(lowerPrompt, "coin") then
			if self.currentLanguage == "python" or self.currentLanguage == "ai" then
				generated = self.pythonService and self.pythonService:GenerateFromPrompt(prompt, "realistic") or "# Python coin system"
			else
				generated = string.format([[
-- Gerado por Arkher AI - Prompt: %s
-- IA ajuda em tudo: modelo, anim, terreno, script - Fase 2 com Sandbox seguro

local coin = script.Parent
local Players = game:GetService("Players")

local function onTouch(hit)
    local player = Players:GetPlayerFromCharacter(hit.Parent)
    if player then
        local leaderstats = player:FindFirstChild("leaderstats")
        if leaderstats then
            local coins = leaderstats:FindFirstChild("Coins")
            if coins then
                coins.Value += 10
                print("Deu 10 coins para " .. player.Name)
                local sparkle = Instance.new("ParticleEmitter")
                sparkle.Parent = coin
                task.wait(0.2)
                coin:Destroy()
            end
        end
    end
end

game:GetService("RunService").Heartbeat:Connect(function(dt)
    coin.CFrame *= CFrame.Angles(0, math.rad(100) * dt, 0)
end)

coin.Touched:Connect(onTouch)
print("Moeda criada por Arkher AI - Prompt: %s - Sandbox seguro")
]], prompt, prompt)
			end
		elseif string.find(lowerPrompt, "carro") or string.find(lowerPrompt, "car") then
			generated = [[
-- Gerado por Arkher AI - Sistema de carro com Python 3.14 + Luau - Fase 2
-- Prompt: ]] .. prompt .. [[

from arkher import Entity, Component, World

def create_car_system():
    car = Entity.new("SportsCar")
    car.add_component(Component.Transform(position=Vector3(0,5,0)))
    car.add_component(Component.Render(material="Metal", color=Color3.from_rgb(255,0,0)))
    car.add_component(Component.Physics(bodyType="dynamic", mass=1500))
    World.current().add_entity(car)
    print(f"Criado {car.name} com física realista!")

create_car_system()
]]
		else
			if self.currentLanguage == "python" then
				generated = string.format([[
# Gerado por Arkher AI - Python 3.14 - Fase 2 Sandbox
# Prompt: %s

from arkher import Entity, Component, World

def main():
    print(f"Executando: %s")
    world = World.current()
    print(f"Mundo tem {len(world.entities)} entidades - 15GB support")

if __name__ == "__main__":
    main()
]], prompt, prompt)
			else
				generated = "-- Gerado por Arkher AI para: " .. prompt .. "\nprint('Hello from AI Fase 2: " .. prompt .. "')\n-- IA ajuda em tudo: modelo, terreno, anim, script - Sandbox seguro"
			end
		end

		task.wait(1.2)

		if self.monaco then
			self.monaco:SetCode(generated)
		end

		self.debugger:LogSuccess("IA gerou " .. #generated .. " bytes! Clique Play Run - Sandbox seguro", "AI")

		print("[Arkher ScriptEditor] AI generated", #generated, "bytes for:", prompt)
	end)
end

function ScriptEditor:GetCode(): string
	if self.currentLanguage == "visual" and self.visual then
		return self.visual:GenerateCode()
	elseif self.monaco then
		return self.monaco:GetCode()
	else
		return ""
	end
end

return ScriptEditor
</ProtectedString>
    </Properties>
