  <Item class="ModuleScript" referent="RBXccd9d9d04eef704e">
    <Properties>
      <string name="Name">Component</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Python API - Component wrappers

local ComponentModule = require(script.Parent.Parent.Parent.ECS.Component)

local Component = {}

function Component.Transform(position: Vector3?, rotation: Vector3?, scale: Vector3?): any
	return ComponentModule.Transform(position, rotation, scale)
end

function Component.Render(material: Enum.Material?, color: Color3?): any
	return ComponentModule.Render(material, color)
end

function Component.Physics(bodyType: string?): any
	return ComponentModule.Physics(bodyType)
end

function Component.ScriptComponent(source: string?, isServer: boolean?): any
	return ComponentModule.ScriptComponent(source, isServer)
end

return Component
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBXf9c690374746847b">
    <Properties>
      <string name="Name">Entity</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Python API - Entity wrapper para Python
-- Permite usar Entity.new em Python: Entity.new("Coin")

local EntityModule = require(script.Parent.Parent.Parent.ECS.Entity)

local Entity = {}

function Entity.new(name: string, parentId: string?): any
	local entity = EntityModule.new(name, parentId)

	-- Adiciona métodos Python-style (snake_case)
	entity.add_component = function(self, compName: string, data: any)
		EntityModule.AddComponent(self, compName, data)
	end

	entity.get_component = function(self, compName: string)
		return EntityModule.GetComponent(self, compName)
	end

	entity.has_component = function(self, compName: string)
		return EntityModule.HasComponent(self, compName)
	end

	entity.add_tag = function(self, tag: string)
		EntityModule.AddTag(self, tag)
	end

	return entity
end

return Entity
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX8623a3438a595570">
    <Properties>
      <string name="Name">World</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Python API - World wrapper

local WorldModule = require(script.Parent.Parent.Parent.ECS.World)

local World = {}
World._current = nil

function World.new(): any
	local world = WorldModule.new()

	world.add_entity = function(self, entity: any)
		return WorldModule.AddEntity(self, entity)
	end

	world.remove_entity = function(self, entityId: string)
		return WorldModule.RemoveEntity(self, entityId)
	end

	world.get_entity = function(self, entityId: string)
		return WorldModule.GetEntity(self, entityId)
	end

	world.query_components = function(self, ...)
		return WorldModule.QueryComponents(self, ...)
	end

	World._current = world
	return world
end

function World.current(): any
	return World._current
end

return World
</ProtectedString>
    </Properties>
  </Item>
