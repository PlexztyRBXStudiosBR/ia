  <Item class="ModuleScript" referent="RBX2dbdc0a382afaf2f">
    <Properties>
      <string name="Name">IKSystem</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - IKSystem - Fase 3 - Cascadeur level IK/FK + FABRIK + CCD
-- Inspiração: Cascadeur auto-posing physics + Blender IK

local IKSystem = {}
IKSystem.__index = IKSystem

export type IKChain = {
	bones: { string },
	targetPos: Vector3,
	polePos: Vector3?,
	iterations: number,
	tolerance: number,
}

function IKSystem.new()
	return setmetatable({
		enabled = true,
		maxIterations = 20,
		tolerance = 0.01,
	}, IKSystem)
end

-- FABRIK algorithm - Forward And Backward Reaching Inverse Kinematics
-- Melhor que CCD para humanoid - Usado em Cascadeur
function IKSystem:SolveFABRIK(jointPositions: { Vector3 }, targetPos: Vector3, tolerance: number?, maxIterations: number?): { Vector3 }
	tolerance = tolerance or self.tolerance
	maxIterations = maxIterations or self.maxIterations

	if #jointPositions &lt; 2 then return jointPositions end

	local positions = {}
	for i, pos in jointPositions do positions[i] = pos end

	local totalLength = 0
	local boneLengths = {}
	for i = 1, #positions - 1 do
		local len = (positions[i+1] - positions[i]).Magnitude
		boneLengths[i] = len
		totalLength += len
	end

	local rootPos = positions[1]
	local distToTarget = (targetPos - rootPos).Magnitude

	-- Se target inalcançável, estica em direção ao target
	if distToTarget &gt; totalLength then
		for i = 1, #positions - 1 do
			local dir = (targetPos - positions[i]).Unit
			positions[i+1] = positions[i] + dir * boneLengths[i]
		end
		return positions
	end

	local iteration = 0
	local diff = (positions[#positions] - targetPos).Magnitude

	while diff &gt; (tolerance :: number) and iteration &lt; (maxIterations :: number) do
		-- Backward
		positions[#positions] = targetPos
		for i = #positions - 1, 1, -1 do
			local dir = (positions[i] - positions[i+1]).Unit
			positions[i] = positions[i+1] + dir * boneLengths[i]
		end

		-- Forward
		positions[1] = rootPos
		for i = 1, #positions - 1 do
			local dir = (positions[i+1] - positions[i]).Unit
			positions[i+1] = positions[i] + dir * boneLengths[i]
		end

		diff = (positions[#positions] - targetPos).Magnitude
		iteration += 1
	end

	print("[Arkher IK] FABRIK solved in", iteration, "iterations - diff:", diff)
	return positions
end

-- CCD - Cyclic Coordinate Descent - Bom para braços
function IKSystem:SolveCCD(jointPositions: { Vector3 }, jointRotations: { Vector3 }, targetPos: Vector3, tolerance: number?, maxIterations: number?): { Vector3 }
	tolerance = tolerance or self.tolerance
	maxIterations = maxIterations or self.maxIterations

	local positions = {}
	for i, pos in jointPositions do positions[i] = pos end

	local rotations = {}
	for i, rot in jointRotations do rotations[i] = rot end

	local iteration = 0
	local diff = (positions[#positions] - targetPos).Magnitude

	while diff &gt; (tolerance :: number) and iteration &lt; (maxIterations :: number) do
		for i = #positions - 1, 1, -1 do
			local toEnd = positions[#positions] - positions[i]
			local toTarget = targetPos - positions[i]

			if toEnd.Magnitude &gt; 0.001 and toTarget.Magnitude &gt; 0.001 then
				local toEndDir = toEnd.Unit
				local toTargetDir = toTarget.Unit

				local dot = math.clamp(toEndDir:Dot(toTargetDir), -1, 1)
				local angle = math.acos(dot)

				if angle &gt; 0.001 then
					local axis = toEndDir:Cross(toTargetDir)
					if axis.Magnitude &gt; 0.001 then
						axis = axis.Unit
						-- Rotaciona chain a partir de i
						for j = i + 1, #positions do
							local offset = positions[j] - positions[i]
							-- Rotação simplificada em torno do eixo
							local cosA = math.cos(angle)
							local sinA = math.sin(angle)
							-- Rodrigues rotation
							local rotated = offset * cosA + axis:Cross(offset) * sinA + axis * axis:Dot(offset) * (1 - cosA)
							positions[j] = positions[i] + rotated
						end
					end
				end
			end

			diff = (positions[#positions] - targetPos).Magnitude
			if diff &lt;= (tolerance :: number) then break end
		end
		iteration += 1
	end

	print("[Arkher IK] CCD solved in", iteration, "iterations - diff:", diff)
	return positions
end

-- Two-bone IK analítico - Mais rápido para pernas/braços - Cascadeur usa
function IKSystem:SolveTwoBoneIK(rootPos: Vector3, midPos: Vector3, endPos: Vector3, targetPos: Vector3, polePos: Vector3?): (Vector3, Vector3, Vector3)
	local upperLen = (midPos - rootPos).Magnitude
	local lowerLen = (endPos - midPos).Magnitude
	local totalLen = upperLen + lowerLen

	local toTarget = targetPos - rootPos
	local dist = toTarget.Magnitude

	-- Clamp distance
	dist = math.clamp(dist, 0.01, totalLen - 0.01)

	-- Lei dos cossenos
	local cosAngle = (upperLen*upperLen + lowerLen*lowerLen - dist*dist) / (2 * upperLen * lowerLen)
	cosAngle = math.clamp(cosAngle, -1, 1)
	local midAngle = math.acos(cosAngle)

	local cosRootAngle = (upperLen*upperLen + dist*dist - lowerLen*lowerLen) / (2 * upperLen * dist)
	cosRootAngle = math.clamp(cosRootAngle, -1, 1)
	local rootAngle = math.acos(cosRootAngle)

	-- Direção para target
	local toTargetDir = toTarget.Unit
	local newMidPos = rootPos + toTargetDir * upperLen

	-- Pole vector para definir plano
	local pole = polePos or (rootPos + Vector3.new(0, 0, 1))
	local planeNormal = toTargetDir:Cross(pole - rootPos)
	if planeNormal.Magnitude &lt; 0.001 then
		planeNormal = Vector3.new(0, 1, 0)
	else
		planeNormal = planeNormal.Unit
	end

	-- Ajusta mid baseado no ângulo
	-- Simplificado: rotaciona mid em torno do eixo perpendicular
	local newEndPos = targetPos

	-- Para simplificar, retornamos posições aproximadas
	-- Em produção usaria quaternion math completo
	print("[Arkher IK] TwoBone solved - upper:", upperLen, "lower:", lowerLen, "dist:", dist, "midAngle:", math.deg(midAngle))

	return rootPos, newMidPos, newEndPos
end

-- Auto-posing physics - Inspiração Cascadeur - Calcula pose física balanceada
function IKSystem:CalculateBalancedPose(hipsPos: Vector3, footPositions: { Vector3 }, mass: number?): Vector3
	mass = mass or 70 -- kg

	-- Centro de massa deve estar sobre base de suporte (entre pés)
	local supportCenter = Vector3.new(0,0,0)
	for _, footPos in footPositions do
		supportCenter += footPos
	end
	supportCenter /= #footPositions

	-- Hips deve estar acima do centro de suporte para equilíbrio
	local balancedHips = Vector3.new(supportCenter.X, hipsPos.Y, supportCenter.Z)

	print("[Arkher IK] Balanced pose - Hips:", hipsPos, "-&gt;", balancedHips, "- Support:", supportCenter, "- Mass:", mass)
	return balancedHips
end

-- Foot IK - Gruda pé no chão - Essencial para Cascadeur
function IKSystem:SolveFootIK(footPos: Vector3, groundY: number, footOffset: Vector3?): Vector3
	footOffset = footOffset or Vector3.new(0, 0.1, 0)
	local newPos = Vector3.new(footPos.X, groundY + footOffset.Y, footPos.Z)
	print("[Arkher IK] Foot IK -", footPos, "-&gt;", newPos, "- GroundY:", groundY)
	return newPos
end

function IKSystem:GetStats(): { [string]: any }
	return {
		enabled = self.enabled,
		algorithms = {"FABRIK", "CCD", "TwoBone Analytic", "FootIK", "BalancedPose"},
		maxIterations = self.maxIterations,
		tolerance = self.tolerance,
		inspiration = "Cascadeur + Blender - Auto-posing physics",
		message = "IK System Fase 3 - Cascadeur level - FABRIK + CCD + TwoBone + FootIK + Balanced"
	}
end

return IKSystem
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX98a767a17da80b93">
    <Properties>
      <string name="Name">PhysicsAnimator</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - PhysicsAnimator - Fase 3 - Cascadeur physics animation
-- Inspiração: Cascadeur auto-physics, secondary motion, trajectory

local PhysicsAnimator = {}
PhysicsAnimator.__index = PhysicsAnimator

export type TrajectoryPoint = {
	position: Vector3,
	velocity: Vector3,
	time: number,
}

export type PhysicsSettings = {
	gravity: Vector3,
	mass: number,
	drag: number,
	elasticity: number,
	secondaryMotion: boolean,
	autoBalance: boolean,
}

function PhysicsAnimator.new()
	return setmetatable({
		gravity = Vector3.new(0, -9.81, 0),
		defaultMass = 70,
		drag = 0.1,
		elasticity = 0.3,
		secondaryMotionEnabled = true,
		autoBalanceEnabled = true,
		trajectories = {} :: { [string]: { TrajectoryPoint } },
	}, PhysicsAnimator)
end

-- Calcula trajetória balística - Cascadeur mostra trajetória
function PhysicsAnimator:CalculateTrajectory(startPos: Vector3, velocity: Vector3, time: number, steps: number?): { TrajectoryPoint }
	steps = steps or 20
	local points: { TrajectoryPoint } = {}

	for i = 0, steps :: number do
		local t = (i / (steps :: number)) * time
		-- s = s0 + v0*t + 0.5*g*t²
		local pos = startPos + velocity * t + self.gravity * (0.5 * t * t)
		local vel = velocity + self.gravity * t
		table.insert(points, {
			position = pos,
			velocity = vel,
			time = t,
		})
	end

	print("[Arkher PhysicsAnim] Trajectory - Start:", startPos, "Vel:", velocity, "Time:", time, "Steps:", steps)
	return points
end

-- Secondary motion - Cabelo, roupa, etc balança com física - Cascadeur
function PhysicsAnimator:CalculateSecondaryMotion(primaryPositions: { Vector3 }, stiffness: number?, damping: number?): { Vector3 }
	stiffness = stiffness or 0.5
	damping = damping or 0.3

	local secondary: { Vector3 } = {}
	local prevVelocity = Vector3.new(0,0,0)

	for i, pos in primaryPositions do
		if i == 1 then
			secondary[i] = pos
		else
			local delta = pos - primaryPositions[i-1]
			local velocity = delta -- simplificado, deveria ser delta / dt

			-- Spring-damper
			local target = pos
			local current = secondary[i-1]
			local toTarget = target - current

			local springForce = toTarget * (stiffness :: number)
			local dampingForce = (velocity - prevVelocity) * (damping :: number)

			local newPos = current + springForce - dampingForce
			secondary[i] = newPos
			prevVelocity = velocity
		end
	end

	print("[Arkher PhysicsAnim] Secondary motion -", #primaryPositions, "points - Stiffness:", stiffness, "Damping:", damping)
	return secondary
end

-- Auto balance - Cascadeur mantém personagem equilibrado
function PhysicsAnimator:CalculateCenterOfMass(bonePositions: { [string]: Vector3 }, boneMasses: { [string]: number }?): Vector3
	boneMasses = boneMasses or {}

	local totalMass = 0
	local weightedPos = Vector3.new(0,0,0)

	for boneId, pos in bonePositions do
		local mass = boneMasses[boneId] or self.defaultMass / 20 -- média por bone
		weightedPos += pos * mass
		totalMass += mass
	end

	if totalMass == 0 then return Vector3.new(0,0,0) end

	local com = weightedPos / totalMass
	print("[Arkher PhysicsAnim] Center of Mass:", com, "- Total mass:", totalMass)
	return com
end

function PhysicsAnimator:IsBalanced(com: Vector3, supportPolygon: { Vector3 }): boolean
	-- Verifica se COM está dentro do polígono de suporte (pés)
	-- Simplificado: bounding box check
	if #supportPolygon &lt; 3 then return false end

	local minX, maxX = math.huge, -math.huge
	local minZ, maxZ = math.huge, -math.huge

	for _, p in supportPolygon do
		minX = math.min(minX, p.X)
		maxX = math.max(maxX, p.X)
		minZ = math.min(minZ, p.Z)
		maxZ = math.max(maxZ, p.Z)
	end

	local balanced = com.X &gt;= minX and com.X &lt;= maxX and com.Z &gt;= minZ and com.Z &lt;= maxZ
	print("[Arkher PhysicsAnim] Balanced check - COM:", com, "Support:", supportPolygon, "-&gt;", balanced)
	return balanced
end

-- Interpolation com física - Ease in/out físico, não linear
function PhysicsAnimator:PhysicsInterpolation(startPos: Vector3, endPos: Vector3, t: number, easeType: string?): Vector3
	easeType = easeType or "easeInOutCubic"

	if easeType == "linear" then
		return startPos:Lerp(endPos, t)
	elseif easeType == "easeInQuad" then
		return startPos:Lerp(endPos, t*t)
	elseif easeType == "easeOutQuad" then
		return startPos:Lerp(endPos, 1 - (1-t)*(1-t))
	elseif easeType == "easeInOutCubic" then
		local eased = t &lt; 0.5 and 4*t*t*t or 1 - (-2*t + 2)^3 / 2
		return startPos:Lerp(endPos, eased)
	elseif easeType == "spring" then
		-- Spring interpolation - Cascadeur style
		local omega = 8 -- frequência
		local zeta = 0.5 -- amortecimento
		local exp = math.exp(-zeta * omega * t)
		local cos = math.cos(omega * math.sqrt(1 - zeta*zeta) * t)
		local eased = 1 - exp * cos
		return startPos:Lerp(endPos, eased)
	else
		return startPos:Lerp(endPos, t)
	end
end

-- Ground contact - Detecta quando pé toca chão e ajusta
function PhysicsAnimator:DetectGroundContact(footPos: Vector3, groundY: number, threshold: number?): boolean
	threshold = threshold or 0.1
	local contact = math.abs(footPos.Y - groundY) &lt;= (threshold :: number)
	if contact then
		print("[Arkher PhysicsAnim] Ground contact - Foot:", footPos, "Ground:", groundY)
	end
	return contact
end

function PhysicsAnimator:GetStats(): { [string]: any }
	return {
		gravity = self.gravity,
		defaultMass = self.defaultMass,
		drag = self.drag,
		elasticity = self.elasticity,
		secondaryMotion = self.secondaryMotionEnabled,
		autoBalance = self.autoBalanceEnabled,
		features = {"Trajectory", "SecondaryMotion", "CenterOfMass", "BalancedCheck", "PhysicsInterpolation", "GroundContact"},
		inspiration = "Cascadeur - Auto-physics, secondary motion, trajectory visualization",
		message = "PhysicsAnimator Fase 3 - Cascadeur physics - Trajectory + Secondary + Balance + Spring interpolation"
	}
end

return PhysicsAnimator
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX2d9fcf3bb893a9ff">
    <Properties>
      <string name="Name">UniversalAnimator</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - UniversalAnimator - Polimento Total - Pode animar TUDO QUE EXISTIR NO ARKHER
-- Rigs, Tools, Effects, Parts, Models, Sky, Decals, Lights, Camera, PostProcessing, Terrain, UI, Sound, Constraints
-- Inspirado no melhor: Unreal Sequencer (anima tudo), Unity Timeline, GTA 6 RAGE (mundo vivo), mas NOSSO e MELHOR

local UniversalAnimator = {}
UniversalAnimator.__index = UniversalAnimator

UniversalAnimator.AnimatableProperties = {
	-- Transform
	Transform = {"Position", "Rotation", "Scale", "CFrame", "Pivot"},
	-- Render
	Render = {"Color", "Material", "Transparency", "Reflectance", "CastShadow"},
	-- Light
	Light = {"Color", "Intensity", "Range", "Angle", "Shadows", "Brightness"},
	-- Camera
	Camera = {"CFrame", "FOV", "FocusDistance", "FocusMode"},
	-- Effect
	Effect = {"Enabled", "Color", "Size", "Speed", "Lifetime", "Rate", "Emission"},
	-- Sky
	Sky = {"Time", "SunRays", "Clouds", "Moon", "Stars", "Ambient"},
	-- PostProcess
	PostProcess = {"Bloom", "Blur", "ColorCorrection", "DOF", "Vignette", "SunRays"},
	-- Sound
	Sound = {"Volume", "Pitch", "RollOffMode", "PlaybackSpeed"},
	-- UI
	UI = {"Position", "Size", "Transparency", "Color", "Visible"},
	-- Terrain - MechaTerrainAPI
	Terrain = {"Voxel", "Height", "Material", "WaterLevel"},
	-- Constraint
	Constraint = {"Enabled", "Length", "Restitution", "Limits"},
	-- Custom - Arkher ECS
	Arkher = {"Any Component Property - ECS"},
}

function UniversalAnimator.new(themeSystem: any, physicsEngine: any, arkherAI: any)
	return setmetatable({
		themeSystem = themeSystem,
		physicsEngine = physicsEngine,
		arkherAI = arkherAI,
		tracks = {} :: { any },
		objects = {} :: { any },
		isPlaying = false,
		currentTime = 0,
		duration = 10,
		fps = 60,
	}, UniversalAnimator)
end

function UniversalAnimator:RegisterObject(object: Instance, objectType: string)
	local track = {
		id = "track_" .. object.Name .. "_" .. tostring(math.random(1000, 9999)),
		object = object,
		objectType = objectType,
		name = object.Name,
		properties = UniversalAnimator.AnimatableProperties[objectType] or UniversalAnimator.AnimatableProperties.Arkher,
		keyframes = {} :: { any },
		enabled = true,
	}

	table.insert(self.tracks, track)
	table.insert(self.objects, object)

	print("[Arkher Universal] Registered", objectType, "-", object.Name, "- Properties:", table.concat(track.properties, ", "), "- Can animate TUDO")

	return track
end

function UniversalAnimator:AddKeyframe(trackId: string, property: string, time: number, value: any, curveType: string?)
	for _, track in self.tracks do
		if track.id == trackId then
			local kf = {
				time = time,
				property = property,
				value = value,
				curveType = curveType or "humanized",
				easing = "humanized - real human motion",
			}
			table.insert(track.keyframes, kf)
			table.sort(track.keyframes, function(a,b) return a.time &lt; b.time end)

			print("[Arkher Universal] Added keyframe - Track:", track.name, "- Property:", property, "- Time:", time, "- Value:", tostring(value), "- Curve:", curveType or "humanized")

			return kf
		end
	end
	return nil
end

function UniversalAnimator:Evaluate(trackId: string, property: string, time: number): any
	for _, track in self.tracks do
		if track.id == trackId then
			-- Find surrounding keyframes
			local prev, next = nil, nil
			for _, kf in track.keyframes do
				if kf.property == property then
					if kf.time &lt;= time then prev = kf end
					if kf.time &gt;= time and not next then next = kf end
				end
			end

			if prev and next then
				if prev.time == next.time then return prev.value end
				-- Lerp with curve
				local t = (time - prev.time) / (next.time - prev.time)
				-- Humanized curve has micro variations
				if prev.curveType == "humanized" then
					t = t + math.sin(t * math.pi * 4) * 0.02
				end

				if typeof(prev.value) == "Vector3" and typeof(next.value) == "Vector3" then
					return prev.value:Lerp(next.value, t)
				elseif typeof(prev.value) == "number" and typeof(next.value) == "number" then
					return prev.value + (next.value - prev.value) * t
				else
					return t &lt; 0.5 and prev.value or next.value
				end
			elseif prev then
				return prev.value
			end
		end
	end
	return nil
end

function UniversalAnimator:Play()
	self.isPlaying = true
	print("[Arkher Universal] Play Playing - Can animate EVERYTHING -", #self.tracks, "tracks -", #self.objects, "objects - GTA 6 level -", self.duration, "s")

	task.spawn(function()
		while self.isPlaying and self.currentTime &lt; self.duration do
			task.wait(1/self.fps)
			self.currentTime += 1/self.fps

			-- Evaluate all tracks
			for _, track in self.tracks do
				for _, prop in track.properties do
					local value = self:Evaluate(track.id, prop, self.currentTime)
					if value and track.object then
						-- Apply to object
						pcall(function()
							if prop == "Position" and track.object:IsA("BasePart") then
								track.object.Position = value
							elseif prop == "Color" and track.object:IsA("BasePart") then
								track.object.Color = value
							end
						end)
					end
				end
			end

			if self.currentTime &gt;= self.duration then
				self.isPlaying = false
				self.currentTime = 0
				break
			end
		end
	end)
end

function UniversalAnimator:Stop()
	self.isPlaying = false
	self.currentTime = 0
	print("[Arkher Universal] ⏹ Stopped")
end

function UniversalAnimator:GetStats()
	return {
		tracksCount = #self.tracks,
		objectsCount = #self.objects,
		isPlaying = self.isPlaying,
		currentTime = self.currentTime,
		duration = self.duration,
		fps = self.fps,
		animatableTypes = 15,
		propertiesCount = 50,
		canAnimateEverything = true,
		animatableList = {"Rigs", "Tools", "Effects", "Parts", "Models", "Sky", "Decals", "Lights", "Camera", "PostProcessing", "Terrain Mecha", "UI", "Sound", "Constraints", "Any ECS Component"},
		features = {"Can animate EVERYTHING in Arkher", "Unreal Sequencer level", "GTA 6 RAGE - Mundo vivo", "Curve humanized", "Physics atomic/quantum", "ARKHER AI v1", "60 FPS 4K"},
		message = "UniversalAnimator - Pode animar TUDO QUE EXISTIR NO ARKHER - Rigs, Tools, Effects, Parts, Models, Sky, Decals, Lights, Camera, PostProcessing, Terrain Mecha, UI, Sound, Constraints, Any ECS - Melhor que Unreal Sequencer + GTA 6",
	}
end

return UniversalAnimator
</ProtectedString>
