  <Item class="ModuleScript" referent="RBX5823416a2d2a1341">
    <Properties>
      <string name="Name">Gizmo</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Gizmo System - Move, Rotate, Scale igual Blender/Unreal
-- Funciona com Mouse, Touch, Gamepad, VR

local Gizmo = {}
Gizmo.__index = Gizmo

export type GizmoMode = "Translate" | "Rotate" | "Scale" | "Universal"
export type GizmoAxis = "X" | "Y" | "Z" | "XY" | "YZ" | "XZ" | "All"

function Gizmo.new()
	return setmetatable({
		mode = "Translate" :: GizmoMode,
		activeAxis = nil :: GizmoAxis?,
		isDragging = false,
		targetEntityId = nil :: string?,
		snapEnabled = true,
		snapValue = 1, -- 1 stud
		rotationSnap = 15, -- 15 graus
		scaleSnap = 0.1,
		handles = {},
	}, Gizmo)
end

function Gizmo:SetMode(mode: GizmoMode)
	self.mode = mode
	print("[Arkher Gizmo] Mode set to", mode)
end

function Gizmo:SetTarget(entityId: string?)
	self.targetEntityId = entityId
	if entityId then
		print("[Arkher Gizmo] Target set to", entityId)
	else
		print("[Arkher Gizmo] Target cleared")
	end
end

function Gizmo:StartDrag(axis: GizmoAxis, startPos: Vector3)
	self.activeAxis = axis
	self.isDragging = true
	self.dragStartPos = startPos
	print("[Arkher Gizmo] Start drag on axis", axis, "from", startPos)
end

function Gizmo:UpdateDrag(currentPos: Vector3): Vector3?
	if not self.isDragging or not self.activeAxis then return nil end

	local delta = currentPos - self.dragStartPos

	-- Aplica snap
	if self.snapEnabled then
		if self.mode == "Translate" then
			delta = Vector3.new(
				math.round(delta.X / self.snapValue) * self.snapValue,
				math.round(delta.Y / self.snapValue) * self.snapValue,
				math.round(delta.Z / self.snapValue) * self.snapValue
			)
		elseif self.mode == "Rotate" then
			-- Snap rotação
			delta = Vector3.new(
				math.round(delta.X / self.rotationSnap) * self.rotationSnap,
				math.round(delta.Y / self.rotationSnap) * self.rotationSnap,
				math.round(delta.Z / self.rotationSnap) * self.rotationSnap
			)
		end
	end

	-- Filtra por eixo
	if self.activeAxis == "X" then
		delta = Vector3.new(delta.X, 0, 0)
	elseif self.activeAxis == "Y" then
		delta = Vector3.new(0, delta.Y, 0)
	elseif self.activeAxis == "Z" then
		delta = Vector3.new(0, 0, delta.Z)
	end

	return delta
end

function Gizmo:EndDrag()
	self.isDragging = false
	self.activeAxis = nil
	print("[Arkher Gizmo] End drag")
end

function Gizmo:CreateHandles(parent: Instance)
	-- Cria handles 3D no mundo (Partes com BillboardGui)
	-- Fase 1: Handles simples, Fase 2: Handles custom com EditableMesh

	local handlesFolder = Instance.new("Folder")
	handlesFolder.Name = "ArkherGizmoHandles"
	handlesFolder.Parent = parent

	local axes = {
		{axis = "X", color = Color3.fromRGB(255, 60, 60), pos = Vector3.new(4,0,0)},
		{axis = "Y", color = Color3.fromRGB(60, 255, 60), pos = Vector3.new(0,4,0)},
		{axis = "Z", color = Color3.fromRGB(60, 60, 255), pos = Vector3.new(0,0,4)},
	}

	for _, data in axes do
		local handle = Instance.new("Part")
		handle.Name = "Handle_" .. data.axis
		handle.Size = Vector3.new(0.5, 0.5, 4)
		handle.Color = data.color
		handle.Material = Enum.Material.Neon
		handle.Anchored = true
		handle.CanCollide = false
		handle.CFrame = CFrame.new(data.pos)
		handle.Parent = handlesFolder

		table.insert(self.handles, handle)
	end

	print("[Arkher Gizmo] Created 3D handles")
	return handlesFolder
end

function Gizmo:DestroyHandles()
	for _, handle in self.handles do
		if handle.Parent then
			handle:Destroy()
		end
	end
	self.handles = {}
end

return Gizmo
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX0ac6e65815c6fc05">
    <Properties>
      <string name="Name">PlacementController</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Fase 1 - PlacementController - Controla placement com mouse e touch

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local PlacementController = {}
PlacementController.__index = PlacementController

function PlacementController.new(buildingService: any, inputService: any)
	return setmetatable({
		buildingService = buildingService,
		inputService = inputService,
		isPlacing = false,
		lastTouchTime = 0,
		longPressThreshold = 0.5,
		longPressConnection = nil,
	}, PlacementController)
end

function PlacementController:Init()
	-- Mouse para PC
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self:OnMouseClick()
		end
	end)

	-- Touch para Mobile
	UserInputService.TouchTap:Connect(function(touches)
		if #touches == 1 then
			self:OnTouchTap(touches[1])
		end
	end)

	UserInputService.TouchLongPress:Connect(function(touches, state)
		if state == Enum.UserInputState.Begin then
			self:OnLongPress(touches[1])
		end
	end)

	-- Update preview todo frame
	game:GetService("RunService").RenderStepped:Connect(function()
		self:UpdatePreview()
	end)

	print("[Arkher Placement] Initialized - Mouse + Touch + LongPress")
end

function PlacementController:OnMouseClick()
	if self.buildingService.mode ~= "Place" then
		-- Modo Select: tenta selecionar entidade
		self:TrySelect()
		return
	end

	local result = self.buildingService:RaycastFromMouse()
	if result and result.Position then
		self.buildingService:PlaceBlockAt(result.Position)
		print("[Arkher Placement] Placed via mouse at", result.Position)
	end
end

function PlacementController:OnTouchTap(touchPos: Vector2)
	print("[Arkher Placement] Touch tap at", touchPos)

	if self.buildingService.mode ~= "Place" then
		self:TrySelectTouch(touchPos)
		return
	end

	local result = self.buildingService:RaycastFromTouch(touchPos)
	if result and result.Position then
		self.buildingService:PlaceBlockAt(result.Position)
		print("[Arkher Placement] Placed via touch at", result.Position)
	end
end

function PlacementController:OnLongPress(touchPos: Vector2)
	print("[Arkher Placement] Long press at", touchPos)

	-- Mostra radial menu no mobile
	if self.buildingService.mainController and self.buildingService.mainController.mobileUI then
		self.buildingService.mainController.mobileUI:ShowRadialMenu(touchPos)
	end
end

function PlacementController:TrySelect()
	local result = self.buildingService:RaycastFromMouse()
	if not result then
		self.buildingService:SelectEntity(nil)
		return
	end

	-- Verifica se acertou alguma part do ArkherWorld
	local hitPart = result.Instance
	if hitPart and hitPart.Parent and hitPart.Parent.Name == "ArkherWorld" then
		-- Tenta achar entityId pelo nome da part
		local entityId = self:FindEntityIdByPart(hitPart)
		if entityId then
			self.buildingService:SelectEntity(entityId)
			print("[Arkher Placement] Selected entity", entityId, "via mouse")
		end
	else
		self.buildingService:SelectEntity(nil)
	end
end

function PlacementController:TrySelectTouch(touchPos: Vector2)
	local result = self.buildingService:RaycastFromTouch(touchPos)
	if not result then
		self.buildingService:SelectEntity(nil)
		return
	end

	local hitPart = result.Instance
	if hitPart and hitPart.Parent and hitPart.Parent.Name == "ArkherWorld" then
		local entityId = self:FindEntityIdByPart(hitPart)
		if entityId then
			self.buildingService:SelectEntity(entityId)
			print("[Arkher Placement] Selected entity", entityId, "via touch")
		end
	else
		self.buildingService:SelectEntity(nil)
	end
end

function PlacementController:FindEntityIdByPart(part: Part): string?
	-- Procura entity pelo nome da part (que contém ID ou nome)
	-- Fase 1 simples: procura por nome

	for id, entity in self.buildingService.world.entities do
		if string.find(part.Name, entity.name) or part.Name:find(id:sub(1,8)) then
			return id
		end
	end

	-- Fallback: procura mais próximo
	local closestId = nil
	local closestDist = math.huge

	for id, entity in self.buildingService.world.entities do
		local transform = entity.components.Transform
		if transform then
			local dist = (transform.position - part.Position).Magnitude
			if dist &lt; closestDist and dist &lt; 10 then
				closestDist = dist
				closestId = id
			end
		end
	end

	return closestId
end

function PlacementController:UpdatePreview()
	if self.buildingService.mode ~= "Place" then return end

	local result: RaycastResult? = nil

	if self.buildingService.mainController and self.buildingService.mainController.input then
		local platform = self.buildingService.mainController.input:GetPlatform()
		if platform == "Mobile" then
			-- No mobile, preview segue último toque ou centro da tela
			local camera = Workspace.CurrentCamera
			if camera then
				local center = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
				result = self.buildingService:RaycastFromTouch(center)
			end
		else
			result = self.buildingService:RaycastFromMouse()
		end
	else
		result = self.buildingService:RaycastFromMouse()
	end

	self.buildingService:UpdatePreview(result)
end

return PlacementController
</ProtectedString>
    </Properties>
