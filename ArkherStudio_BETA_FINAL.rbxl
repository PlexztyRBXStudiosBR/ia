  <Item class="ModuleScript" referent="RBX541ee430ac011d4a">
    <Properties>
      <string name="Name">CascadeurController</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - CascadeurController - Fase 3 - Orquestra animator Cascadeur level
-- Junta RigData + IKSystem + PhysicsAnimator + AnimationEditor

local RigData = require(game:GetService("ReplicatedStorage").Arkher.Animation.RigData)
local AnimationData = require(game:GetService("ReplicatedStorage").Arkher.Animation.AnimationData)

local CascadeurController = {}
CascadeurController.__index = CascadeurController

function CascadeurController.new()
	local self = setmetatable({
		rig = nil :: RigData.Rig?,
		clip = nil :: AnimationData.AnimationClip?,
		ikSystem = nil :: any,
		physicsAnimator = nil :: any,
		editor = nil :: any,
		currentPose = {} :: { [string]: { position: Vector3, rotation: Vector3 } },
		isAutoPhysics = true,
		isAutoBalance = true,
	}, CascadeurController)

	-- Lazy require para evitar circular
	local IKSystem = require(script.Parent.IKSystem)
	local PhysicsAnimator = require(script.Parent.PhysicsAnimator)
	local AnimationEditor = require(script.Parent.AnimationEditor)

	self.ikSystem = IKSystem.new()
	self.physicsAnimator = PhysicsAnimator.new()
	self.editor = AnimationEditor.new()

	return self
end

function CascadeurController:Init(parent: Frame)
	self.editor:Init(parent)

	-- Cria rig humanoid padrão
	local rig = RigData.CreateHumanoidRig()
	self.rig = rig
	self.editor:LoadRig(rig)

	-- Cria clip idle padrão
	local clip = AnimationData.CreateIdle(rig.id)
	self.clip = clip
	self.editor:LoadClip(clip)

	-- Inicializa pose
	for boneId, bone in rig.bones do
		self.currentPose[boneId] = {
			position = bone.position,
			rotation = bone.rotation,
		}
	end

	print("[Arkher Cascadeur] Initialized - Rig:", rig.name, "- Clip:", clip.name, "- Fase 3 Cascadeur level")
end

function CascadeurController:CreateNewRig(rigType: string): RigData.Rig
	local rig: RigData.Rig
	if rigType == "quadruped" then
		rig = RigData.CreateQuadrupedRig()
	else
		rig = RigData.CreateHumanoidRig()
	end

	self.rig = rig
	self.editor:LoadRig(rig)

	-- Reset pose
	self.currentPose = {}
	for boneId, bone in rig.bones do
		self.currentPose[boneId] = {
			position = bone.position,
			rotation = bone.rotation,
		}
	end

	print("[Arkher Cascadeur] Created new rig", rigType, "- Bones:", rig.boneCount)
	return rig
end

function CascadeurController:CreateAnimation(name: string, duration: number, template: string?): AnimationData.AnimationClip
	if not self.rig then
		warn("[Arkher Cascadeur] No rig loaded")
		return AnimationData.new(name, duration, "no_rig")
	end

	local clip: AnimationData.AnimationClip
	if template == "walk" then
		clip = AnimationData.CreateWalkCycle(self.rig.id)
		clip.name = name
	elseif template == "idle" then
		clip = AnimationData.CreateIdle(self.rig.id)
		clip.name = name
	else
		clip = AnimationData.new(name, duration, self.rig.id)
	end

	self.clip = clip
	self.editor:LoadClip(clip)

	print("[Arkher Cascadeur] Created animation", name, "- Duration:", duration, "- Template:", template or "empty")
	return clip
end

-- Auto-posing - Cascadeur principal feature - IA sugere pose física
function CascadeurController:AutoPose(boneId: string, targetPos: Vector3, usePhysics: boolean?)
	usePhysics = usePhysics or self.isAutoPhysics

	if not self.rig then return end

	local bone = self.rig.bones[boneId]
	if not bone then return end

	-- Encontra chain IK se existir
	local chainIndex: number? = nil
	for i, chain in self.rig.ikChains do
		for _, bId in chain.bones do
			if bId == boneId then
				chainIndex = i
				break
			end
		end
		if chainIndex then break end
	end

	if chainIndex and self.ikSystem then
		-- Resolve IK
		local chain = self.rig.ikChains[chainIndex]
		local jointPositions: { Vector3 } = {}
		for _, bId in chain.bones do
			local pose = self.currentPose[bId]
			if pose then table.insert(jointPositions, pose.position) end
		end
		-- Adiciona end effector
		local endBone = self.rig.bones[chain.targetBone]
		if endBone and self.currentPose[chain.targetBone] then
			table.insert(jointPositions, self.currentPose[chain.targetBone].position)
		end

		if #jointPositions &gt;= 2 then
			local solved = self.ikSystem:SolveFABRIK(jointPositions, targetPos)

			-- Aplica solved positions
			for i, bId in chain.bones do
				if self.currentPose[bId] and solved[i] then
					self.currentPose[bId].position = solved[i]
				end
			end
			if self.currentPose[chain.targetBone] and solved[#solved] then
				self.currentPose[chain.targetBone].position = solved[#solved]
			end

			print("[Arkher Cascadeur] AutoPose IK solved for", boneId, "-&gt;", targetPos, "- Chain:", chainIndex)
		end
	else
		-- FK simples
		if self.currentPose[boneId] then
			self.currentPose[boneId].position = targetPos
			print("[Arkher Cascadeur] AutoPose FK for", boneId, "-&gt;", targetPos)
		end
	end

	-- Auto balance se habilitado
	if usePhysics and self.physicsAnimator and self.isAutoBalance then
		local footPositions = {}
		for _, footId in {"leftFoot", "rightFoot"} do
			if self.currentPose[footId] then
				table.insert(footPositions, self.currentPose[footId].position)
			end
		end

		if #footPositions &gt;= 2 and self.currentPose["hips"] then
			local balancedHips = self.ikSystem:CalculateBalancedPose(self.currentPose["hips"].position, footPositions)
			self.currentPose["hips"].position = balancedHips
			print("[Arkher Cascadeur] Auto balance - Hips adjusted to", balancedHips)
		end
	end

	-- Secondary motion
	if usePhysics and self.physicsAnimator then
		print("[Arkher Cascadeur] Secondary motion enabled - Hair, clothes physics")
	end
end

-- AI Pose - Gera pose de prompt - Cascadeur AI
function CascadeurController:AIGeneratePose(prompt: string): { [string]: { position: Vector3, rotation: Vector3 } }?
	print("[Arkher Cascadeur] AI Generate Pose - Prompt:", prompt)

	-- Mock: em produção chama backend /api/ai/pose com TripoSR + Cascadeur AI
	local poses: { [string]: { position: Vector3, rotation: Vector3 } } = {}

	if string.find(string.lower(prompt), "walk") or string.find(string.lower(prompt), "andar") then
		-- Pose de caminhada
		poses["leftUpperLeg"] = { position = Vector3.new(-0.1, 0.8, 0), rotation = Vector3.new(-20,0,0) }
		poses["rightUpperLeg"] = { position = Vector3.new(0.1, 0.8, 0), rotation = Vector3.new(20,0,0) }
		poses["leftUpperArm"] = { position = Vector3.new(-0.4, 1.5, 0), rotation = Vector3.new(20,0,0) }
		poses["rightUpperArm"] = { position = Vector3.new(0.4, 1.5, 0), rotation = Vector3.new(-20,0,0) }
	elseif string.find(string.lower(prompt), "jump") or string.find(string.lower(prompt), "pulo") then
		poses["hips"] = { position = Vector3.new(0, 1.5, 0), rotation = Vector3.new(0,0,0) }
		poses["leftUpperLeg"] = { position = Vector3.new(-0.1, 1.2, 0), rotation = Vector3.new(-40,0,0) }
		poses["rightUpperLeg"] = { position = Vector3.new(0.1, 1.2, 0), rotation = Vector3.new(-40,0,0) }
	else
		-- T-pose default
		poses["leftUpperArm"] = { position = Vector3.new(-0.4, 1.5, 0), rotation = Vector3.new(0,0,-90) }
		poses["rightUpperArm"] = { position = Vector3.new(0.4, 1.5, 0), rotation = Vector3.new(0,0,90) }
	end

	-- Aplica
	for boneId, pose in poses do
		if self.currentPose[boneId] then
			self.currentPose[boneId] = pose
		end
	end

	print("[Arkher Cascadeur] AI Pose generated -", prompt, "- Bones:", #poses)
	return poses
end

function CascadeurController:ExportAnimation(): string?
	if not self.editor then
		warn("[Arkher Cascadeur] No editor")
		return nil
	end

	return self.editor:ExportToRoblox()
end

function CascadeurController:GetStats(): { [string]: any }
	return {
		hasRig = self.rig ~= nil,
		hasClip = self.clip ~= nil,
		rigType = self.rig and self.rig.type or "none",
		rigBones = self.rig and self.rig.boneCount or 0,
		ikChains = self.rig and #self.rig.ikChains or 0,
		clipName = self.clip and self.clip.name or "none",
		clipDuration = self.clip and self.clip.duration or 0,
		keyframes = self.clip and #self.clip.keyframes or 0,
		autoPhysics = self.isAutoPhysics,
		autoBalance = self.isAutoBalance,
		ikSystem = self.ikSystem and self.ikSystem:GetStats() or {},
		physics = self.physicsAnimator and self.physicsAnimator:GetStats() or {},
		editor = self.editor and self.editor:GetStats() or {},
		inspiration = "Cascadeur - Auto-posing physics + IK/FK + Secondary motion + AI pose",
		message = "CascadeurController Fase 3 - Cascadeur level - Auto-posing + FABRIK + Physics + AI",
	}
end

return CascadeurController
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX7540704636a8cf0e">
    <Properties>
      <string name="Name">CurveEditorPro</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - CurveEditorPro - Polimento Total - Curve humanized editor nivel Unreal 6 e Cascadeur
-- Inspirado no melhor: Unreal 6 Curve Editor, Cascadeur Graph Editor, Blender Graph, Maya, Houdini
-- Mas NOSSO: humanized = real human motion from mocap + physics + IA trained - melhor que todos
-- Curve types: Bezier, Linear, Constant, Cubic, Elastic, Bounce, Humanized, Physics Based

local ThemeSystem = require(script.Parent.Parent.UI.ThemeSystem)

local CurveEditorPro = {}
CurveEditorPro.__index = CurveEditorPro

CurveEditorPro.CurvePresets = {
	-- Standard
	{ id = "linear", name = "Linear", icon = "Curve", description = "Linear - Straight - No easing", level = "Beginner", curve = "Linear", humanized = false },
	{ id = "easeIn", name = "Ease In", icon = "", description = "Ease In - Slow start", level = "Beginner", curve = "Bezier 0,0 0.5,0", humanized = false },
	{ id = "easeOut", name = "Ease Out", icon = "", description = "Ease Out - Slow end", level = "Beginner", curve = "Bezier 0.5,1 1,1", humanized = false },
	{ id = "easeInOut", name = "Ease In Out", icon = "Erosion", description = "Ease In Out - Smooth", level = "Beginner", curve = "Bezier 0.42,0 0.58,1", humanized = false },

	-- Advanced
	{ id = "cubic", name = "Cubic", icon = "〰️", description = "Cubic - Smooth cubic", level = "Intermediate", curve = "Cubic", humanized = false },
	{ id = "elastic", name = "Elastic", icon = "Rig", description = "Elastic - Bounce elastic - Spring", level = "Advanced", curve = "Elastic amplitude 1, period 0.3", humanized = false },
	{ id = "bounce", name = "Bounce", icon = "⚽", description = "Bounce - Ball bounce - Gravity", level = "Intermediate", curve = "Bounce", humanized = false },
	{ id = "back", name = "Back", icon = "Undo", description = "Back - Overshoot then back", level = "Advanced", curve = "Back overshoot 1.7", humanized = false },

	-- Humanized - NOSSO DIFERENCIAL - Real human motion
	{ id = "humanized_walk", name = "Humanized Walk", icon = "", description = "Humanized Walk - Real human walk from mocap + physics + IA", level = "Pro", curve = "Humanized walk cycle - 60 FPS mocap", humanized = true, aiTrained = true, mocap = true, physics = "Newtonian + muscle" },
	{ id = "humanized_run", name = "Humanized Run", icon = "", description = "Humanized Run - Real run - GTA 6 level", level = "Pro", curve = "Humanized run - Mocap + muscle + cloth", humanized = true, aiTrained = true, mocap = true, physics = "Newtonian + muscle + cloth" },
	{ id = "humanized_jump", name = "Humanized Jump", icon = "", description = "Humanized Jump - Real jump - Physics accurate", level = "Pro", curve = "Humanized jump - Gravity + muscle + balance", humanized = true, aiTrained = true, mocap = true, physics = "Newtonian + rigidbody" },
	{ id = "humanized_idle", name = "Humanized Idle", icon = "", description = "Humanized Idle - Breathing, micro movements - Real", level = "Pro", curve = "Humanized idle - Breathing + micro + balance", humanized = true, aiTrained = true, mocap = true, physics = "Thermodynamics + muscle" },
	{ id = "humanized_emotion", name = "Humanized Emotion", icon = "", description = "Humanized Emotion - Happy, Sad, Angry - Facial + body", level = "Pro", curve = "Humanized emotion - Facial + body + secondary", humanized = true, aiTrained = true, mocap = true, physics = "Muscle + softbody" },
	{ id = "humanized_gta6", name = "Humanized GTA 6", icon = "Motion", description = "Humanized GTA 6 - Rockstar level - Cinematic + acting", level = "Pro", curve = "Humanized GTA 6 - Acting + facial + lip sync + physics", humanized = true, aiTrained = true, mocap = true, physics = "All - Newtonian to Quantum - Backend IA" },
}

function CurveEditorPro.new(themeSystem: any, arkherAI: any)
	return setmetatable({
		themeSystem = themeSystem,
		arkherAI = arkherAI,
		curves = {} :: { any },
		selectedCurve = nil :: string?,
		selectedKeyframe = nil :: any,
		currentType = "humanized" :: string,
		frame = nil :: Frame?,
		graphView = nil :: Frame?,
		presetsPanel = nil :: Frame?,
		level = "Intermediate" :: string,
		humanizedEnabled = true,
		aiEnabled = true,
	}, CurveEditorPro)
end

function CurveEditorPro:Init(parent: Frame, level: string?)
	self.frame = parent
	self.level = level or "Intermediate"

	local colors = self.themeSystem:GetColors()

	-- Header
	local header = Instance.new("Frame")
	header.Name = "CurveHeader"
	header.Size = UDim2.new(1, 0, 0, 36)
	header.BackgroundColor3 = colors.panelLight
	header.Parent = parent

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.5, 0, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = self.level == "Beginner" and "Curve Motion Curves - Easy" or "Curve Curve Editor - Unreal 6 + Cascadeur - Humanized Pro"
	title.TextColor3 = colors.text
	title.TextSize = 11
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = header

	-- Curve type selector
	local typeBtn = Instance.new("TextButton")
	typeBtn.Name = "CurveTypeBtn"
	typeBtn.Size = UDim2.new(0, 140, 0, 24)
	typeBtn.Position = UDim2.new(1, -150, 0.5, -12)
	typeBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
	typeBtn.Text = " Humanized"
	typeBtn.TextColor3 = Color3.new(1,1,1)
	typeBtn.TextSize = 10
	typeBtn.Font = Enum.Font.GothamBold
	typeBtn.Parent = header

	local typeCorner = Instance.new("UICorner")
	typeCorner.CornerRadius = UDim.new(0, 4)
	typeCorner.Parent = typeBtn

	typeBtn.MouseButton1Click:Connect(function()
		self:CycleCurveType()
	end)

	-- Split: Graph + Presets
	local split = Instance.new("Frame")
	split.Name = "Split"
	split.Size = UDim2.new(1, 0, 1, -36)
	split.Position = UDim2.new(0, 0, 0, 36)
	split.BackgroundTransparency = 1
	split.Parent = parent

	-- Graph view 70%
	self.graphView = Instance.new("Frame")
	self.graphView.Name = "GraphView"
	self.graphView.Size = UDim2.new(0.7, -5, 1, -10)
	self.graphView.Position = UDim2.new(0, 5, 0, 5)
	self.graphView.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
	self.graphView.Parent = split

	local graphCorner = Instance.new("UICorner")
	graphCorner.CornerRadius = UDim.new(0, 8)
	graphCorner.Parent = self.graphView

	-- Grid
	for i = 0, 10 do
		local hLine = Instance.new("Frame")
		hLine.Size = UDim2.new(1, 0, 0, 1)
		hLine.Position = UDim2.new(0, 0, i/10, 0)
		hLine.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
		hLine.BorderSizePixel = 0
		hLine.Parent = self.graphView

		local vLine = Instance.new("Frame")
		vLine.Size = UDim2.new(0, 1, 1, 0)
		vLine.Position = UDim2.new(i/10, 0, 0, 0)
		vLine.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
		vLine.BorderSizePixel = 0
		vLine.Parent = self.graphView
	end

	-- Axes labels
	local xLabel = Instance.new("TextLabel")
	xLabel.Size = UDim2.new(1, 0, 0, 20)
	xLabel.Position = UDim2.new(0, 0, 1, -20)
	xLabel.BackgroundTransparency = 1
	xLabel.Text = "Time →"
	xLabel.TextColor3 = colors.textDim
	xLabel.TextSize = 10
	xLabel.Font = Enum.Font.Code
	xLabel.Parent = self.graphView

	local yLabel = Instance.new("TextLabel")
	yLabel.Size = UDim2.new(0, 20, 1, 0)
	yLabel.BackgroundTransparency = 1
	yLabel.Text = "Value →"
	yLabel.TextColor3 = colors.textDim
	yLabel.TextSize = 10
	yLabel.Font = Enum.Font.Code
	yLabel.Rotation = -90
	yLabel.Parent = self.graphView

	-- Curve visualization - humanized = real human motion
	local curveFrame = Instance.new("Frame")
	curveFrame.Name = "CurveVisualization"
	curveFrame.Size = UDim2.new(1, -40, 1, -40)
	curveFrame.Position = UDim2.new(0, 20, 0, 10)
	curveFrame.BackgroundTransparency = 1
	curveFrame.Parent = self.graphView

	-- Draw bezier curve - humanized has micro variations
	for i = 0, 100 do
		local t = i / 100
		local x = t
		local y
		if self.currentType == "humanized" then
			-- Humanized curve - real human motion has micro variations, breathing, etc
			y = t + math.sin(t * math.pi * 4) * 0.02 + math.sin(t * math.pi * 10) * 0.005 -- micro
		else
			y = t -- linear for now
		end

		local dot = Instance.new("Frame")
		dot.Size = UDim2.new(0, 3, 0, 3)
		dot.Position = UDim2.new(x, 0, y, 0)
		dot.BackgroundColor3 = self.currentType == "humanized" and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(255, 200, 0)
		dot.BorderSizePixel = 0
		dot.Parent = curveFrame

		local dotCorner = Instance.new("UICorner")
		dotCorner.CornerRadius = UDim.new(0, 1)
		dotCorner.Parent = dot
	end

	-- Keyframes
	for i = 1, 5 do
		local kf = Instance.new("TextButton")
		kf.Size = UDim2.new(0, 12, 0, 12)
		kf.Position = UDim2.new((i-1)/4, -6, 0.5 + math.sin((i-1)/4 * math.pi) * 0.3, -6)
		kf.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
		kf.Text = ""
		kf.Parent = curveFrame

		local kfCorner = Instance.new("UICorner")
		kfCorner.CornerRadius = UDim.new(0, 6)
		kfCorner.Parent = kf
	end

	-- Presets panel 30%
	self.presetsPanel = Instance.new("ScrollingFrame")
	self.presetsPanel.Name = "PresetsPanel"
	self.presetsPanel.Size = UDim2.new(0.3, -5, 1, -10)
	self.presetsPanel.Position = UDim2.new(0.7, 5, 0, 5)
	self.presetsPanel.BackgroundColor3 = colors.panel
	self.presetsPanel.ScrollBarThickness = 4
	self.presetsPanel.CanvasSize = UDim2.new(0, 0, 0, 0)
	self.presetsPanel.AutomaticCanvasSize = Enum.AutomaticSize.Y
	self.presetsPanel.Parent = split

	local presetsCorner = Instance.new("UICorner")
	presetsCorner.CornerRadius = UDim.new(0, 8)
	presetsCorner.Parent = self.presetsPanel

	local presetsHeader = Instance.new("TextLabel")
	presetsHeader.Size = UDim2.new(1, 0, 0, 24)
	presetsHeader.BackgroundColor3 = colors.panelLight
	presetsHeader.Text = "  Presets - Humanized Pro"
	presetsHeader.TextColor3 = colors.text
	presetsHeader.TextSize = 10
	presetsHeader.Font = Enum.Font.GothamBold
	presetsHeader.TextXAlignment = Enum.TextXAlignment.Left
	presetsHeader.Parent = self.presetsPanel

	local presetsLayout = Instance.new("UIListLayout")
	presetsLayout.Padding = UDim.new(0, 4)
	presetsLayout.Parent = self.presetsPanel

	self:CreatePresets()

	print("[Arkher Curve] Initialized - Unreal 6 + Cascadeur - Humanized Pro -", #CurveEditorPro.CurvePresets, "presets - Level:", self.level)
end

function CurveEditorPro:CreatePresets()
	if not self.presetsPanel then return end

	for _, child in self.presetsPanel:GetChildren() do
		if child:IsA("TextButton") or child:IsA("Frame") and child.Name:find("Preset_") then child:Destroy() end
	end

	local visiblePresets = {}
	for _, preset in CurveEditorPro.CurvePresets do
		if self.level == "Beginner" and preset.level == "Beginner" then
			table.insert(visiblePresets, preset)
		elseif self.level == "Intermediate" and (preset.level == "Beginner" or preset.level == "Intermediate") then
			table.insert(visiblePresets, preset)
		elseif self.level == "Advanced" or self.level == "Pro" then
			table.insert(visiblePresets, preset)
		end
	end

	for i, preset in visiblePresets do
		local btn = Instance.new("TextButton")
		btn.Name = "Preset_" .. preset.id
		btn.Size = UDim2.new(1, -10, 0, preset.humanized and 60 or 40)
		btn.BackgroundColor3 = preset.humanized and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(50, 50, 60)
		btn.Text = ""
		btn.LayoutOrder = i
		btn.Parent = self.presetsPanel

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn

		local icon = Instance.new("TextLabel")
		icon.Size = UDim2.new(0, 30, 0, 20)
		icon.Position = UDim2.new(0, 5, 0, 2)
		icon.BackgroundTransparency = 1
		icon.Text = preset.icon
		icon.TextSize = 16
		icon.Parent = btn

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -40, 0, 16)
		nameLabel.Position = UDim2.new(0, 35, 0, 2)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = preset.name .. (preset.humanized and " Format AI" or "")
		nameLabel.TextColor3 = Color3.new(1,1,1)
		nameLabel.TextSize = 10
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = btn

		local descLabel = Instance.new("TextLabel")
		descLabel.Size = UDim2.new(1, -10, 0, preset.humanized and 36 or 16)
		descLabel.Position = UDim2.new(0, 5, 0, 20)
		descLabel.BackgroundTransparency = 1
		descLabel.Text = preset.description
		descLabel.TextColor3 = Color3.fromRGB(200, 200, 220)
		descLabel.TextSize = 8
		descLabel.Font = Enum.Font.Gotham
		descLabel.TextXAlignment = Enum.TextXAlignment.Left
		descLabel.TextWrapped = true
		descLabel.Parent = btn

		btn.MouseButton1Click:Connect(function()
			self:ApplyPreset(preset.id)
		end)
	end
end

function CurveEditorPro:ApplyPreset(presetId: string)
	print("[Arkher Curve] Apply preset:", presetId)

	for _, preset in CurveEditorPro.CurvePresets do
		if preset.id == presetId then
			self.currentType = preset.humanized and "humanized" or preset.id
			print("[Arkher Curve] Applied:", preset.name, "- Humanized:", tostring(preset.humanized), "- AI Trained:", tostring(preset.aiTrained or false), "- Mocap:", tostring(preset.mocap or false), "- Physics:", preset.physics or preset.curve)

			if preset.humanized and self.arkherAI then
				print("[Arkher Curve] Humanized curve - Real human motion from mocap + physics + ARKHER AI v1 trained - GTA 6 level")
				local result = self.arkherAI:GenerateAnimation(preset.id, "humanoid", 2.0)
				print("[Arkher Curve] AI generated animation with humanized curve:", result.message)
			end

			break
		end
	end

	-- Refresh graph visualization
	if self.graphView then
		local curveVis = self.graphView:FindFirstChild("CurveVisualization")
		if curveVis then
			for _, child in curveVis:GetChildren() do child:Destroy() end

			for i = 0, 100 do
				local t = i / 100
				local y
				if self.currentType == "humanized" then
					y = t + math.sin(t * math.pi * 4) * 0.02 + math.sin(t * math.pi * 10) * 0.005
				else
					y = t
				end

				local dot = Instance.new("Frame")
				dot.Size = UDim2.new(0, 3, 0, 3)
				dot.Position = UDim2.new(t, 0, y, 0)
				dot.BackgroundColor3 = self.currentType == "humanized" and Color3.fromRGB(120, 80, 255) or Color3.fromRGB(255, 200, 0)
				dot.BorderSizePixel = 0
				dot.Parent = curveVis

				local dotCorner = Instance.new("UICorner")
				dotCorner.CornerRadius = UDim.new(0, 1)
				dotCorner.Parent = dot
			end
		end
	end
end

function CurveEditorPro:CycleCurveType()
	local types = {"linear", "bezier", "humanized", "physicsBased"}
	local idx = table.find(types, self.currentType) or 1
	local nextIdx = (idx % #types) + 1
	self.currentType = types[nextIdx]

	print("[Arkher Curve] Type -&gt;", self.currentType, "- Humanized = real human motion - Unreal 6 + Cascadeur + ARKHER AI v1")

	if self.frame then
		local header = self.frame:FindFirstChild("CurveHeader")
		local btn = header and header:FindFirstChild("CurveTypeBtn")
		if btn then
			btn.Text = self.currentType == "humanized" and " Humanized" or self.currentType == "physicsBased" and "Physics Physics" or "Curve " .. self.currentType
		end
	end

	self:ApplyPreset(self.currentType == "humanized" and "humanized_gta6" or "easeInOut")
end

function CurveEditorPro:GetStats()
	return {
		currentType = self.currentType,
		humanizedEnabled = self.humanizedEnabled,
		aiEnabled = self.aiEnabled,
		presetsCount = #CurveEditorPro.CurvePresets,
		level = self.level,
		features = {"Unreal 6 Curve Editor", "Cascadeur Graph", "Humanized - Real human motion mocap + physics + IA", "Physics Based", "60 FPS", "Micro variations", "Breathing", "GTA 6 level", "ARKHER AI v1"},
		message = "CurveEditorPro - Unreal 6 + Cascadeur - Humanized = real human motion - Mocap + physics + ARKHER AI v1 - Melhor que Unreal 6",
	}
end

return CurveEditorPro
</ProtectedString>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="RBX8dc96a88a5ee9b7a">
    <Properties>
      <string name="Name">CutsceneEditor</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - CutsceneEditor - Polimento Total - GTA 6 nivel cinematografica
-- Inspirado no melhor: Rockstar GTA 6 cutscene editor, Unreal Sequencer, Naughty Dog, CD Projekt
-- Mas NOSSO: melhor que GTA 6, com fisica real, IA, e pode animar TUDO
-- Features GTA 6: camera cuts, character acting, facial, lip sync, lighting, VFX, dialogue, subtitles, 60 FPS, 4K

local ThemeSystem = require(script.Parent.Parent.UI.ThemeSystem)

local CutsceneEditor = {}
CutsceneEditor.__index = CutsceneEditor

export type TrackType = "Camera" | "Character" | "Light" | "Effect" | "Audio" | "Dialogue" | "Subtitle" | "Terrain" | "PostProcess" | "Sky" | "Decal"

CutsceneEditor.TrackTemplates = {
	Camera = {
		name = "Camera",
		icon = "Viewport",
		color = Color3.fromRGB(100, 200, 255),
		properties = {"CFrame", "FOV", "FocusDistance", "FocusMode", "Shake", "DOF"},
		gta6Features = {"Cinematic camera cuts", "Dolly, Crane, Handheld", "Focus pull", "Camera shake - explosion", "FOV animation - tension"},
	},
	Character = {
		name = "Character",
		icon = "",
		color = Color3.fromRGB(255, 150, 100),
		properties = {"Position", "Rotation", "Animation", "Facial", "LipSync", "EyeTrack"},
		gta6Features = {"Acting - emotions", "Facial capture", "Lip sync - dialogue", "Eye tracking - looks at camera", "Secondary motion - hair, clothes"},
	},
	Light = {
		name = "Light",
		icon = "Tip",
		color = Color3.fromRGB(255, 220, 100),
		properties = {"Color", "Intensity", "Shadows", "Range", "Angle"},
		gta6Features = {"Cinematic lighting", "Time of day", "Mood - warm/cold", "Volumetric light", "Shadow animation"},
	},
	Effect = {
		name = "Effect",
		icon = "Format",
		color = Color3.fromRGB(255, 100, 200),
		properties = {"Emit", "Color", "Size", "Speed", "Lifetime"},
		gta6Features = {"Explosion, Fire, Smoke", "Weather - rain, fog", "Magic, Sparks", "Destruction - building collapse"},
	},
	Audio = {
		name = "Audio",
		icon = "",
		color = Color3.fromRGB(100, 255, 100),
		properties = {"Volume", "Pitch", "RollOff", "Effect"},
		gta6Features = {"Music - emotional", "SFX - explosion, footsteps", "Dialogue - voice", "Ambient - city, nature"},
	},
	Dialogue = {
		name = "Dialogue",
		icon = "Chat",
		color = Color3.fromRGB(100, 150, 255),
		properties = {"Text", "Voice", "Emotion", "LipSync"},
		gta6Features = {"Character dialogue", "Branching - choices", "Emotion - happy, sad, angry", "Lip sync - visemes"},
	},
	Subtitle = {
		name = "Subtitle",
		icon = "",
		color = Color3.fromRGB(200, 200, 200),
		properties = {"Text", "Position", "Color", "Size"},
		gta6Features = {"Subtitles - multi language", "Position - bottom, top", "Style - GTA 6 font"},
	},
	Terrain = {
		name = "Terrain",
		icon = "Terrain",
		color = Color3.fromRGB(100, 200, 100),
		properties = {"Height", "Material", "Erosion", "Water"},
		gta6Features = {"Terrain deformation - explosion crater", "Water - flood", "Erosion - time lapse"},
	},
	PostProcess = {
		name = "PostProcess",
		icon = "Style",
		color = Color3.fromRGB(200, 100, 255),
		properties = {"Bloom", "Blur", "ColorCorrection", "DOF", "Vignette"},
		gta6Features = {"Cinematic color grading", "Bloom - bright", "DOF - focus character", "Vignette - mood", "Chromatic aberration"},
	},
	Sky = {
		name = "Sky",
		icon = "",
		color = Color3.fromRGB(100, 150, 255),
		properties = {"Time", "Clouds", "Sun", "Moon", "Stars"},
		gta6Features = {"Day/night cycle", "Weather - cloudy, clear", "Sunset - golden hour", "Stars - night"},
	},
}

function CutsceneEditor.new(themeSystem: any, arkherAI: any)
	return setmetatable({
		themeSystem = themeSystem,
		arkherAI = arkherAI,
		cutscene = nil :: any,
		tracks = {} :: { any },
		currentTime = 0,
		duration = 30,
		fps = 60,
		isPlaying = false,
		selectedTrack = nil :: string?,
		selectedKeyframe = nil :: any,
		frame = nil :: Frame?,
		timeline = nil :: Frame?,
		viewport = nil :: Frame?,
		level = "Intermediate" :: string,
	}, CutsceneEditor)
end

function CutsceneEditor:Init(parent: Frame, level: string?)
	self.frame = parent
	self.level = level or "Intermediate"

	local colors = self.themeSystem:GetColors()

	-- Header - GTA 6 level
	local header = Instance.new("Frame")
	header.Name = "CutsceneHeader"
	header.Size = UDim2.new(1, 0, 0, 36)
	header.BackgroundColor3 = Color3.fromRGB(40, 20, 20)
	header.Parent = parent

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(0.5, 0, 1, 0)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = self.level == "Beginner" and "Motion My Movie - Easy" or "Motion Cutscene - GTA 6 + Unreal Sequencer - Cinematic"
	title.TextColor3 = Color3.new(1,1,1)
	title.TextSize = 11
	title.Font = Enum.Font.GothamBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = header

	-- Controls
	local controls = Instance.new("Frame")
	controls.Name = "Controls"
	controls.Size = UDim2.new(0.5, -10, 1, 0)
	controls.Position = UDim2.new(0.5, 0, 0, 0)
	controls.BackgroundTransparency = 1
	controls.Parent = header

	local playBtn = Instance.new("TextButton")
	playBtn.Name = "PlayBtn"
	playBtn.Size = UDim2.new(0, 60, 0, 24)
	playBtn.Position = UDim2.new(0, 0, 0.5, -12)
	playBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
	playBtn.Text = "Play Play"
	playBtn.TextColor3 = Color3.new(1,1,1)
	playBtn.TextSize = 10
	playBtn.Font = Enum.Font.GothamBold
	playBtn.Parent = controls

	local playCorner = Instance.new("UICorner")
	playCorner.CornerRadius = UDim.new(0, 4)
	playCorner.Parent = playBtn

	local exportBtn = Instance.new("TextButton")
	exportBtn.Name = "ExportBtn"
	exportBtn.Size = UDim2.new(0, 80, 0, 24)
	exportBtn.Position = UDim2.new(0, 70, 0.5, -12)
	exportBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 255)
	exportBtn.Text = "Motion Export 4K"
	exportBtn.TextColor3 = Color3.new(1,1,1)
	exportBtn.TextSize = 10
	exportBtn.Font = Enum.Font.GothamBold
	exportBtn.Parent = controls

	local exportCorner = Instance.new("UICorner")
	exportCorner.CornerRadius = UDim.new(0, 4)
	exportCorner.Parent = exportBtn

	-- Viewport + Tracks split
	local split = Instance.new("Frame")
	split.Name = "Split"
	split.Size = UDim2.new(1, 0, 1, -36)
	split.Position = UDim2.new(0, 0, 0, 36)
	split.BackgroundTransparency = 1
	split.Parent = parent

	-- Viewport 60% - preview cutscene
	self.viewport = Instance.new("Frame")
	self.viewport.Name = "CutsceneViewport"
	self.viewport.Size = UDim2.new(0.6, -5, 1, -10)
	self.viewport.Position = UDim2.new(0, 5, 0, 5)
	self.viewport.BackgroundColor3 = Color3.fromRGB(10, 10, 10)
	self.viewport.Parent = split

	local vpCorner = Instance.new("UICorner")
	vpCorner.CornerRadius = UDim.new(0, 8)
	vpCorner.Parent = self.viewport

	local vpLabel = Instance.new("TextLabel")
	vpLabel.Size = UDim2.new(1, 0, 0, 24)
	vpLabel.BackgroundColor3 = Color3.fromRGB(0,0,0)
	vpLabel.BackgroundTransparency = 0.5
	vpLabel.Text = "  Preview - GTA 6 Cinematic - 4K 60 FPS - Camera: Main - Time: 0.00s / 30s - ARKHER AI v1"
	vpLabel.TextColor3 = colors.textDim
	vpLabel.TextSize = 10
	vpLabel.Font = Enum.Font.Code
	vpLabel.TextXAlignment = Enum.TextXAlignment.Left
	vpLabel.Parent = self.viewport

	-- Timeline 40% - tracks GTA 6 level
	self.timeline = Instance.new("Frame")
	self.timeline.Name = "CutsceneTimeline"
	self.timeline.Size = UDim2.new(0.4, -5, 1, -10)
	self.timeline.Position = UDim2.new(0.6, 5, 0, 5)
	self.timeline.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
	self.timeline.Parent = split

	local tlCorner = Instance.new("UICorner")
	tlCorner.CornerRadius = UDim.new(0, 8)
	tlCorner.Parent = self.timeline

	local tlHeader = Instance.new("TextLabel")
	tlHeader.Size = UDim2.new(1, 0, 0, 24)
	tlHeader.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
	tlHeader.Text = "  Tracks - GTA 6 - Camera, Character, Light, Effect, Audio, Dialogue - 30s"
	tlHeader.TextColor3 = colors.text
	tlHeader.TextSize = 10
	tlHeader.Font = Enum.Font.GothamBold
	tlHeader.TextXAlignment = Enum.TextXAlignment.Left
	tlHeader.Parent = self.timeline

	local tracksScroll = Instance.new("ScrollingFrame")
	tracksScroll.Name = "TracksScroll"
	tracksScroll.Size = UDim2.new(1, -10, 1, -30)
	tracksScroll.Position = UDim2.new(0, 5, 0, 30)
	tracksScroll.BackgroundTransparency = 1
	tracksScroll.ScrollBarThickness = 4
	tracksScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	tracksScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	tracksScroll.Parent = self.timeline

	local tracksLayout = Instance.new("UIListLayout")
	tracksLayout.Padding = UDim.new(0, 4)
	tracksLayout.Parent = tracksScroll

	-- Create default tracks - GTA 6 level
	self:CreateDefaultTracks(tracksScroll)

	-- Create cutscene
	self.cutscene = {
		name = "Cutscene_GTA6_Main",
		duration = 30,
		fps = 60,
		resolution = "4K",
		tracks = self.tracks,
		gta6Level = true,
		features = {"Camera cuts", "Character acting", "Facial", "Lip sync", "Lighting cinematic", "VFX", "Dialogue", "Subtitles", "4K 60 FPS"},
	}

	print("[Arkher Cutscene] Initialized - GTA 6 level - 30s 4K 60 FPS -", #self.tracks, "tracks - Level:", self.level)
end

function CutsceneEditor:CreateDefaultTracks(parent: ScrollingFrame)
	local trackTypes = {"Camera", "Character", "Light", "Effect", "Audio"}

	if self.level == "Beginner" then
		trackTypes = {"Camera", "Character"}
	end

	for i, trackType in trackTypes do
		local template = CutsceneEditor.TrackTemplates[trackType]
		if not template then continue end

		local trackFrame = Instance.new("Frame")
		trackFrame.Name = "Track_" .. trackType
		trackFrame.Size = UDim2.new(1, -10, 0, 60)
		trackFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
		trackFrame.LayoutOrder = i
		trackFrame.Parent = parent

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = trackFrame

		local colorBar = Instance.new("Frame")
		colorBar.Size = UDim2.new(0, 4, 1, 0)
		colorBar.BackgroundColor3 = template.color
		colorBar.BorderSizePixel = 0
		colorBar.Parent = trackFrame

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -10, 0, 18)
		nameLabel.Position = UDim2.new(0, 10, 0, 2)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = template.icon .. " " .. template.name .. " Track"
		nameLabel.TextColor3 = Color3.new(1,1,1)
		nameLabel.TextSize = 10
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = trackFrame

		local propsLabel = Instance.new("TextLabel")
		propsLabel.Size = UDim2.new(1, -10, 0, 14)
		propsLabel.Position = UDim2.new(0, 10, 0, 20)
		propsLabel.BackgroundTransparency = 1
		propsLabel.Text = "Props: " .. table.concat(template.properties, ", ")
		propsLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
		propsLabel.TextSize = 8
		propsLabel.Font = Enum.Font.Gotham
		propsLabel.TextXAlignment = Enum.TextXAlignment.Left
		propsLabel.Parent = trackFrame

		local gta6Label = Instance.new("TextLabel")
		gta6Label.Size = UDim2.new(1, -10, 0, 24)
		gta6Label.Position = UDim2.new(0, 10, 0, 34)
		gta6Label.BackgroundTransparency = 1
		gta6Label.Text = "GTA 6: " .. template.gta6Features[1]
		gta6Label.TextColor3 = Color3.fromRGB(255, 200, 100)
		gta6Label.TextSize = 8
		gta6Label.Font = Enum.Font.Gotham
		gta6Label.TextXAlignment = Enum.TextXAlignment.Left
		gta6Label.TextWrapped = true
		gta6Label.Parent = trackFrame

		local trackData = {
			type = trackType,
			name = template.name,
			icon = template.icon,
			color = template.color,
			properties = template.properties,
			gta6Features = template.gta6Features,
			keyframes = {},
		}

		table.insert(self.tracks, trackData)
	end

	print("[Arkher Cutscene] Created", #self.tracks, "tracks - GTA 6 level")
end

function CutsceneEditor:Play()
	self.isPlaying = true
	print("[Arkher Cutscene] Play Playing cutscene", self.cutscene.name, "-", self.duration, "s - GTA 6 4K 60 FPS")

	task.spawn(function()
		while self.isPlaying and self.currentTime &lt; self.duration do
			task.wait(1/self.fps)
			self.currentTime += 1/self.fps

			if self.viewport then
				local label = self.viewport:FindFirstChild("TextLabel")
				if label then
					label.Text = string.format("  Preview - GTA 6 Cinematic - 4K 60 FPS - Time: %.2fs / %ds - Playing", self.currentTime, self.duration)
				end
			end

			if self.currentTime &gt;= self.duration then
				self.isPlaying = false
				self.currentTime = 0
				print("[Arkher Cutscene] Finished - GTA 6")
				break
			end
		end
	end)
end

function CutsceneEditor:Export()
	print("[Arkher Cutscene] Exporting cutscene - GTA 6 level - 4K 60 FPS -", self.cutscene.name)
	print("[Arkher Cutscene] Tracks:", #self.tracks, "- Duration:", self.duration, "s - Resolution: 4K - FPS: 60 - ARKHER AI v1")
	return "rbxassetid://cutscene_" .. tostring(math.random(100000, 999999)) .. "_gta6_4k"
end

function CutsceneEditor:GetStats()
	return {
		hasCutscene = self.cutscene ~= nil,
		tracksCount = #self.tracks,
		duration = self.duration,
		fps = self.fps,
		currentTime = self.currentTime,
		isPlaying = self.isPlaying,
		level = self.level,
		features = {"GTA 6 Cinematic", "Unreal Sequencer", "Camera cuts", "Character acting", "Facial + Lip sync", "Lighting cinematic", "VFX", "Dialogue + Subtitles", "4K 60 FPS", "ARKHER AI v1"},
		message = "CutsceneEditor - GTA 6 level - Rockstar - Cinematic 4K 60 FPS - Camera, Character, Light, Effect, Audio, Dialogue - Melhor que GTA 6",
	}
end

return CutsceneEditor
</ProtectedString>
    </Properties>
