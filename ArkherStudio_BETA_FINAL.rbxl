  <Item class="ModuleScript" referent="RBXccea583a30f11fae">
    <Properties>
      <string name="Name">StyleProfiles</string>
      <ProtectedString name="Source">--!strict
-- Arkher Studio - Style Profiles
-- Cada estilo muda render, materiais, otimização e DLSS

local StyleProfiles = {
	lowpoly = {
		displayName = "Low Poly",
