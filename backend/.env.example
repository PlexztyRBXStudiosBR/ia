# Arkher Studio Backend - Env Example
PORT=3000
HOST=0.0.0.0

# Open Cloud - User provides his own API Key via request, not env
# But you can set default for testing
# ROBLOX_API_KEY=your_api_key_here

# Vault CDN - S3 / Supabase
# S3_BUCKET=arkher-vault
# S3_REGION=us-east-1
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=xxx

# AI APIs - For Fase 5 AI Farm
# OPENAI_API_KEY=sk-xxx
# MESHY_API_KEY=msy_xxx
# TRIPOSR_API_URL=https://api.triposr.com

# For production Fly.io
# FLY_API_TOKEN=xxx
